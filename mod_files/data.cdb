							"conditions": {
								"target": 1
							},
							"score": 100
						}
					]
				},
				{
					"id": "PlayerHarvesterEaten",
					"options": [],
					"conditionsComment": "Le joueur non Fremen se fait manger un harvester dans une zone scoutée\n",
					"scoreComment": "200 / nombre d'IA à toutes les factions dont la zone est scoutée\r",
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "The loss of a manned harvester is revolting. I feel for you, but I shall also remind you that we are responsible for our workers' lives."
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": "What a sight! An entire harvester, gobbled by the worm... and the whole crew too, how grand! You really are an entertainer."
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": "The loss of your harvester will be a major setback, but be reassured! I'll work twice as hard to provide your usual clients with spice while your production is hindered."
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": "I know, this land is unforgiving. But it is not unfair. You will understand this eventually, be it at the cost of such woes."
								}
							]
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "This is my Spice. And you lost it. Such negligence is extremely disappointing."
								}
							]
						}
					],
					"implemented": true,
					"eventConditions": [
						{
							"ref": "UnitEaten",
