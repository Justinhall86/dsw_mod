					"trigger": {}
				},
				{
					"id": "CB_Kill_Atreides_1",
					"title": "The Siege of Arrakeen",
					"mainText": "",
					"popupPages": [
						{
							"id": "CBKA",
							"text": "[Arrakeen] holds a strong, active shield, we must deactivate it from the inside. It so happens that I had a short talk with Dr. Yueh...",
							"overrides": [
								{
									"text": "[!Leto] is hiding behind the shield of [Arrakeen]. Any attack would be pointless until we find a way to deactivate it from the inside.",
									"character": "Fenring",
									"notes_overrides": ""
								},
								{
									"text": "The weak [Atreides-shortname] are cowering in their burrow. Let's take out their defenses and hit them with all we got.",
									"character": "Piter",
									"notes_overrides": ""
								},
								{
									"text": "Sadly, we must end [Atreides-longname]'s illegitimate occupation of Arrakis. We must first disable their shield, then [Arrakeen] will fall easily.",
									"character": "Ilesa",
									"notes_overrides": ""
								}
							],
							"highlight": {},
							"notes": ""
						}
					],
					"speakers": [
						{
							"faction": "Corrino",
							"character": "Fenring"
						},
						{
							"faction": "Harkonnen",
							"character": "Piter"
						},
						{
							"faction": "Ecaz",
							"character": "Ilesa"
						}
					],
					"flags": 0,
					"props": {
						"position": 2
					},
					"trigger": {}
				},
				{
					"id": "CB_Kill_Atreides_3",
					"title": "The Siege of Arrakeen",
					"mainText": "",
					"popupPages": [
						{
							"id": "CBKA",
							"text": "",
							"overrides": [
								{
									"text": "The shield is down. If we act fast, we will benefit from the element of surprise.",
									"character": "Fenring",
									"notes_overrides": ""
								},
								{
									"text": "Attack! Put an end to the [Atreides-adjective] line!",
									"character": "Piter",
									"notes_overrides": ""
								},
								{
									"text": "It's a shame to see [Atreides-shortname] fall so low, but they're lucky we're the one to end their misery.",
									"character": "Ilesa",
									"notes_overrides": ""
								}
							],
							"highlight": {},
							"notes": ""
						}
					],
					"speakers": [
						{
							"faction": "Corrino",
							"character": "Fenring"
						},
						{
							"faction": "Harkonnen",
							"character": "Piter"
						}
					],
					"flags": 0,
					"props": {
						"position": 2
					},
					"trigger": {}
				},
				{
					"id": "CB_Kill_Harkonnen_1",
					"title": "The Fortress",
					"mainText": "",
					"popupPages": [
						{
							"id": "CBKH",
							"text": "",
							"overrides": [
								{
									"text": "The [Harkonnen-shortname]s are holed up in their den. [Carthag] is a formidable fortress, but we've seen worse.",
									"character": "Aramsham",
									"notes_overrides": ""
								},
								{
									"text": "The ugly fortress in its crack is hard to break. We must take our time and be careful.",
									"character": "Gurney",
									"notes_overrides": ""
								},
								{
									"text": "The [Harkonnen-adjective] fortress present a serious challenge, but we'll rise to the occasion.",
									"character": "Whitmore",
									"notes_overrides": ""
								}
							],
							"highlight": {},
							"notes": ""
						}
					],
					"speakers": [
						{
							"faction": "Corrino",
							"character": "Aramsham"
						},
						{
							"faction": "Atreides",
							"character": "Gurney"
						},
						{
							"faction": "Ecaz",
							"character": "Whitmore"
						}
					],
					"flags": 0,
					"props": {
						"position": 2
					},
					"trigger": {}
				},
				{
					"id": "CB_Kill_Harkonnen_2",
					"title": "The Fortress",
					"mainText": "",
					"popupPages": [
						{
							"id": "CBKH",
							"text": "",
							"overrides": [
								{
									"text": "The fortress is vulnerable. It's time to give the assault.",
									"character": "Aramsham",
									"notes_overrides": ""
								},
								{
									"text": "The evil Baron in his castle is ready to fall. All the hate that he spread to his people will finally eat him alive.\n\nWith such a large meal, everyone will have a share.",
									"character": "Gurney",
									"notes_overrides": ""
								}
							],
							"highlight": {},
							"notes": ""
						}
					],
					"speakers": [
						{
							"faction": "Corrino",
							"character": "Aramsham"
						},
						{
							"faction": "Atreides",
							"character": "Gurney"
						}
					],
					"flags": 0,
					"props": {
						"position": 2
					},
					"trigger": {}
				},
				{
					"id": "CB_Kill_Corrino_1",
					"title": "Downfall",
					"mainText": "",
					"popupPages": [
						{
							"id": "CBKC",
							"text": "",
							"overrides": [
								{
									"text": "The so-called emperor of the whole universe is stuck in the sand. We just have to destroy his last few ships and we'll have free reign on Arrakis.",
									"character": "Iakin",
									"notes_overrides": ""
								},
								{
									"text": "The fallen emperor is weakened. We'll show him and the whole galaxy what strength looks like. For Atreides!",
									"character": "Gurney",
									"notes_overrides": ""
								},
								{
									"text": "Sardaukars won't be enough to save the emperor this time! This battle will be in every history books. We only have to take care of a few frail ships.",
									"character": "Whitmore",
									"notes_overrides": ""
								}
							],
							"highlight": {},
							"notes": ""
						}
					],
					"speakers": [
						{
							"faction": "Harkonnen",
							"character": "Iakin"
						},
						{
							"faction": "Atreides",
							"character": "Gurney"
						},
						{
							"faction": "Ecaz",
							"character": "Whitmore"
						}
					],
					"flags": 0,
					"props": {
						"position": 2
					},
					"trigger": {}
				},
				{
					"id": "CB_Kill_Corrino_2",
					"title": "Downfall",
					"mainText": "",
					"popupPages": [
						{
							"id": "CBKH",
							"text": "",
							"overrides": [
								{
									"text": "Ah! That was easy! ... Is the old fool going to try defending himself?",
									"character": "Iakin",
									"notes_overrides": ""
								},
								{
									"text": "One bird down. Two still singing. The emperor is probably not gonna let us win so easily. ... I have a bad feeling.",
									"character": "Gurney",
									"notes_overrides": ""
								},
								{
									"text": "That was glorious. But beware of the old emperor, he still have a few tricks up his sleeves. Something is coming.",
									"character": "Whitmore",
									"notes_overrides": ""
								}
							],
							"highlight": {},
							"notes": ""
						}
					],
					"speakers": [
						{
							"faction": "Harkonnen",
							"character": "Iakin"
						},
						{
							"faction": "Atreides",
							"character": "Gurney"
						},
						{
							"faction": "Ecaz",
							"character": "Whitmore"
						}
					],
					"flags": 0,
					"props": {
						"position": 2
					},
					"trigger": {}
				},
				{
					"id": "CB_Kill_Corrino_3",
					"title": "Downfall",
					"mainText": "",
					"popupPages": [
						{
							"id": "CBKH",
							"text": "",
							"overrides": [
								{
									"text": "Only one ship left. The emperor is cornered. All his pitiful might won't be enouh this time.",
									"character": "Iakin",
									"notes_overrides": ""
								},
								{
									"text": "It's too soon for celebration. The dying lion still has claws.",
									"character": "Gurney",
									"notes_overrides": ""
								},
								{
									"text": "Beautiful! We should expect a last-ditch effort to win from the poor emperor, but greatness is around the corner.",
									"character": "Whitmore",
									"notes_overrides": ""
								}
							],
							"highlight": {},
							"notes": ""
						}
					],
					"speakers": [
						{
							"faction": "Harkonnen",
							"character": "Iakin"
						},
						{
							"faction": "Atreides",
							"character": "Gurney"
						},
						{
							"faction": "Ecaz",
							"character": "Whitmore"
						}
					],
					"flags": 0,
					"props": {
						"position": 2
					},
					"trigger": {}
				},
				{
					"id": "CB_Kill_Ecaz_1",
					"title": "The Red Exhibition",
					"mainText": "",
					"popupPages": [
						{
							"id": "CBKH",
							"text": "",
							"overrides": [
								{
									"text": "The [Ecaz-adjective] artists have overstayed their welcome. I like their style but they shouldn't oppose [Atreides-longname]. Let's take their glorified crib and end this non-sense.",
									"character": "Gurney",
									"notes_overrides": ""
								},
								{
									"text": "That is [Foliage]? It's supposed to be beautiful. I ain't getting it, it's ugly! I see why we should burn it down, now.",
									"character": "Glossu",
									"notes_overrides": ""
								},
								{
									"text": "I don't care about art. Life is not that complicated: they oppose the Emperor, they die.",
									"character": "Aramsham",
									"notes_overrides": ""
								}
							],
							"highlight": {},
							"notes": ""
						}
					],
					"speakers": [
						{
							"faction": "Atreides",
							"character": "Gurney"
						},
						{
							"faction": "Harkonnen",
							"character": "Glossu"
						},
						{
							"faction": "Corrino",
							"character": "Aramsham"
						}
					],
					"flags": 0,
					"props": {
						"position": 2
					},
					"trigger": {}
				},
				{
					"id": "SpiceHarvesting_Fremen",
					"title": "Spice Harvesting",
					"mainText": "",
					"popupPages": [
						{
							"text": "To produce [Spice], you need to build a [F_Harvester_Mobile] and deploy it on a [SpiceArea] in a neutral or owned region.",
							"id": "SH1",
							"highlight": {},
							"overrides": [],
							"notes": ""
						}
					],
					"trigger": {
						"comment": "Fog of war reveals a spice area & recon"
					},
					"props": {
						"position": 2,
						"onlyForFactions": [
							{
								"faction": "Fremen"
							}
						]
					},
					"implHighlight": true,
					"flags": 24,
					"hlcomment": "1- Closest Spice icon\n1- POI Village in the same region\n2- Bouton de recrutement des harvesting team",
					"speakers": [
						{
							"character": "ShadoutMapes"
						}
					]
				},
				{
					"id": "Victory",
					"title": "Victory",
					"mainText": "",
					"popupPages": [
						{
							"id": "VI1",
							"text": "There are 4 different ways to win the game:\n\n1. Hegemony Victory: Reach ::value(Game_Victory_HegemonyScore):: [Hegemony].\n\n2. Domination Victory: Eliminate every other player by destroying their bases or assassinating their leaders.",
							"highlight": {},
							"overrides": [],
							"notes": ""
						},
						{
							"text": "3. Political Victory: Get elected to [DuneGovernor] in the Landsraad and keep the charter for 2 councils.\n\n4. Economic Victory: Own more than 50% of the CHOAM by buying more [CHOAMShare]s than your opponents.",
							"id": "VI2",
							"highlight": {},
							"overrides": [],
							"notes": ""
						}
					],
					"trigger": {
						"value": 4000,
						"comment": "trigger.value Hegemony points reached"
					},
					"props": {
						"position": 2
					},
					"implHighlight": true,
					"flags": 24,
					"hlcomment": "1 - Hegemony in UI\n2 - Landsraad and CHOAM Market in UI",
					"speakers": [
						{
							"character": "ShadoutMapes"
						}
					]
				},
				{
					"id": "Raiders",
					"title": "Raiders",
					"mainText": "",
					"popupPages": [
						{
							"text": "Raiders can come out of hidden Sietches to free Villages from your control.",
							"id": "RA1",
							"highlight": {},
							"overrides": [],
							"notes": ""
						},
						{
							"text": "Each raid suffered gives a chance to reveal the hidden [Sietch] it came from.",
							"id": "RA2",
							"highlight": {},
							"overrides": [],
							"notes": ""
						}
					],
					"trigger": {
						"windowOnly": true,
						"comment": "Clic on Raider unit"
					},
					"props": {
						"position": 2
					},
					"flags": 24,
					"speakers": [
						{
							"character": "ShadoutMapes"
						}
					]
				},
				{
					"id": "MainBase",
					"title": "Improving your Base",
					"mainText": "",
					"popupPages": [
						{
							"text": "[!Building_MB] slots in your Main Base are split into Districts of different sizes.",
							"id": "MB1",
							"highlight": {},
							"overrides": [],
							"notes": ""
						},
						{
							"text": "If you fill all the slots of a district with only one type of [!Building_MB], it will grant you a bonus depending on the District's size.",
							"id": "MB2",
							"highlight": {},
							"overrides": [],
							"notes": ""
						}
					],
					"trigger": {
						"windowOnly": true,
						"comment": "Click on main base with a constructible building"
					},
					"props": {
						"position": 2
					},
					"implHighlight": true,
					"flags": 24,
					"hlcomment": "1- Districts\n2- District bonuses",
					"speakers": [
						{
							"character": "ShadoutMapes"
						}
					]
				},
				{
					"id": "SpyingEnemies",
					"title": "Spying Enemies",
					"mainText": "",
					"popupPages": [
						{
							"text": "You can assign [Agent]s to various postings to get different bonuses.\nEach agent also has a special trait.",
							"id": "SE1",
							"highlight": {},
							"overrides": [],
							"notes": ""
						},
						{
							"text": "Assigned [Agent]s generate [Intel] and other resources depending on their posting.\n[Intel] allows you to launch spying missions.",
							"id": "SE2",
							"highlight": {},
							"overrides": [],
							"notes": ""
						},
						{
							"text": "Assigned [Agent]s also improve the relevant [!Infiltration] level, unlocking more advanced missions.",
							"id": "SE3",
							"highlight": {},
							"overrides": [],
							"notes": ""
						}
					],
					"trigger": {
						"windowOnly": true,
						"comment": "Click on Spying button"
					},
					"props": {
						"position": 2
					},
					"implHighlight": true,
					"flags": 24,
					"hlcomment": "1- Spying slots\n1- Non assigned agents\n2- Intel\n2- 1st Mission\n3- Infiltration progress bars",
					"speakers": [
						{
							"character": "ShadoutMapes"
						}
					]
				},
				{
					"id": "Sandstorms",
					"title": "Sandstorms",
					"mainText": "",
					"popupPages": [
						{
							"text": "[Sandstorm] reduce production in nearby Villages.\nThey may destroy military units, [Ornithopter]s and [Harvester]s alike.",
							"id": "SS1",
							"highlight": {},
							"overrides": [],
							"notes": ""
						},
						{
							"text": "Controlled villages can shelter military units.\nStill, the best way to survive a [Sandstorm] is to flee.",
							"id": "SS2",
							"highlight": {},
							"overrides": [],
							"notes": ""
						}
					],
					"trigger": {
						"onAlert": "StormNearby",
						"windowOnly": true,
						"comment": "Click on [Sandstorm] alert"
					},
					"props": {
						"position": 2
					},
					"implHighlight": true,
					"flags": 24,
					"speakers": [
						{
							"character": "ShadoutMapes"
						}
					]
				},
				{
					"id": "Sietches",
					"title": "Sietches",
					"mainText": "",
					"popupPages": [
						{
							"text": "You can trade with a [Sietch] to improve your Relations towards it.",
							"id": "SI1",
							"highlight": {},
							"overrides": [],
							"notes": ""
						},
						{
							"text": "If you reach max Relation with a [Sietch] in your territory, you can forge an alliance (using an [Agent]) to unlock its passive ability.",
							"id": "SI2",
							"highlight": {},
							"overrides": [],
							"notes": ""
						}
					],
					"trigger": {
						"windowOnly": true,
						"comment": "Click on [Sietch] discorery alert or Sietch"
					},
					"props": {
						"position": 2,
						"notForFactions": [
							{
								"faction": "Fremen"
							}
						]
					},
					"implHighlight": true,
					"flags": 24,
					"hlcomment": "1- Trade button\n2- Agent slot",
					"speakers": [
						{
							"character": "ShadoutMapes"
						}
					]
				},
				{
					"id": "Sietches_Fremen",
					"title": "Sietches",
					"mainText": "",
					"popupPages": [
						{
							"text": "You can trade with a [Sietch] to improve your Relations towards it.",
							"id": "SI1",
							"highlight": {},
							"overrides": [],
							"notes": ""
						},
						{
							"text": "If you reach max Relation with a [Sietch], you can forge an alliance to unlock its passive ability. Allied [Sietch]s have an authority [!Upkeep].",
							"id": "SIF2",
							"highlight": {},
							"overrides": [],
							"notes": ""
						}
					],
					"trigger": {
						"windowOnly": true,
						"comment": "Click on [Sietch] discorery alert or Sietch"
					},
					"props": {
						"position": 2,
						"onlyForFactions": [
							{
								"faction": "Fremen"
							}
						]
					},
					"implHighlight": true,
					"flags": 24,
					"hlcomment": "1- Trade button\n2- Alliance button",
					"speakers": [
						{
							"character": "ShadoutMapes"
						}
					]
				},
				{
					"id": "Diplomacy",
					"title": "Diplomacy and trade",
					"mainText": "",
					"popupPages": [
						{
							"id": "DI1",
							"text": "The trade screen allows you to trade resources and manage your diplomatic status.\nPut resources on both sides of the exchange to propose a trade.",
							"highlight": {},
							"overrides": [],
							"notes": ""
						},
						{
							"id": "DI2",
							"text": "There are two diplomatic statuses between factions: [War] and [Peace].\nIn [War], you can attack the other faction freely, while [Peace] allows you to use powerful treaties in a trade.",
							"highlight": {},
							"overrides": [],
							"notes": ""
						},
						{
							"id": "DI3",
							"text": "To go from [War] to [Peace], use the [ImproveRelations] in a trade.\nIt costs less [Influence] to propose the longer you have been in [War].",
							"highlight": {},
							"overrides": [],
							"notes": ""
						},
						{
							"id": "DI4",
							"text": "While you are in [Peace], you can attack the other faction, but doing so will brand you a traitor.\nInstead, you can pay [Influence] to declare officially that the [Peace] is ending without incurring any penalty.",
							"highlight": {},
							"overrides": [],
							"notes": ""
						}
					],
					"trigger": {
						"windowOnly": true,
						"comment": "Open trading"
					},
					"props": {
						"position": 2
					},
					"implHighlight": true,
					"flags": 24,
					"hlcomment": "1 - resources left side and right side + Trade button\n2 - Icon Diplomatic Status\n3 - NAP treaty\n4 - End truce Button",
					"speakers": [
						{
							"character": "ShadoutMapes"
						}
					]
				},
				{
					"id": "CMarket",
					"title": "CHOAM Market",
					"mainText": "",
					"popupPages": [
						{
							"id": "CM1",
							"text": "The CHOAM Market allows you to buy and sell shares of the Combine Honnete Ober Advancer Mercantiles, that own all legal trade in the Imperium.",
							"highlight": {},
							"overrides": [],
							"notes": ""
						},
						{
							"id": "CM2",
							"text": "Share value rises and falls depending on availability and total Spice sold to the CHOAM.\nEvery now and then, new shares will be produced by the CHOAM, increasing the total number of shares.",
							"highlight": {},
							"overrides": [],
							"notes": ""
						},
						{
							"id": "CM3",
							"text": "If a player ever has more than half the shares, they become majority holders and immediately win the game.",
							"highlight": {},
							"overrides": [],
							"notes": ""
						}
					],
					"trigger": {
						"windowOnly": true,
						"comment": "Opening the CHOAM market for the first time"
					},
					"props": {
						"position": 2
					},
					"implHighlight": true,
					"flags": 24,
					"hlcomment": "1 - Buy and Sell button\n2 - Price and graphe\n3 - Player shares and Camembert",
					"speakers": [
						{
							"character": "ShadoutMapes"
						}
					]
				},
				{
					"id": "StandingRelation",
					"title": "Standing and Relations",
					"mainText": "",
					"popupPages": [
						{
							"text": "TODO",
							"id": "SR1",
							"highlight": {},
							"overrides": [],
							"notes": ""
						},
						{
							"text": "TODO",
							"id": "SR2",
							"highlight": {},
							"overrides": [],
							"notes": ""
						}
					],
					"trigger": {
						"comment": "TODO TODO\nmain text used to be\n\"Diplomacy is hard to master.\nWork for other Faction frienshipness and take care of your Standing at the Landsraad or beware desastrous consequences.\"",
						"implemented": false
					},
					"props": {
						"position": 2,
						"disabled": true
					},
					"implHighlight": false,
					"flags": 24,
					"speakers": [
						{
							"character": "ShadoutMapes"
						}
					]
				},
				{
					"id": "LandsraadCouncil",
					"title": "Landsraad Council",
					"mainText": "",
					"popupPages": [
						{
							"text": "Three resolutions are put up to vote at every Council.",
							"id": "LC1",
							"highlight": {},
							"overrides": [],
							"notes": ""
						},
						{
							"text": "Each Faction can use [CouncilVote]s or [Influence] to pass or counter Resolutions.",
							"id": "LC2",
							"highlight": {},
							"overrides": [],
							"notes": ""
						},
						{
							"text": "Some special Resolutions, called [Charter]s, may be unlocked during the game.\nEach [Charter] has its own eligibility conditions that you'll have to fulfill if you want to get elected to one of them.",
							"id": "LC3",
							"highlight": {},
							"overrides": [],
							"notes": ""
						}
					],
					"trigger": {
						"windowOnly": true,
						"comment": "First Resolution vote landsraad window"
					},
					"props": {
						"position": 2,
						"disabled": true
					},
					"implHighlight": true,
					"flags": 24,
					"hlcomment": "1- Resolutions\n2- Votes\n3- Charters",
					"speakers": [
						{
							"character": "ShadoutMapes"
						}
					]
				},
				{
					"id": "MilitaryUnits",
					"title": "Military units",
					"mainText": "",
					"popupPages": [
						{
							"text": "Military units have several statistics.\n[Power], [Life], [Armor] and a special Ability.",
							"id": "MU1",
							"highlight": {},
							"overrides": [],
							"notes": ""
						},
						{
							"text": "Units lose [Supply] as they move outside of your territory.\nA Unit with no [Supply] will die from exposure.",
							"id": "MU2",
							"highlight": {},
							"overrides": [],
							"notes": ""
						},
						{
							"id": "MU3",
							"text": "The maximum [Supply] of your units is based on available [Water].\n\nMore [Water] means more [Supply], which means your units can go farther away.",
							"overrides": [],
							"highlight": {},
							"notes": ""
						},
						{
							"text": "[Supply] is refilled while staying close to a controlled [Village] or Main Base.",
							"id": "MU4",
							"highlight": {},
							"overrides": [],
							"notes": ""
						}
					],
					"trigger": {
						"windowOnly": true,
						"comment": "Click on a friendly military unit"
					},
					"props": {
						"position": 2,
						"disabled": true
					},
					"implHighlight": true,
					"flags": 24,
					"hlcomment": "1- Unit Power, Life & Armor\n2- Unit Supply\n3- Unit Supply",
					"speakers": [
						{
							"character": "ShadoutMapes"
						}
					]
				},
				{
					"id": "HostileSpying",
					"title": "Hostile Spying",
					"mainText": "",
					"popupPages": [
						{
							"text": "You have enough Intel on a faction to launch a mission against it.\nMissions are hostile manoeuvers toward the targeted Faction.",
							"id": "HS1",
							"highlight": {},
							"overrides": [],
							"notes": ""
						},
						{
							"text": "By sending an Agent, you could steal some of its goods or drastically reduce its surviving odds on Arrakis.\nIf mission achieves success without being discovered, your Faction won't get Standing penalties!",
							"id": "HS2",
							"highlight": {},
							"overrides": [],
							"notes": ""
						},
						{
							"text": "During a mission, your [Agent] can face Complications that affects the success rate. You will have the opportunity to cancel the Mission.\nthey can also be discovered by the targeted Faction. When discovered, the target can try to capture or wiretap them.",
							"id": "HS3",
							"highlight": {},
							"overrides": [],
							"notes": ""
						}
					],
					"trigger": {
						"windowOnly": true,
						"comment": "TODO Enough Intel to launch an Operation",
						"implemented": false
					},
					"props": {
						"position": 2,
						"disabled": true
					},
					"implHighlight": false,
					"flags": 24,
					"hlcomment": "Spying mission",
					"speakers": [
						{
							"character": "ShadoutMapes"
						}
					]
				},
				{
					"id": "Outpost",
					"title": "Village Buildings",
					"mainText": "",
					"popupPages": [
						{
							"text": "Villages are an important part of our growth. You have to choose what to build and where.",
							"id": "OP1",
							"highlight": {},
							"overrides": [],
							"notes": ""
						},
						{
							"text": "They contain several [!Building_Village] slots. Click on one to bring up a list of [!Building_Village]s.\nAdditional slots can be added by paying [Plascrete].",
							"id": "OP2",
							"highlight": {},
							"overrides": [],
							"notes": ""
						},
						{
							"text": "Each [!Building_Village] has a cost and [!Upkeep], generally in [Solari] and [Plascrete].\nOverextension can quickly lead you to run out of essential resources.",
							"id": "OP3",
							"highlight": {},
							"overrides": [],
							"notes": ""
						},
						{
							"text": "You should hire Militia to defend your Villages from Raiders or nearby enemies.",
							"id": "OP4",
							"highlight": {},
							"overrides": [],
							"notes": ""
						}
					],
					"trigger": {
						"windowOnly": true,
						"comment": "Controled Village is selected",
						"implemented": false
					},
					"props": {
						"position": 2,
						"disabled": true
					},
					"implHighlight": true,
					"flags": 24,
					"hlcomment": "Village Window",
					"speakers": [
						{
							"character": "ShadoutMapes"
						}
					]
				},
				{
					"id": "Exploration",
					"title": "Exploration",
					"mainText": "",
					"popupPages": [
						{
							"text": "Exploring Arrakis is vital to find the precious [Spice] as well as other resources.\nEach region contains points of interest [?] that your [Ornithopter]s can recon.",
							"id": "EX1",
							"highlight": {},
							"overrides": [],
							"notes": ""
						}
					],
					"trigger": {
						"windowOnly": true,
						"comment": "Select thopter"
					},
					"props": {
						"position": 2,
						"disabled": true
					},
					"implHighlight": true,
					"flags": 24,
					"hlcomment": "All Ornis in UI\nAll Ornis in 3D\nHighlight sur les POI non recon, dans les région explorée de la première couronne autour de MB",
					"speakers": [
						{
							"character": "ShadoutMapes"
						}
					]
				},
				{
					"id": "SpiceHarvesting",
					"title": "Spice Harvesting",
					"mainText": "",
					"popupPages": [
						{
							"text": "To produce [Spice] you must capture a Village in a region with a [SpiceArea].",
							"id": "SH1",
							"highlight": {},
							"overrides": [],
							"notes": ""
						},
						{
							"text": "Then you'll need to build a [$my(refinery)] and deploy its [$my(harvester)] to start harvesting.",
							"id": "SH2",
							"highlight": {},
							"overrides": [],
							"notes": ""
						}
					],
					"trigger": {
						"comment": "Fog of war reveals a spice area & recon"
					},
					"props": {
						"position": 2,
						"disabled": true
					},
					"implHighlight": true,
					"flags": 24,
					"hlcomment": "1- Closest Spice icon\n1- POI Village in the same region",
					"speakers": [
						{
							"character": "ShadoutMapes"
						}
					]
				},
				{
					"id": "NeutralVillages",
					"title": "Villages and Regions",
					"mainText": "",
					"popupPages": [
						{
							"text": "Villages are defended by Militias.\nIf you defeat them, your units will occupy the Village, unlocking the possibility of taking control using [Authority], or pillaging for Resources.",
							"id": "NV1",
							"highlight": {},
							"overrides": [],
							"notes": ""
						}
					],
					"trigger": {
						"comment": "First neutral village is recon"
					},
					"props": {
						"position": 2,
						"disabled": true
					},
					"implHighlight": true,
					"flags": 24,
					"hlcomment": "Closest Neutral Village\nMilitias in the Neutral Villages\nCapture Cost",
					"speakers": [
						{
							"character": "ShadoutMapes"
						}
					]
				},
				{
					"id": "RecruitmentUnit",
					"title": "Military units recruitment",
					"mainText": "",
					"popupPages": [
						{
							"text": "Each military unit has a training and an [!Upkeep] cost.\nThey also take up a certain amount of Command Points, which limits the size of your army.",
							"id": "RU1",
							"highlight": {},
							"overrides": [],
							"notes": ""
						}
					],
					"trigger": {
						"windowOnly": true,
						"comment": "Opening recruitment window"
					},
					"props": {
						"position": 2,
						"disabled": true
					},
					"implHighlight": true,
					"flags": 24,
					"hlcomment": "Command Points",
					"speakers": [
						{
							"character": "ShadoutMapes"
						}
					]
				},
				{
					"id": "Water",
					"title": "Water",
					"mainText": "",
					"popupPages": [
						{
							"text": "The more Villages and military units you control, the more water you will need.\nIf your [Water] is negative, you will see unrest in your Villages, leading to rebellions.",
							"id": "WA1",
							"highlight": {},
							"overrides": [],
							"notes": ""
						},
						{
							"text": "Wind Traps gather [Water] in a Region depending on its wind strength.",
							"id": "WA2",
							"highlight": {},
							"overrides": [],
							"notes": ""
						}
					],
					"trigger": {
						"value": 2,
						"comment": "trigger.value Villages owned"
					},
					"props": {
						"position": 2,
						"disabled": true
					},
					"implHighlight": true,
					"flags": 24,
					"hlcomment": "1- Water resource\n2- Water resource\n2- Closest owned Village\n2- Construction slot in the Village\n2- Wind traps in villages\n2- Water production in village",
					"speakers": [
						{
							"character": "ShadoutMapes"
						}
					]
				},
				{
					"id": "HarvesterFactory",
					"title": "Harvester Factory",
					"mainText": "",
					"popupPages": [
						{
							"text": "Harvesters will attract [Sandworm].\nAt the first wormsign, you will have to recall your Harvester if you don't want it to be destroyed along with its crew.",
							"id": "HF1",
							"highlight": {},
							"overrides": [],
							"notes": ""
						},
						{
							"text": "You can increase [Spice] production by adding more [CrewPoint] to your [$my(Harvester)]s.",
							"id": "HF2",
							"highlight": {},
							"overrides": [],
							"notes": ""
						}
					],
					"trigger": {
						"comment": "First harvester deployed"
					},
					"props": {
						"position": 2,
						"disabled": true
					},
					"implHighlight": true,
					"flags": 24,
					"hlcomment": "1- Closest Harvester\n1- Recall Button\n2- Closest Harvester\n2- Crew button",
					"speakers": [
						{
							"character": "ShadoutMapes"
						}
					]
				},
				{
					"id": "HarvesterFactory_Fremen",
					"title": "Harvesting Team",
					"mainText": "",
					"popupPages": [
						{
							"text": "You can increase [Spice] production by adding more [CrewPoint] to your [$my(Harvester)]s.",
							"id": "HF2",
							"highlight": {},
							"overrides": [],
							"notes": ""
						}
					],
					"trigger": {
						"comment": "First harvest tent deployed"
					},
					"props": {
						"position": 2,
						"disabled": true
					},
					"flags": 24,
					"hlcomment": "1- Closest Harvest tent \n1- Crew button",
					"speakers": [
						{
							"character": "ShadoutMapes"
						}
					]
				},
				{
					"id": "SpiceTrading",
					"title": "Spice and the Imperial Tax",
					"mainText": "",
					"popupPages": [
						{
							"text": "Every ::value(CCT_Spice_Report_Frequency):: days, you will have to pay the [$my(contract)].\nFailing to do so will cause various penalties.",
							"id": "ST1",
							"highlight": {},
							"overrides": [],
							"notes": ""
						},
						{
							"text": "Collected [Spice] can be stockpiled to pay taxes, or sold to the CHOAM for [Solari].\nYou can change the amount of Spice you sell, in favor of stocks.",
							"id": "ST2",
							"highlight": {},
							"overrides": [],
							"notes": ""
						},
						{
							"text": "The Spice to Solaris exchange rate changes frequently, think to check it.",
							"id": "ST3",
							"highlight": {},
							"overrides": [],
							"notes": ""
						}
					],
					"trigger": {
						"value": 5,
						"comment": "trigger.value days before first Imperial Tax"
					},
					"props": {
						"position": 2,
						"disabled": true
					},
					"implHighlight": true,
					"flags": 24,
					"hlcomment": "1- Imperial Tax UI\n2- Spice change bar\n3- Spice exchange rate",
					"speakers": [
						{
							"character": "ShadoutMapes"
						}
					]
				},
				{
					"id": "SpiceTrading_Corrino",
					"title": "Spice and the Guild Fee",
					"mainText": "",
					"popupPages": [
						{
							"text": "Every ::value(CCT_Spice_Report_Frequency):: days, you will have to pay the [$my(contract)].\nFailing to do so will cause various penalties.",
							"id": "ST1",
							"highlight": {},
							"overrides": [],
							"notes": ""
						},
						{
							"id": "ST2",
							"text": "You will also receive [Spice] paid in taxes by great houses present on Arrakis. \nDon't rely exclusively on it as they can potentially not pay up.",
							"highlight": {},
							"overrides": [],
							"notes": ""
						},
						{
							"text": "Harvested [Spice] can be stockpiled to pay the fee, or sold to the CHOAM for [Solari].\nYou can change the amount of Spice you sell, in favor of stocks.",
							"id": "STC3",
							"highlight": {},
							"overrides": [],
							"notes": ""
						},
						{
							"text": "The Spice to Solaris exchange rate changes frequently, think to check it.",
							"id": "ST3",
							"highlight": {},
							"overrides": [],
							"notes": ""
						}
					],
					"trigger": {
						"value": 5,
						"comment": "trigger.value days before first Imperial Tax"
					},
					"props": {
						"position": 2,
						"disabled": true
					},
					"implHighlight": true,
					"flags": 24,
					"hlcomment": "1- Imperial Tax UI\n3- Spice change bar\n4- Spice exchange rate",
					"speakers": [
						{
							"character": "ShadoutMapes"
						}
					]
				},
				{
					"id": "CB_Kill_Atreides_2",
					"title": "The Siege of Arrakeen",
					"mainText": "",
					"popupPages": [
						{
							"id": "CBKA",
							"text": "",
							"overrides": [
								{
									"text": "When we deactivate the shield, it will not stay down for long. We have to attack immediately.",
									"character": "Fenring",
									"notes_overrides": ""
								},
								{
									"text": "Timing is of the essence. Only put the shield down right before the attack.",
									"character": "Piter",
									"notes_overrides": ""
								}
							],
							"highlight": {},
							"notes": ""
						}
					],
					"speakers": [
						{
							"faction": "Corrino",
							"character": "Fenring"
						},
						{
							"faction": "Harkonnen",
							"character": "Piter"
						}
					],
					"flags": 0,
					"props": {
						"position": 2
					},
					"trigger": {},
					"hlcomment": "No longer used"
				},
				{
					"id": "CB_Kill_Atreides_4",
					"title": "The Siege of Arrakeen",
					"mainText": "",
					"popupPages": [
						{
							"id": "CBKA",
							"text": "",
							"overrides": [
								{
									"text": "The shield is back up. Retreat, regroup and start again.",
									"character": "Fenring",
									"notes_overrides": ""
								},
								{
									"text": "We didn't get them this time. Let's start again from the start!",
									"character": "Piter",
									"notes_overrides": ""
								}
							],
							"highlight": {},
							"notes": ""
						}
					],
					"speakers": [
