			]
		},
		{
			"name": "tutorial",
			"columns": [
				{
					"typeStr": "0",
					"name": "id",
					"kind": null,
					"scope": null
				},
				{
					"typeStr": "1",
					"name": "title",
					"kind": "localizable"
				},
				{
					"typeStr": "1",
					"name": "mainText",
					"kind": "localizable"
				},
				{
					"typeStr": "8",
					"name": "popupPages",
					"kind": null
				},
				{
					"typeStr": "8",
					"name": "speakers"
				},
				{
					"typeStr": "10:NoPause,BlockCamera,NoCloseButton,InGameTrigger,HidePortrait,HeroSpeaker,EnemyHeroSpeaker,StrictEnemyHeroSpeaker,NoWindowClose,NoBindLayer",
					"name": "flags",
					"documentation": "EnemyHeroSpeaker: Will look for the first enemy unit on the field that is a hero and use that\nStrictEnemyHeroSpeaker: Does not use neutral heroes\nNoWindowClose: Will not close other ui windows when triggered"
				},
				{
					"typeStr": "17",
					"name": "props",
					"kind": null
				},
				{
					"typeStr": "17",
					"name": "trigger",
					"kind": null
				},
				{
					"typeStr": "1",
					"name": "hlcomment",
					"opt": true
				},
				{
					"typeStr": "2",
					"name": "implHighlight",
					"opt": true
				}
			],
			"lines": [
				{
					"id": "M1_01_Start",
					"title": "Basic Controls",
					"mainText": "",
					"popupPages": [
						{
							"id": "M213",
							"text": "Hello, Noble Born. I am Shadout Mapes, the well-dipper, at your service.",
							"highlight": {},
							"overrides": [],
							"notes": ""
						},
						{
							"id": "M211",
							"text": "With all due respect, in your home you are a king, but in the desert you are like a child.\n\nBut fear not, I'll teach you everything you need to know.",
							"highlight": {},
							"overrides": [],
							"notes": ""
						},
						{
							"id": "M212",
							"text": "Today, we'll learn how to control the camera, give orders to units and manage the flow of time.\n\nLet's start promptly with the camera.",
							"highlight": {},
							"overrides": [],
							"notes": ""
						}
					],
					"trigger": {},
					"flags": 0,
					"props": {
						"position": 2
					},
					"hlcomment": "",
					"speakers": [
						{
							"character": "ShadoutMapes"
						}
					]
				},
				{
					"id": "M1_01_MoveCamera_NoGamepad",
					"title": "Move the Camera",
					"mainText": "",
					"popupPages": [
						{
							"id": "M211",
							"text": "There are 3 ways you can position the camera.",
							"highlight": {},
							"overrides": [],
							"notes": ""
						},
						{
							"id": "M212",
							"text": "1. Reach the border of the screen with your mouse to move in that direction.\n2. Press [Camera_Drag] and drag the camera with your mouse.\n3. Tap [Camera_Up] [Camera_Left] [Camera_Down] [Camera_Right] on your keyboard.",
							"highlight": {},
							"overrides": [],
							"notes": ""
						}
					],
					"trigger": {},
					"flags": 0,
					"props": {
						"position": 2
					},
					"hlcomment": "",
					"speakers": [
						{
							"character": "ShadoutMapes"
						}
					]
				},
				{
					"id": "M1_01_DoMoveCamera",
					"title": "Move the Camera",
					"mainText": "",
					"popupPages": [
						{
							"id": "M213",
							"text": "Move the camera in 2 directions to show me that you understand.",
							"highlight": {},
							"overrides": [],
							"notes": ""
						},
						{
							"id": "M214",
							"text": "Remember, to move the camera:\n1. Reach the border of the screen with your mouse to move in that direction.\n2. Press [Camera_Drag] and drag the camera with your mouse.\n3. Tap [Camera_Up] [Camera_Left] [Camera_Down] [Camera_Right] on your keyboard.",
							"highlight": {},
							"overrides": [],
							"notes": ""
						}
					],
					"trigger": {},
					"flags": 5,
					"props": {
						"position": 2
					},
					"hlcomment": "",
					"speakers": [
						{
							"character": "ShadoutMapes"
						}
					]
				},
				{
					"id": "M1_01_DoMoveCamera_Gamepad",
					"title": "Move the Camera",
					"mainText": "",
					"popupPages": [
						{
							"id": "M213",
							"text": "To move the camera, use [Camera_Gamepad].\n\nMove the camera in 2 directions to show me that you understand.",
							"highlight": {},
							"overrides": [],
							"notes": ""
						}
					],
					"speakers": [
						{
							"character": "ShadoutMapes"
						}
					],
					"flags": 5,
					"props": {
						"position": 2
					},
					"trigger": {},
					"hlcomment": ""
				},
				{
					"id": "M1_01_ZoomOut",
					"title": "Zoom out",
					"mainText": "",
					"popupPages": [
						{
							"id": "M211",
							"text": "You can adjust the zoom level of the camera with the mouse wheel.\n\nZoom out, now.",
							"highlight": {},
							"overrides": [],
							"padText": "You can adjust the zoom level of the camera with [CameraZoom_Gamepad].\n\nZoom out, now.",
							"notes": ""
						}
					],
					"trigger": {},
					"flags": 5,
					"props": {
						"position": 2
					},
					"hlcomment": "",
					"speakers": [
						{
							"character": "ShadoutMapes"
						}
					]
				},
				{
					"id": "M1_01_ZoomTactical",
					"title": "Zoom out",
					"mainText": "",
					"popupPages": [
						{
							"id": "M211",
							"text": "If you zoom out far enough, you will reach tactical view.\n\nEnter tactical view.",
							"highlight": {},
							"overrides": [],
							"padText": "To go even further away, you can press [Camera_Tactical] to enter tactical view.\n\nTry it now.",
							"notes": ""
						}
					],
					"trigger": {},
					"flags": 5,
					"props": {
						"position": 2
					},
					"hlcomment": "",
					"speakers": [
						{
							"character": "ShadoutMapes"
						}
					]
				},
				{
					"id": "M1_01_ZoomIn",
					"title": "Zoom in",
					"mainText": "",
					"popupPages": [
						{
							"id": "M213",
							"text": "Now zoom back in.",
							"highlight": {},
							"overrides": [],
							"padText": "Now zoom back in by pressing [Camera_Tactical] again.",
							"notes": ""
						}
					],
					"trigger": {},
					"flags": 5,
					"props": {
						"position": 2
					},
					"hlcomment": "",
					"speakers": [
						{
							"character": "ShadoutMapes"
						}
					]
				},
				{
					"id": "M1_01_TacticalShortcut",
					"title": "Tactical view",
					"mainText": "",
					"popupPages": [
						{
							"id": "M213",
							"text": "You can also press [Camera_Tactical] to enter tactical view directly.",
							"highlight": {},
							"overrides": [],
							"notes": ""
						}
					],
					"trigger": {},
					"flags": 1,
					"props": {
						"position": 2
					},
					"hlcomment": "",
					"speakers": [
						{
							"character": "ShadoutMapes"
						}
					]
				},
				{
					"id": "M1_01_End",
					"title": "",
					"mainText": "",
					"popupPages": [
						{
							"id": "M211",
							"text": "You know how to control the camera.\n\nYou are still a child, but at least you are a fast learner.",
							"highlight": {},
							"overrides": [],
							"notes": ""
						}
					],
					"trigger": {},
					"flags": 0,
					"props": {
						"position": 2
					},
					"hlcomment": "",
					"speakers": [
						{
							"character": "ShadoutMapes"
						}
					]
				},
				{
					"id": "M1_02_Start",
					"title": "Control the units",
					"mainText": "",
					"popupPages": [
						{
							"id": "M211",
							"text": "Now you are going to learn how to select a unit, order it around and attack.",
							"highlight": {},
							"overrides": [],
							"notes": ""
						}
					],
					"trigger": {},
					"flags": 0,
					"props": {
						"position": 2
					},
					"hlcomment": "",
					"speakers": [
						{
							"character": "ShadoutMapes"
						}
					]
				},
				{
					"id": "M1_02_SelectUnit",
					"title": "Select the unit",
					"mainText": "",
					"popupPages": [
						{
							"id": "M211",
							"text": "To select a unit, [MouseLeft] left-click on its banner.\n\nSelect your unit, now, Noble Born.",
							"highlight": {
								"rightBar": 4096,
								"entities": {
									"match": [
										{
											"alignment": 2,
											"filter": 1,
											"unit": "A_Trooper"
										}
									]
								}
							},
							"overrides": [],
							"padText": "To select a unit, move the camera to put it in the middle of the screen and press [Game_LeftClick].\n\nSelect your unit, now, Noble Born.",
							"notes": ""
						}
					],
					"trigger": {},
					"flags": 5,
					"props": {
						"position": 2
					},
					"hlcomment": "",
					"speakers": [
						{
							"character": "ShadoutMapes"
						}
					]
				},
				{
					"id": "M1_02_MoveUnit",
					"title": "Move the unit",
					"mainText": "",
					"popupPages": [
						{
							"id": "M211",
							"text": "You can order selected units to move by [MouseRight] right-clicking on the ground.\n\nGive a move order.",
							"highlight": {},
							"overrides": [],
							"padText": "You can order selected units to move by pressing [Game_RightClick] on the ground.\n\nGive a move order.",
							"notes": ""
						}
					],
					"trigger": {},
					"flags": 5,
					"props": {
						"position": 2
					},
					"hlcomment": "",
					"speakers": [
						{
							"character": "ShadoutMapes"
						}
					]
				},
				{
					"id": "M1_02_Select2Units",
					"title": "Select the two units",
					"mainText": "",
					"popupPages": [
						{
							"id": "M211",
							"text": "To select several units, drag with [MouseLeft] left-click to form a selection box over their banners, then release.\n\nSelect the two units.",
							"highlight": {
								"rightBar": 4096,
								"entities": {
									"match": [
										{
											"alignment": 2,
											"filter": 1,
											"unit": "A_Trooper"
										}
									]
								}
							},
							"overrides": [],
							"padText": "To select several units, hold [Game_LeftClick] for a second, then release. It will select all military units in a large radius.\n\nSelect the two units.",
							"notes": ""
						}
