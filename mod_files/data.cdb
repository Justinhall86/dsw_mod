					"impCount": 0,
					"mapProps": {
						"height": 50
					},
					"territoryTrait": "CT_EmperorsLanding"
				},
				{
					"id": "ForestHeart",
					"thumb": "UI/regions/MainBases/Foliage.png",
					"texts": {
						"name": "Heart of the Forest",
						"desc": "Foliage has been built to accommodate the Ecazi court during their residency on Arrakis. The location has been chosen carefully for its potential for gardening, as it was out of question for the Ecaz family to remain away from the forest too long, even on such a dry planet."
					},
					"impCount": 0,
					"biome": "C_ForestHeart",
					"type": 3,
					"props": {
						"maxCount": 0,
						"maxFactions": 3,
						"mainBasePresent": "Foliage",
						"aiWeight": 0,
						"secObjectiveBlacklist": [
							{
								"ref": "Conquest_Fremen_SietchRelation"
							}
						],
						"signatureRegion": "Foliage",
						"cityPawn": "CityPawn_Ecaz"
					},
					"mapProps": {
						"height": 50
					}
				},
				{
					"id": "IxianConvergence",
					"thumb": "UI/regions/MainBases/Vernius.png",
					"texts": {
						"name": "Scholar's Refuge",
						"desc": "Fleeing the persecution of the Butlerian Jihad, cybernetic engineers have finally found a haven on Arrakis. How long it will last depends only on House Vernius' capacity to secure the Spice trade as a bargaining chip."
					},
					"impCount": 0,
					"biome": "C_IxianConvergence",
					"type": 3,
					"props": {
						"maxCount": 0,
						"maxFactions": 3,
						"mainBasePresent": "IxianCore",
						"aiWeight": 0,
						"secObjectiveBlacklist": [
							{
								"ref": "Conquest_Fremen_SietchRelation"
							}
						],
						"signatureRegion": "IxianCore",
						"cityPawn": "CityPawn_Vernius"
					},
					"mapProps": {
						"height": 50
					}
				},
				{
					"id": "Tuek",
					"thumb": "UI/regions/MainBases/Sietch_Tuek.png",
					"texts": {
						"name": "Sietch Tuek",
						"desc": "This old sietch was left behind by a dying Fremen tribe. The Smugglers needed a place to hide their operations while remaining close to the major population centers of the planet, so they took over the cave. Nowadays, Sietch Tuek is the most important hub of illegal trade on Arrakis."
					},
					"impCount": 0,
					"biome": "C_Tuek",
					"type": 3,
					"props": {
						"maxCount": 0,
