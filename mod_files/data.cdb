						"desc": "House Thorvald has settled its citadel here, behind contract guards bought with its own coin."
					},
					"biome": "C_EmperorsLanding",
					"props": {
						"maxCount": 0,
						"maxFactions": 3,
						"mainBasePresent": "ThorvaldCitadel",
