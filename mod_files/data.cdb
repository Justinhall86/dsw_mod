				{
					"id": "M6_04_SecondCouncilResults",
					"title": "Second Council",
					"mainText": "",
					"popupPages": [
						{
							"id": "M213",
							"text": "Unlike other resolutions, [Charter]s last until a new vote is called for the same [Charter].",
							"highlight": {},
							"overrides": [],
							"notes": "Speaker is Thufir Hawat"
						}
					],
					"speakers": [
						{
							"character": "Thufir"
						}
					],
					"flags": 768,
					"props": {
						"position": 2
					},
					"trigger": {}
				},
				{
					"id": "M6_04_Ending",
					"title": "Second Council",
					"mainText": "",
					"popupPages": [
						{
							"id": "M213",
							"text": "That's it. We've reviewed the customs of [LandsraadCouncil] and [Charter]s. But, as you know, proficiency with politics comes with years of experience.\n\nThat's all for today, my lord.",
							"highlight": {},
							"overrides": [],
							"notes": "Speaker is Thufir Hawat"
						}
					],
