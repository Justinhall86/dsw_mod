				}
			],
			"lines": [
				{
					"id": "Pressure",
					"texts": {
						"name": "Pressure",
						"desc": "You are not alone on Arrakis. The other Great Houses are going to do everything in their power to prevent you from rising to dominance.",
						"defeatDesc": "Through a combination of military might, intense plotting and sheer luck, your opponents have managed to put an end to all your hopes of gaining full control of Arrakis. This failure will stifle the growth of your House for the rest of your reign.",
						"overrideTexts": [
							{
								"forFaction": "Smugglers",
								"defeatDesc": "Through a combination of military might, intense plotting and sheer luck, your opponents have managed to root out your family's hold on Arrakis. The Spice trade will keep benefiting a few smart entrepreneurs, but you will no longer share in the benefits.",
								"desc": "You are not alone on Arrakis. The Great Houses do not appreciate the influence of commoners of your kind, and will try to stiffle the growth of your enterprise by any means, even the most sordid."
							}
						]
					},
					"steps": [
						{
							"progress": 0.5,
							"bonus": "Plot_Pressure"
						},
						{
							"progress": 0.99,
							"bonus": "Plot_Pressure_Defeat"
						}
					],
					"effects": [
						{
							"vals": [
								{
									"val": 0.03,
									"modifier": {}
								}
							],
							"target": {},
							"target2": {},
							"ref": "Conquest_PlotProgress",
							"trigger": 8,
							"desc": "[Pressure] progresses by ::percent_value::"
						}
					],
					"gfx": {
						"file": "UI/icons/actionIcons.png",
						"size": 40,
						"x": 22,
						"y": 1
					},
					"flags": 0
				},
				{
					"id": "Pressure_Fremen",
					"texts": {
						"name": "Pressure",
						"desc": "A Spice War between two Great Houses is the perfect time to turn the situation to our advantage. While they squabble, we will strike and get rid of them for good.",
						"defeatDesc": "Against the rising threat of a Fremen insurgency, the imperium has united. You failed to seize the chance to free Arrakis. The Fremen are retreating to the south once again, and the oppression of your people will continue, for a few centuries more at least."
					},
					"steps": [
						{
							"progress": 0.5,
							"bonus": "Plot_Pressure_Fremen"
						},
						{
							"progress": 0.99,
							"bonus": "Plot_Pressure_Defeat"
						}
					],
					"effects": [
						{
							"vals": [
								{
									"val": 0.06,
									"modifier": {}
								}
							],
							"target": {},
							"target2": {},
							"ref": "Conquest_PlotProgress",
							"trigger": 1,
							"desc": "[Pressure] progresses by ::percent_value::"
						},
						{
							"vals": [
								{
									"val": 0.06,
									"modifier": {}
								}
							],
							"target": {},
							"target2": {},
							"ref": "Conquest_PlotProgress",
							"trigger": 11,
							"desc": "[Pressure] progresses by ::percent_value::"
						}
					],
					"flags": 2,
					"gfx": {
						"file": "UI/icons/actionIcons.png",
						"size": 40,
						"x": 22,
						"y": 1
					}
				},
				{
					"id": "Murder",
					"effects": [
						{
							"vals": [
								{
									"val": 0.02,
									"modifier": {}
								}
							],
							"target": {},
							"target2": {},
							"ref": "Conquest_PlotProgress",
							"trigger": 8
						},
						{
							"trigger": 6,
							"ref": "Conquest_PlotRegress",
							"vals": [
								{
									"val": 0.03,
									"modifier": {}
								}
							],
							"target": {},
							"target2": {}
						},
						{
							"vals": [
								{
									"val": 0.01,
									"modifier": {}
								}
							],
							"target": {},
							"target2": {},
							"ref": "Conquest_PlotRegress",
							"trigger": 9
						}
					],
					"texts": {
						"name": "Murder",
						"desc": "Your arrival on Arrakis and your increase in influence has attracted jealousy.\nYour spies have identified small signals that seem to induce that parties are trying to plot for your murder.",
						"defeatDesc": "A painful insect sting, or so you thought.\nThe lethal poison of the sting of a Hunter-seeker drone was rapidly spreading in your body. \nDespite your best efforts to stay conscious you did not last long...\n<bad>Your enemies have managed to assassinate you.</bad>"
					},
					"gfx": {
						"file": "UI/icons/actionIcons.png",
						"size": 40,
						"x": 21,
						"y": 1
					},
					"steps": [
						{
							"progress": 0.33,
							"bonus": "Plot_Assassination_1"
						},
						{
							"progress": 0.66,
							"bonus": "Plot_Assassination_2"
						}
					],
					"flags": 1
				},
				{
					"id": "Bankruptcy",
					"texts": {
						"name": "Bankruptcy",
						"desc": "Your arrival on Arrakis and your increase in wealth has attracted jealousy.\nYour spies have identified small signals that seem to induce  that parties are trying to plot for your insolvency.",
						"defeatDesc": "The coffers are empty and the CHOAM now has us on a leash due to our crippling debt.\nOur trip on Arrakis can no longer be supported and we must abandon our plans...\n<bad>Your enemies have managed to bankrupt your house.</bad>"
					},
					"effects": [
						{
							"vals": [
								{
									"val": 0.1,
									"modifier": {}
								}
							],
							"target": {},
							"target2": {},
							"ref": "Conquest_PlotProgress",
							"trigger": 4
						},
						{
							"vals": [
								{
									"val": 0.02,
									"modifier": {}
								}
							],
							"target": {},
							"ref": "Conquest_PlotProgress",
							"trigger": 6,
							"target2": {}
						},
						{
							"vals": [
								{
									"val": 0.04,
									"modifier": {}
								}
							],
							"target": {},
							"target2": {},
							"ref": "Conquest_PlotRegress",
							"trigger": 9
						}
					],
					"gfx": {
						"file": "UI/Faction/factionEmblem.png",
						"size": 64,
						"x": 8,
						"y": 0
					},
					"steps": [
						{
							"progress": 0.33,
							"bonus": "Plot_Bankruptcy_1"
						},
						{
							"progress": 0.66,
							"bonus": "Plot_Bankruptcy_2"
						}
					],
					"flags": 1
				},
				{
					"id": "Defamation",
					"texts": {
						"name": "Defamation",
						"desc": "Your arrival on Arrakis and your increase in reputation has attracted jealousy.\nYour spies have identified small signals that seem to imply that parties are trying to plot for the loss of your status as a great house.",
						"defeatDesc": "You leave the Landsraad headquarters on Salusa Secundus with haste. The vote was unanimous, your House is no longer a part of the Galactic Empire.\nAs is customary, they give you the choice between exile and execution. You have to leave immediately for Tupile, the sanctuary planet, never to return.\n<bad>Your enemies have managed to shame your house out of the Landsraad.</bad>"
					},
					"effects": [
						{
							"vals": [
								{
