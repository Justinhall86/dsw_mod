							"overrides": [],
							"notes": ""
						}
					],
					"speakers": [
						{
							"character": "ShadoutMapes"
						}
					],
					"trigger": {},
					"flags": 0,
					"props": {
						"position": 2
					}
				},
				{
					"id": "M5_02_DemolishBuildingsInfo",
					"title": "Demolish Buildings",
					"mainText": "",
					"popupPages": [
						{
							"id": "M211",
							"text": "You can demolish a [Building] to remove its Upkeep.\n\nIt is sometimes necessary to maintain your [Solari] production positive.",
							"highlight": {},
							"overrides": [],
							"notes": ""
						}
					],
					"speakers": [
						{
							"character": "ShadoutMapes"
