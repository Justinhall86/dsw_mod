		{
			"name": "padAction",
			"columns": [
				{
					"typeStr": "14",
					"name": "gfx",
					"opt": true
				},
				{
					"typeStr": "14",
					"name": "background",
					"opt": true,
					"kind": null
				},
				{
					"typeStr": "0",
					"name": "id",
					"kind": null,
					"scope": null
				},
				{
					"typeStr": "17",
					"name": "texts",
					"documentation": "Available replacements, when a target is available:\n- [::faction::]\n- [::ability::]\n- [::entityKind::]\n- ::refundTitle::\n- ::quest::\n- [::trait::]\n- [::action::]\n- [::building::]"
				},
				{
					"typeStr": "6:input",
					"name": "input",
					"opt": true
				},
				{
					"typeStr": "6:padAction",
					"name": "parent",
					"opt": true,
					"kind": null
				},
				{
					"typeStr": "8",
					"name": "positions",
					"documentation": "Force the position on the wheel. Will make the wheel into 12-sided when specified.\nNegative/mod-12 values are allowed\n(the 12 is const Pad_WheelMaxSectors)"
				},
				{
					"typeStr": "10:CopyTip,Disabled,NameOnSector,AlwaysOnWheel,InspectFocus,CopyOnlyChild,ReverseWheelOrder,IconOnOuterEdge,ForceMask",
					"name": "flags",
					"documentation": "InspectFocus: Will focus (bind layer) the element, until B is pressed\nReplaceIfOnly: When only one child, will display that instead\nReverseWheelOrder: if the wheel has any sector with this, sectors without a forced position will be ordered in reverse\nForceMask: Otherwise uses a mask if a background is available\nCopyOnlyChild: When the subwheel would have only one sector, show that instead. When this sector would be alone, use that directly on the bindings bar"
				},
				{
					"typeStr": "5:Wheel,HoldFocus",
					"name": "type",
					"documentation": "Only takes the first type of the registered actions. \nDefault is Wheel"
				}
			],
