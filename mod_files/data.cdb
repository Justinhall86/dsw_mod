				{
					"id": "M4_02_SpiceSlider_Gamepad3",
					"title": "Spice Slider",
					"mainText": "",
					"popupPages": [
						{
							"id": "M213",
							"text": "Here is the [SpiceReport]. You can see the price for selling [Spice]. The base price is the same for everyone in the universe, but the real price also changes with your reputation and other factors.",
							"highlight": {},
							"overrides": [],
							"notes": ""
						},
						{
							"id": "M216",
							"text": "Use [GaugeSliderUp] and [GaugeSliderDown] to increase of decrease the ratio of [Spice] you stockpile.\n\nTo pay the [$my(contract)] in time, you should raise the Spice slider to stockpile [Spice] faster. Try stockpiling at least 40% of the [Spice] you produce.",
							"highlight": {
								"ui": {
									"match": [
										{
											"id": "spiceDistSlider"
										}
									]
