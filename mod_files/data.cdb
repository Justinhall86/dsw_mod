											"alignment": 4,
											"filter": 0,
											"unit": "H_Trooper"
										}
									]
								}
							},
							"overrides": [],
							"padText": "To order selected units to attack a target, press [Game_RightClick] on it.\n\n\nAttack the [!Harkonnen-adjective] puppet at once.",
							"notes": ""
						}
					],
					"trigger": {},
