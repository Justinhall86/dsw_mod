				{
					"id": "FremenUprising_Start",
					"speechesPerSpeaker": [
						{
							"character": "Piter",
							"pool": [
								{
									"variationIndex": 0,
									"target": 2,
									"speeches": [
										{
											"text": "Your rival is having issues with the Fremen in this territory. Though it is already a pleasing sight, I think you getting involved would make it even more delicious. What do you say, Baron? Have your men liberate a few of their villages, and it should inspire the clods to rebel even more.",
											"match": {
												"gender": 0
											},
											"sfx": "Voice_Conquest_H_Fremenuprising_Piter_1_0",
											"translation_notes": "Speaker is Piter de Vries\nFremen is a book term (invariable in english but it might vary between language)\nterritory is a game term\nPiter often use food-related vocabulary when talking to the Baron (maybe to taunt him?) like \"delicious\" here.\n\"clods\" is a term used by harkonnen to refer to the fremen, it's a book term\nhere \"your rival\" is masculine",
											"voice_notes": "Tone: amused, mocking the opponent."
										},
										{
											"text": "Your rival is having issues with the Fremen in this territory. Though it is already a pleasing sight, I think you getting involved would make it even more delicious. What do you say, Baron? Have your men liberate a few of their villages, and it should inspire the clods to rebel even more.",
											"match": {
												"gender": 1
											},
											"sfx": "Voice_Conquest_H_Fremenuprising_Piter_1f_0",
											"translation_notes": "Speaker is Piter de Vries\nFremen is a book term (invariable in english but it might vary between language)\nterritory is a game term\nPiter often use food-related vocabulary when talking to the Baron (maybe to taunt him?) like \"delicious\" here.\n\"clods\" is a term used by harkonnen to refer to the fremen, it's a book term\nhere \"your rival\" is feminine",
											"voice_notes": "Tone: amused, mocking the opponent."
										}
									]
								}
							]
						},
						{
							"character": "Sanya",
							"pool": [
								{
									"variationIndex": 0,
									"target": 2,
									"speeches": [
										{
											"text": "Who could've known the locals would give the Great Houses so much trouble? Certainly not your rival, haha.\nLook at him, Mother! Plagued with villages he thought he'd conquered! Should we lend a hand to those oppressed peoples? They would soon agree to be ruled by a power that so conveniently aided them.",
											"match": {
												"gender": 0
											},
											"sfx": "Voice_Conquest_E_Fremenuprising_Sanya_1_0",
											"translation_notes": "Speaker is Sanya Ecaz\nhere \"the rival\" is masculine",
											"voice_notes": "Tone: amused, despising"
										},
										{
											"text": "Who could've known the locals would give the Great Houses so much trouble? Certainly not your rival, haha.\nLook at her, Mother! Plagued with villages she thought she'd conquered! Should we land a hand to those oppressed peoples? They would soon agree to be ruled by a power that so conveniently aided them.",
											"match": {
												"gender": 1
											},
											"sfx": "Voice_Conquest_E_Fremenuprising_Sanya_1f_0",
											"translation_notes": "Speaker is Sanya Ecaz\nhere \"the rival\" is feminine",
											"voice_notes": "Tone: amused, despising"
										}
									]
								}
							]
						},
						{
							"character": "Thufir",
							"pool": [
								{
									"variationIndex": 0,
									"target": 2,
									"speeches": [
										{
											"text": "Interesting…\nDuncan Idaho's Fremen contact speaks of a rebellion in this territory. With support from the folk of pan and graben, they're trying to shake off your rival's rule. This is the perfect chance for the Atreides to show the Fremen how useful their support would be.",
											"match": {
												"gender": 0
											},
											"sfx": "Voice_Conquest_A_Fremenuprising_Thufir_1_0",
											"translation_notes": "Speaker is Thufir Hawat\nFremen is a book term (invariable in english but it might vary between language)\nterritory is a game term\nfolk of pan and graben is a book term\nhere \"your rival\" is masculine",
											"voice_notes": "Tone: intrigued, factual, formal. Then, determined"
										},
										{
											"text": "Interesting…\nDuncan Idaho's Fremen contact speaks of a rebellion in this territory. With support from the folk of pan and graben, they're trying to shake off your rival's rule. This is the perfect chance for the Atreides to show the Fremen how useful their support would be.",
											"match": {
												"gender": 1
											},
											"sfx": "Voice_Conquest_A_Fremenuprising_Thufir_1_0",
											"translation_notes": "Speaker is Thufir Hawat\nFremen is a book term (invariable in english but it might vary between language)\nterritory is a game term\nfolk of pan and graben is a book term\nhere \"your rival\" is feminine",
											"voice_notes": "Tone: intrigued, factual, formal. Then, determined"
										}
									]
								}
							]
						},
						{
							"character": "Fenring",
							"pool": [
								{
									"variationIndex": 0,
									"target": 2,
									"speeches": [
										{
											"text": "Your opponent's grip on this territory is not as firm as we thought. The villages are challenging his authority.\nIt has to be a Fremen ploy – the folk of pan and graben aren't known for their rebellious spirit. The confusion might be of benefit to us. By liberating the locals, you would simultaneously gain their allegiance and drive out your enemy from these lands.",
											"match": {
												"gender": 0
											},
											"sfx": "Voice_Conquest_C_Fremenuprising_Hasimir_1_0",
											"translation_notes": "Speaker is Hasimir Fenring\nFremen is a book term (invariable in english but it might vary between language)\nterritory is a game term\nfolk of pan and graben is a book term\nhere \"your enemy\" is masculine",
											"voice_notes": "Tone: calm, formal."
										},
										{
											"text": "Your opponent's grip on this territory is not as firm as we thought. The villages are challenging her authority.\nIt has to be a Fremen ploy – the folk of pan and graben aren't known for their rebellious spirit. The confusion might be of benefit to us. By liberating the locals, you would simultaneously gain their allegiance and drive out your enemy from these lands.",
											"match": {
												"gender": 1
											},
											"sfx": "Voice_Conquest_C_Fremenuprising_Hasimir_1f_0",
											"translation_notes": "Speaker is Hasimir Fenring\nFremen is a book term (invariable in english but it might vary between language)\nterritory is a game term\nfolk of pan and graben is a book term\nhere \"your enemy\" is feminine",
											"voice_notes": "Tone: calm, formal."
										}
									]
								}
							]
						},
						{
							"character": "Tessia",
							"pool": [
								{
									"variationIndex": 0,
									"target": 2,
									"speeches": [
										{
											"text": "A rebellion is underway in this territory. Our agents report that the Fremen are behind it, urging the folk of pan and graben to rise up against your rival. We should make the most of the unrest, my husband. Support these people and free their villages. Become their savior. After that, it will be easy to turn them into loyal subjects.",
											"match": {
												"gender": 0
											},
											"translation_notes": "Speaker is Tessia Vernius\nhere \"your rival\" is masculine",
											"voice_notes": "Tone: calm",
											"sfx": "Voice_Conquest_V_Fremenuprising_Tessia_1_0"
										},
										{
											"text": "A rebellion is underway in this territory. Our agents report that the Fremen are behind it, urging the folk of pan and graben to rise up against your rival.\nWe should make the most of the unrest, my husband. Support these people and free their villages. Become their savior. After that, it will be easy to turn them into loyal subjects.",
											"match": {
												"gender": 1
											},
											"translation_notes": "Speaker is Tessia Vernius\nhere \"your rival\" is feminine",
											"voice_notes": "Tone: calm",
											"sfx": "Voice_Conquest_V_Fremenuprising_Tessia_2_0"
										}
									]
								}
							]
						},
						{
							"character": "Staban",
							"pool": [
								{
									"variationIndex": 0,
									"target": 2,
									"speeches": [
										{
											"text": "Those Great Houses…! To them, a village conquered is a village converted, and a colorful banner is enough to change the people's allegiance! Ha!\nThe Fremen have already lit the embers of rebellion. All that's left now is for us to fan the fire. We should liberate a few villages, Father. If only to stifle your rival's arrogance.",
											"match": {
												"gender": 0
											},
											"translation_notes": "Speaker is Staban\nhere \"your rival\" is masculine",
											"voice_notes": "Tone: despising, mocking, planning",
											"sfx": "Voice_Conquest_S_Fremenuprising_Staban_1_0"
										},
										{
											"text": "Those Great Houses…! To them, a village conquered is a village converted, and a colorful banner is enough to change the people's allegiance! Ha!\nThe Fremen have already lit the embers of rebellion. All that's left now is for us to fan the fire. We should liberate a few villages, Father. If only to stifle your rival's arrogance.",
											"match": {
												"gender": 1
											},
											"translation_notes": "Speaker is Staban\nhere \"your rival\" is feminine",
											"voice_notes": "Tone: despising, mocking, planning",
											"sfx": "Voice_Conquest_S_Fremenuprising_Staban_1f_0"
										}
									]
								}
							]
						}
					],
					"from": 0,
					"props": {},
					"flags": 0
				},
				{
					"id": "FremenUprising_Step1",
					"speechesPerSpeaker": [
						{
							"character": "Piter",
							"pool": [
								{
									"variationIndex": 0,
									"target": 2,
									"speeches": [
										{
											"text": "The Fremen were dumbfounded when the butchers – that's how they refer to your House! Haha – liberated their villages.\nThey're now asking you to help them destroy your opponent's base. Say yes, Baron! I'm dying to see the look on your enemy's face on learning that Fremen and Harkonnens have joined forces against them.",
											"match": {
												"gender": 0
											},
											"sfx": "Voice_Conquest_H_Fremenuprising_Piter_1_1",
											"translation_notes": "Speaker is Piter de Vries\nFremen is a book term (invariable in english but it might vary between language)\nbase is a game term (main base)\n\nhere \"your opponent\" is masculine",
											"voice_notes": "Tone: amused (this mission is a lot of fun for Piter), mocking the Baron.\nEager and enthusiastic on the last sentence"
										},
										{
											"text": "The Fremen were dumbfounded when the butchers – that's how they refer to your House! Haha – liberated their villages.\nThey're now asking you to help them destroy your opponent's base. Say yes, Baron! I'm dying to see the look on your enemy's face on learning that Fremen and Harkonnens have joined forces against them.",
											"match": {
												"gender": 1
											},
											"sfx": "Voice_Conquest_H_Fremenuprising_Piter_1f_1",
											"translation_notes": "Speaker is Piter de Vries\nFremen is a book term (invariable in english but it might vary between language)\nbase is a game term (main base)\n\nhere \"your opponent\" is feminine",
											"voice_notes": "Tone: amused (this mission is a lot of fun for Piter), mocking the Baron.\nEager and enthusiastic on the last sentence"
										}
									]
								}
							]
						},
						{
							"character": "Sanya",
							"pool": [
								{
									"variationIndex": 0,
									"target": 2,
									"speeches": [
										{
											"text": "Thanks to your expertise, the rebellion is turning into an insurrection. What a master stroke!\nOur new allies are captivated – they're getting ready to attack your enemy's base and requesting your support as a favor. I reckon it's time to finish your work.",
											"match": {
												"gender": 0
											},
											"sfx": "Voice_Conquest_E_Fremenuprising_Sanya_1_1",
											"translation_notes": "Speaker is Sanya Ecaz\nbase is a game term (main base)\nhere \"the enemy\" is masculine\n\n",
											"voice_notes": "Tone: impressed by the player, admiring. \nThen, on the 2§, neutral"
										},
										{
											"text": "Thanks to your expertise, the rebellion is turning into an insurrection. What a master stroke!\nOur new allies are captivated – they're getting ready to attack your enemy's base and requesting your support as a favor. I reckon it's time to finish your work.",
											"match": {
												"gender": 1
											},
											"sfx": "Voice_Conquest_E_Fremenuprising_Sanya_1f_1",
											"translation_notes": "Speaker is Sanya Ecaz\nbase is a game term (main base)\nhere \"the enemy\" is feminine\n\n",
											"voice_notes": "Tone: impressed by the player, admiring. \nThen, on the 2§, neutral"
										}
									]
								}
							]
						},
						{
							"character": "Thufir",
							"pool": [
								{
									"variationIndex": 0,
									"target": 2,
									"speeches": [
										{
											"text": "The Fremen are cheering your name and Lady Jessica's. They're ready to launch a final assault on your enemy's base. Shall I give the order?",
											"match": {
												"gender": 0
											},
											"sfx": "Voice_Conquest_A_Fremenuprising_Thufir_1_1",
											"translation_notes": "Speaker is Thufir Hawat\nFremen is a book term (invariable in english but it might vary between language)\nbase is a game term (Main base)\nhere \"your rival\" is masculine",
											"voice_notes": "Tone: factual, pleased, proud of his duke"
										},
										{
											"text": "The Fremen are cheering your name and Lady Jessica's. They're ready to launch a final assault on your enemy's base. Shall I give the order?",
											"match": {
												"gender": 1
											},
											"sfx": "Voice_Conquest_A_Fremenuprising_Thufir_1f_1",
											"translation_notes": "Speaker is Thufir Hawat\nFremen is a book term (invariable in english but it might vary between language)\nbase is a game term (Main base)\nhere \"your rival\" is feminine",
											"voice_notes": "Tone: factual, pleased, proud of his duke"
										}
									]
								}
							]
						},
						{
							"character": "Fenring",
							"pool": [
								{
									"variationIndex": 0,
									"target": 0,
									"speeches": [
										{
											"text": "I never thought I would see Sardaukar and Fremen fighting side by side. The effectiveness of their combined forces has proven fearsome.\nIt's given them ideas: They are begging for your aid in their assault against the enemy base. Majesty, we should make use of such men. We can always get rid of them once the conquest of Arrakis is complete.",
											"match": {},
											"sfx": "Voice_Conquest_C_Fremenuprising_Hasimir_1_1",
											"translation_notes": "Speaker is Hasimir Fenring\nFremen is a book term (invariable in english but it might vary between language)\nSardaukar is a book and game term (invariable in english, but it might vary between language)\nbase is a game term (main base)\nFenring specifically use \"Majesty\", not \"your majesty\"",
											"voice_notes": "Tone: a bit surprised at first then, comes back to facts and formality"
										}
									]
								}
							]
						},
						{
							"character": "Tessia",
							"pool": [
								{
									"variationIndex": 0,
									"target": 2,
									"speeches": [
										{
											"text": "Your achievements have impressed the people of Arrakis. They seem willing to put their trust in you.\nWe should seal this promising partnership with an attack on your enemy’s Base. It will not be easy, my love, but a victory will bring us both a new territory and reliable allies.",
											"match": {
												"gender": 0
											},
											"translation_notes": "Speaker is Tessia Vernius\nhere \"your enemy\" is masculine",
											"voice_notes": "Tone: satisfied, smiling, proud of her husband. Then, she becomes serious, pushing gently her husband to follow her advices",
											"sfx": "Voice_Conquest_V_Fremenuprising_Tessia_1_1"
										},
										{
											"text": "Your achievements have impressed the people of Arrakis. They seem willing to put their trust in you. \r\nWe should seal this promising partnership with an attack on your enemy’s Base. It will not be easy, my love, but a victory will bring us both a new territory and reliable allies.",
											"match": {
												"gender": 1
											},
											"translation_notes": "Speaker is Tessia Vernius\nhere \"your enemy\" is feminine",
											"voice_notes": "Tone: satisfied, smiling, proud of her husband. Then, she becomes serious, pushing gently her husband to follow her advices",
											"sfx": "Voice_Conquest_V_Fremenuprising_Tessia_2_1"
										}
									]
								}
							]
						},
						{
							"character": "Staban",
							"pool": [
								{
									"variationIndex": 0,
									"target": 2,
									"speeches": [
										{
											"text": "The Fremen's uprising is proceeding as planned. The men of the desert are more than satisfied. Otheym, who is leading this mission, even suggested that we take part in a raid on the enemy base. Imagine your noble opponent's terror when he sees the united people of Arrakis descending upon his positions.",
											"match": {
												"gender": 0
											},
											"translation_notes": "Speaker is Staban\nhere \"your noble opponent\" is masculine",
											"voice_notes": "Tone: satisfied, grinning on the last sentence",
											"sfx": "Voice_Conquest_S_Fremenuprising_Staban_1_1"
										},
										{
											"text": "The Fremen's uprising is proceeding as planned. The men of the desert are more than satisfied. Otheym, who is leading this mission, even suggested that we take part in a raid on the enemy base. Imagine your noble opponent's terror when she sees the united people of Arrakis descending upon her positions.",
											"match": {
												"gender": 1
											},
											"translation_notes": "Speaker is Staban\nhere \"your noble opponent\" is feminine",
											"voice_notes": "Tone: satisfied, grinning on the last sentence",
											"sfx": "Voice_Conquest_S_Fremenuprising_Staban_1f_1"
										}
									]
								}
							]
						}
					],
					"from": 0,
					"props": {},
					"flags": 0
				},
				{
					"id": "SietchRescue_Start",
					"speechesPerSpeaker": [
						{
							"character": "Stilgar",
							"pool": [
								{
									"variationIndex": 0,
									"target": 2,
									"speeches": [
										{
											"text": "The night sky was black with cielagos… and the messages they carried were darker still. The sietches fear an attack from your enemy and are preparing to defend their water and their families, but the tribes cannot help one another. They fear too much for their own survival.\nLet us march on the offworlders' base. Our warriors must destroy it before the Fremen in this territory fail.",
											"match": {
												"gender": 0
											},
											"translation_notes": "Speaker is Stilgar\nhere \"your enemy\" is masculine",
											"voice_notes": "Tone: serious, preoccupied but not fearful, determined",
											"sfx": "Voice_Conquest_F_Sietchrescue_Stilgar_1_0"
										},
										{
											"text": "The night sky was black with cielagos… and the messages they carried were darker still. The sietches fear an attack from your enemy and are preparing to defend their water and their families, but the tribes cannot help one another. They fear too much for their own survival.\nLet us march on the offworlders' base. Our warriors must destroy it before the Fremen in this territory fail.",
											"match": {
												"gender": 1
											},
											"translation_notes": "Speaker is Stilgar\nhere \"your enemy\" is feminine",
											"voice_notes": "Tone: serious, preoccupied but not fearful, determined",
											"sfx": "Voice_Conquest_F_Sietchrescue_Stilgar_1f_0"
										}
									]
								}
							]
						}
					],
					"from": 0,
					"flags": 0,
					"props": {}
				},
				{
					"id": "SpiceHeist_Start",
					"speechesPerSpeaker": [
						{
							"character": "Staban",
							"pool": [
								{
									"variationIndex": 0,
									"target": 2,
									"speeches": [
										{
											"text": "The information seemed so preposterous, I was reluctant to tell you, but… it seems our enemy is dipping his toe into the black market. The buyer is none other than a Great House of the Landsraad, come to collect its spice shipment at the source.\nWe should give them a little lesson in smuggling! Let's raid their stocks of spice and intercept their transporters, to teach them how things work around here. The hard way!",
											"match": {
												"gender": 0
											},
											"translation_notes": "Speaker is Staban\nhere \"our enemy\" is masculine",
											"voice_notes": "Tone: mocking (blackmarket is the Smugglers' specialty, seen a Great House trying to join them is ridiculous). Fierce and grinning on the last part.",
											"sfx": "Voice_Conquest_S_Spiceheist_Staban_1_0"
										},
										{
											"text": "The information seemed so preposterous, I was reluctant to tell you, but… it seems our enemy is dipping his toe into the black market. The buyer is none other than a Great House of the Landsraad, come to collect its spice shipment at the source.\r\nWe should give them a little lesson in smuggling! Let's raid their stocks of spice and intercept their transporters, to teach them how things work around here. The hard way!",
											"match": {
												"gender": 1
											},
											"translation_notes": "Speaker is Staban\nhere \"our enemy\" is feminine",
											"voice_notes": "Tone: mocking (blackmarket is the Smugglers' specialty, seen a Great House trying to join them is ridiculous). Fierce and grinning on the last part.",
											"sfx": "Voice_Conquest_S_Spiceheist_Staban_1f_0"
										}
									]
								}
							]
						}
					],
					"from": 0,
					"flags": 0,
					"props": {}
				},
				{
					"id": "SpiceHeist_Step1",
					"speechesPerSpeaker": [
						{
							"character": "Staban",
							"pool": [
								{
									"variationIndex": 0,
									"target": 0,
									"speeches": [
										{
											"text": "According to our spies, the first Spice Freighter has just left the enemy base. Should I give our men the order to shoot it down? It might draw unwanted attention, but we could recover its cargo.",
											"match": {},
											"translation_notes": "Speaker is Staban\nSpice Freighter is the in-game name of a unit. Please use the same translation here.",
											"voice_notes": "Tone: casual but serious",
