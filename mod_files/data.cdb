							"props": {},
							"constOverrides": []
						},
						{
							"id": "Hard",
							"name": "Hard",
							"desc": "The Hard AI has small bonuses to most of its productions and military units, to give it an edge. It will also see the player as more threatening than other factions, and act in consequence.",
