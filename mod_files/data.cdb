						]
					},
					"flags": 0
				},
				{
					"id": "AncientSietch_Step1_NoHostile",
					"speechesPerSpeaker": [],
					"from": 0,
					"props": {
						"useSpeechFrom": "AncientSietch_Step1",
						"actions": [
							{
								"title": "Raze the Sietch",
								"desc": "",
								"effects": [
									{
										"vals": [
											{
												"val": 1,
												"comment": ""
											}
										],
										"target": {
											"blackboard": "BattleVar"
										},
										"target2": {},
										"ref": "Blackboard_SetVal",
										"displayed": false
									}
								]
							},
							{
								"title": "Leave the Sietch alone",
								"desc": "",
								"effects": [
									{
										"vals": [
											{
												"val": 3,
												"comment": ""
											}
										],
										"target": {
											"blackboard": "BattleVar"
										},
										"target2": {},
										"ref": "Blackboard_SetVal",
