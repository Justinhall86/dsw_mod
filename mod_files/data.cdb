					"trigger": {}
				},
				{
					"id": "CB_TheRenegades",
					"title": "The Renegades",
					"mainText": "",
					"popupPages": [
						{
							"id": "CBAS1",
							"text": "Hello, House representatives.\n\nA gang of renegades have managed to dodge their exile on Tupile. They have come to Arrakis to destabilize the [Spice] trade.",
							"overrides": [],
							"highlight": {},
							"notes": ""
						},
						{
							"id": "CBAS2",
							"text": "Could you do the [SpacingGuild-shortname] a favor and get rid of the nuisance?\n\nWe have arranged passage for two of your ships.",
							"overrides": [],
							"highlight": {},
							"notes": ""
						}
					],
					"speakers": [
						{
							"character": "SpacingGuild"
						}
					],
					"flags": 0,
					"props": {
						"position": 2
					},
					"trigger": {}
				},
				{
					"id": "CB_RichGetRicher",
					"title": "Bailout",
					"mainText": "",
					"popupPages": [
						{
							"id": "CBAS1",
							"text": "",
							"overrides": [
								{
									"text": "The CHOAM calls for help. This is an opportunity to take control of [::territory::] without a drop of blood. We only need to outbuy the other Houses.",
									"character": "Thufir",
									"notes_overrides": ""
								},
								{
									"text": "The CHOAM is falling apart, just slightly, and everyone cries for a bailout! What happenened to the invisible hand?\n\nAnyway, you can profit from this. It's easy, just buy some shares.",
									"character": "Piter",
									"notes_overrides": ""
								},
								{
									"text": "CHOAM instability is bad for the whole Imperium. We should remind everyone why [Corrino-longname] is at the helm.",
									"character": "Fenring",
									"notes_overrides": ""
								},
								{
									"text": "The CHOAM is in trouble. It's not good. We should help.\n\nAlso, [::territory::] is nice, don't you think? It would be a shame if it fell into the wrong hands.",
									"character": "Sanya",
									"notes_overrides": ""
								}
							],
							"highlight": {},
							"notes": ""
						}
					],
					"speakers": [
						{
							"character": "Thufir",
							"faction": "Atreides"
						},
						{
							"faction": "Corrino",
							"character": "Fenring"
						},
						{
							"faction": "Harkonnen",
							"character": "Piter"
						},
						{
							"faction": "Ecaz",
							"character": "Sanya"
						}
					],
					"flags": 0,
					"props": {
						"position": 2
					},
					"trigger": {}
				},
				{
					"id": "CB_AncientSietch_DecideFate",
					"title": "The Ancient Sietch's fate",
					"mainText": "",
					"popupPages": [
						{
							"id": "CBAS1",
							"text": "This place is sacred for the Fremen. You might have good intentions, but others won't. Help us protect it, and we will part as friends.",
							"highlight": {},
							"overrides": [],
							"notes": ""
						}
					],
					"trigger": {},
					"flags": 4,
					"props": {
						"position": 2,
