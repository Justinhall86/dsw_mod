					"name": "flags",
					"documentation": "NoCount: Don't count for max battle to show\nAlwaysChosen: If conditions are met, will be pick\nFirstLowDifficulty: Mission that can be picked when starting a conquest at Easy/Medium difficulty"
				},
				{
					"typeStr": "17",
					"name": "props",
					"kind": null
				}
			],
			"lines": [
				{
					"id": "Controls",
					"texts": {
						"name": "1. Basic Controls",
						"desc": "Control the camera|Give orders to your Units|Control the flow of time"
					},
					"objectives": [
