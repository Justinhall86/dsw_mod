				{
					"id": "M1_02_AttackUnit",
					"title": "Attack the Harkonnen",
					"mainText": "",
					"popupPages": [
						{
							"id": "M211",
							"text": "To order selected units to attack a target, [MouseRight] right-click on its banner.\n\nAttack the [!Harkonnen-adjective] puppet at once.",
							"highlight": {
								"entities": {
									"match": [
