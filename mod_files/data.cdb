							"score": 100
						}
					],
					"props": {},
					"weight": 2
				},
				{
					"id": "AIUnitsEatenOnPlayerTerritory",
					"options": [],
					"conditionsComment": "IA se fait manger des unités chez le joueur\r",
					"scoreComment": "20 par unité\r",
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "I cannot take revenge against the [Sandworm] for this undignified loss. You will pay instead."
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": "You lucky imbecile! What kind of primitive boor lets the worms roam free in their land? Was it a desperate attempt at compensating your feeble defense?"
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": "I'll be damned! Why would the worm swallow my troops and leave yours untouched? On the bright side, now that I think of it, these mercenaries will never reclaim their wages."
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": "Shai-Hulud punished me. I was wishing so hard for your demise that I forgot to prevent mine. Arrakis has a way of neutralizing excess, and surely, you will be next."
								}
							]
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "This is why I despise this planet. The monstrosities that roam its sand are revolting and unpredictable."
								}
							]
						}
					],
					"implemented": true,
					"eventConditions": [
						{
							"ref": "UnitEatenInTerritory",
							"duration": 10,
							"conditions": {
								"zone": 1,
								"target": 0
							},
							"score": 20
						}
					],
					"props": {},
					"weight": 2
				},
				{
					"id": "PlayerUnitsEatenOnAITerritory",
					"options": [],
					"conditionsComment": "Joueur se fait manger des unités chez l'IA",
					"scoreComment": "20 par unité",
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "You cannot even walk this land and you expect to wage war against me? You are hilarious."
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": "Sure, I will brutally punish you for sending your sorry troops at me... but your buffoonery is making it hard for me to keep a straight face while doing so."
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": "Arrakis is on my side! My presence here is natural but your only contribution to this planet is the way you feed soldiers to the worms!"
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": "How foolish. Instead of handing your troops to the worms, at least hand them to me. It would prevent a prejudicial loss of water."
								}
							]
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "Well. That was a spell of bad luck if I ever saw one."
								}
							]
						}
					],
					"implemented": true,
					"eventConditions": [
						{
							"ref": "UnitEatenInTerritory",
							"conditions": {
								"zone": 0,
								"target": 1
							},
							"duration": 10,
							"score": 20
						}
					],
					"props": {},
					"weight": 2
				},
				{
					"id": "PlayerOperationOnAI",
					"options": [],
					"conditionsComment": "Mission d'espionnage achevée et échouée chez le joueur",
					"scoreComment": "50",
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "You know how I despise your cowardly schemes. What you ignore is how soon you will come to regret them too."
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": "I cannot tell exactly what you are trying to achieve with these convoluted schemings but if you keep buzzing in my ears, I will have to swat you."
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": "Stop these perfidious attacks! I know I work in the shadows myself, but how can you compare resistance to conspiracy?"
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": "Indeed, it is hard to fight us Fremen frontally so you must resort to dastardly aggressions. But this will not suffice to save you."
								}
							]
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "I am the emperor. Don't you dare use your tricks on me."
								}
							]
						}
					],
					"implemented": true,
					"eventConditions": [
						{
							"ref": "OperationUsedAgainst",
							"conditions": {
								"instigator": 1,
								"target": 0
							},
							"duration": 10,
							"score": 50
						}
					],
					"props": {},
					"weight": 3
				},
				{
					"id": "AIOperationOnPlayer",
					"options": [],
					"conditionsComment": "Mission d'espionnage achevée et réussie chez le joueur\r",
					"scoreComment": "50",
					"implemented": true,
					"eventConditions": [
						{
							"ref": "OperationUsedAgainst",
							"conditions": {
								"instigator": 0,
								"target": 1
							},
							"duration": 10,
							"score": 50
						}
					],
					"props": {},
					"weight": 3
				},
				{
					"id": "AIAttackOnPlayer",
					"options": [],
					"conditionsComment": "Attaque de l'IA sur un joueur humain\n- perte d'unité\n- déclenchement de milice\n- actions hostile de village",
					"scoreComment": "100 - score attaque précédent\n(le score d'attaque baisse de 1 toutes les 10s, min1)\n1 score d'attaque différent par faction",
					"implemented": true,
					"eventConditions": [
						{
							"ref": "VillageOccupationAction",
							"conditions": {
								"instigator": 0,
								"target": 1
							},
							"duration": 10,
							"score": 100
						},
						{
							"ref": "OpponentUnitKilled",
							"conditions": {
								"instigator": 0,
								"target": 1
							},
							"duration": 10,
							"score": 20
						}
					],
					"props": {},
					"weight": 3,
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "Be reassured, this war will soon be over. This could be the only good news for you, though."
								},
								{
									"desc": "We do not need to keep spilling more blood. I am still allowing you to surrender."
								},
								{
									"desc": "You do not seem to comprehend the gravity of this. Can't your hear the screams of your dying soldiers?"
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": "I will do you a service and pretend to actually wage war. It could make your impending demise look slightly more exciting."
								},
								{
									"desc": "I would gladly try to capture your land without destroying it, but truthfully, you left me nothing worth saving. A tabula rasa seems long overdue here."
								},
								{
									"desc": "I hate to sound brutal, but common courtesy forces me to make my intentions clear... there will be nothing left of you when I am done."
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": "Don't take it personally. War is but a form of trade. Today, it's more interesting for me to deal with you, but our exchanges could be very different tomorrow. "
								},
								{
									"desc": "Don't worry, my friend. Sure, I attack, and presumably, I'll defeat you. But remember it's not in my interest to cripple you too much. I can still use you afterwards!"
								},
								{
									"desc": "I don't enjoy war very much and I usually find it wasteful but there's pleasure in defeating you. Thanks for making it worth the effort!"
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": "Get used to being attacked, for it will happen again. Throughout our history, we have only known adversity and occupation. Resistance is a part of our lives."
								},
								{
									"desc": "Just give up the fight. We know the land, we know the struggle, we know you more than we need to and our faith is indefectible. Your only advantage is innocence."
								},
								{
									"desc": "This is just a start. With each soldier down, you are losing hope, water and might. Meanwhile, we are only getting stronger."
								}
							]
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "I don't think you are a trustworthy ally. There is nothing more. I only need a bit less of you."
								}
							]
						}
					]
				},
				{
					"id": "PlayerAttackOnAI",
					"options": [],
					"conditionsComment": "Attaque du joueur sur l'IA\n- perte d'unité\n- déclenchement de milice\n- actions hostile de village",
					"scoreComment": "Score d'attaque commun avec la condition précédente",
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "Now you know we can take a punch. We will soon discover if the same can be said of you."
								},
								{
									"desc": "No assault could ever reach the honor of the Atreides. We stand even stronger in adversity. "
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": "I may have a reputation for being cruel but when you attack me with such barbarity, I show exceptional restraint by not blowing up this entire, wretched planet!"
								},
								{
									"desc": "I feel... immense wrath... I will crush your miserable skull with my bare hands if you send another dreadful assault at me!"
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": "For each blow I take, I'll repay you twice. This is the only time you'll see me on the generous side of a transaction!"
								},
								{
									"desc": "You'll never get rid of me. I'm everywhere! Cut one head and two more will grow."
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": "You may think you are winning battles, but our strength remains the same. You cannot disrupt a system that incorporates hardship and death as parts of its cycle."
								},
								{
									"desc": "Outside Arrakis, this would be a disastrous event. Here, it is merely the continuation of a daily strife. You may hit us, but your assaults are unremarkable."
								}
							]
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "You dare attack your Emperor? There will be consequences. Beyond what you can imagine."
								}
							]
						}
					],
					"implemented": true,
					"eventConditions": [
						{
							"ref": "VillageOccupationAction",
							"conditions": {
								"instigator": 1,
								"target": 0
							},
							"duration": 10,
							"score": 100
						},
						{
							"ref": "OpponentUnitKilled",
							"conditions": {
								"instigator": 1,
								"target": 0
							},
							"duration": 10,
							"score": 20
						}
					],
					"props": {},
					"weight": 3
				},
				{
					"id": "PlayerInfiltrationLevel",
					"options": [],
					"conditionsComment": "Niveau de connaissance chez l'IA par catégorie\r",
					"scoreComment": "1 par niveau de connaissance\r",
					"regularScore": 1,
					"conditions": {
						"infiltrationLevel": 1
					},
					"implemented": true,
					"props": {},
					"weight": 2
				},
				{
					"id": "AIInfiltrationLevel",
					"options": [],
					"conditionsComment": "Niveau de connaissance chez le joueur par catégorie\r",
					"scoreComment": "1 par niveau de connaissance",
					"regularScore": 1,
					"conditions": {
						"ownedInfiltrationLevel": 1
					},
					"implemented": true,
					"props": {},
					"weight": 2
				},
				{
					"id": "HighPlayerStanding",
					"options": [],
					"conditionsComment": "Standing joueur niveau Max",
					"regularScore": 1,
					"scoreComment": "tant que la condition est vraie",
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "You have my esteem, but take good care of it. Having a prosperous neighbor is uplifting. Watching them flaunt feels differently."
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": "How I admire those who manage to die with a reputation for sanctity! This unattainable dream... so far from me but so close to you... You could almost touch it."
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": "Look at yourself! How eminent you've become! Let's just hope you won't forget who your friends are... or who has their people monitoring your facilities..."
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": "Heavens. I can only admire how you sometimes manage to reveal the peaceful side of Arrakis. Just stay aware that nothing is permanent here but adversity."
								}
							]
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "You seem like a trustworthy vassal. You have my thanks for your diligent work, in the name of the Empire."
								}
							]
						}
					],
					"conditions": {
						"aboveStanding": 400
					},
					"implemented": true,
					"props": {},
					"weight": 2
				},
				{
					"id": "LowPlayerStanding",
					"options": [],
					"regularScore": 1,
					"conditionsComment": "Standing joueur niveau Min ",
					"scoreComment": "tant que la condition est vraie",
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "While we search the sands for spice, you seem to be digging in pursuit of rock bottom. Your presence here is an insult."
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": "Despising people may be my strong point... but no matter how violent, my contempt for you could never match the extent of your misery."
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": "Get yourself together, I implore you! I invested much in your activities and it's affecting my reputation now. Do you think I want to be seen dealing with a pariah?"
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": "Mu zein wallah! Arrakis could never remedy your mediocrity. It could have made you rich, prosperous, influential, but even those benefits you are failing to seize."
								}
							]
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "I... don't think I can invite you to attend the imperial ball. I am sure you understand we cannot mix true imperial nobility with people of your ill repute."
								}
							]
						}
					],
					"conditions": {
						"belowStanding": 100
					},
					"implemented": true,
					"props": {},
					"weight": 2
				},
				{
					"id": "GoodRelationship",
					"options": [],
					"conditionsComment": "Bonne relations\r",
					"regularScore": 1,
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "I am glad to count you as a partner. This too is a scarce and valuable resource on Arrakis."
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": "I appreciate that our diplomatic ties seem to strengthen with time. I would have hated having to destroy you when you are so valuable."
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": "My fellow! My comrade! Aren't we headed for greatness? Building a partnership on the most profitable planet in existence... We'll be unbeatable!"
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": "Subakh ul kuhar! I am glad to salute you as a comrade. Our trust is not easily earned, but it is unwavering and sincere once given."
								}
							]
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "You seem well aware that staying in our good graces is essential to any faction's survival. We can contentedly say that yours might last for a few more millenia."
								}
							]
						}
					],
					"conditions": {
						"aboveRelationshipValue": 1
					},
					"implemented": true,
					"props": {},
					"weight": 3
				},
				{
					"id": "BadRelationship",
					"options": [],
					"conditionsComment": "Mauvaise relation",
					"regularScore": 1,
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "The [Sandworm] I can endure. The lack of water I can get used to. But you are too much. I cannot stand such an obnoxious sight."
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": "There are many inconveniences on Arrakis which cannot be remedied. I salute you for being one of the few I might easily suppress."
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": "My activities have little to do with affinity. I usually deal with everyone, no matter how despicable... but I can sacrifice business if it can keep you away from me."
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": "I pity you. What will you become, now that you are despised by a relentless, ubiquitous and impervious people? You will not survive us."
								}
							]
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "You ought to have more respect for your emperor. Your transgressions reflect poorly on your character."
								}
							]
						}
					],
					"conditions": {
						"belowRelationshipValue": 1
					},
					"implemented": true,
					"props": {},
					"weight": 3
				},
				{
					"id": "VoteSameResolution",
					"options": [],
					"conditionsComment": "Vote pour la même résolution\r",
					"scoreComment": "nb vote commun\r",
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "Right! We both knew this was the only valid resolution. I'm happy we see eye to eye!"
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": "It is good that we agree on this resolution. I despise having to fight over things that should not even be discussed."
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": "My friend, what a thrill it is to see our mutual interests match! It is good we fought for this resolution together, as a team!"
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": "Bi-la Kaifa. What had to be said has been said. This resolution is right. Let us hope for the best."
								}
							]
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "I knew I could count on your support for this resolution. Maybe our goals are not that much apart in the end."
								}
							]
						}
					],
					"implemented": true,
					"eventConditions": [
						{
							"ref": "SameVote",
							"conditions": {
								"playerWithAI": true
							},
							"duration": 10,
							"score": 30
						}
					],
					"props": {},
					"weight": 2
				},
				{
					"id": "PlayerVoteForAI",
					"options": [],
					"conditionsComment": "Vote positif pour IA\r",
					"scoreComment": "nb Vote\r",
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "This is much appreciated! We will not forget this gracious vote, I give you my word."
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": "How unexpected. It is fairly unusual for a House envied by all others to receive unsolicited gifts."
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": "Thank you for this vote, my partner! I see you can tell where your interest is! And I'll soon prove to you how right you were!"
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": "Thank you for this vote. As the ecosystem nourishes the lifeforms it hinges on, we will make sure your generosity is rewarded. What is given is never lost."
								}
							]
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "Thank you for supporting me. I deserve it of course, but I appreciate the gesture nonetheless."
								}
							]
						}
					],
					"implemented": true,
					"eventConditions": [
						{
							"ref": "PositiveVote",
							"conditions": {
								"instigator": 1,
								"target": 0
							},
							"duration": 10,
							"score": 30
						}
					],
					"props": {},
					"weight": 2
				},
