											"alignment": 0,
											"filter": 0,
											"building": "ResearchHub"
										},
										{
											"alignment": 0,
											"filter": 0,
											"building": "DataCenter"
										}
									]
								}
							},
							"notes": ""
						}
					],
					"speakers": [
