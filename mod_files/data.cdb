				{
					"id": "PlayerCharter",
					"options": [],
					"conditionsComment": "Obtention d'une charte par le joueur\r",
					"scoreComment": "200 / nb IA à toutes les factions IA\r",
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "Those who thrive should not envy the smaller victories of those who strive. We congratulate you on this [Charter]."
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": "It is good that lower factions receive some encouragement. Wearing your charter as a chintzy crown might finally impel you to act as a leader."
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": "Congratulations, a charter is a huge opportunity! This is our luck. You'll definitely need my assistance to take full advantage of it, and I am glad to help!"
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": "Surely a charter will advantage you. But will it remedy your inability to change and adapt? Otherwise, I cannot see a future for you on Arrakis."
								}
							]
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "I congratulate you on your political advancement. You deserve the title and status."
								}
							]
						}
					],
					"implemented": true,
					"eventConditions": [
						{
							"ref": "CharterObtained",
							"conditions": {
								"instigator": 1
							},
							"score": 100
						}
