				},
				{
					"id": "SpiceHeist_Step1_SecondPage",
					"speechesPerSpeaker": [
						{
							"character": "Staban",
							"pool": [
								{
									"variationIndex": 0,
									"target": 0,
									"speeches": [
										{
											"text": "There's another possibility, too. We could replace one of their mysteriously lost Freighters with one of our own... An explosive delivered into the heart of the buyer's base would teach them an <i>unforgettable</i> lesson.",
											"match": {},
											"translation_notes": "Speaker is Staban\nSpice Freighter is the in-game name of a unit. Please use the same translation here.",
											"voice_notes": "Tone: casual, mocking, amused",
											"sfx": "Voice_Conquest_S_Spiceheist_Staban_1_1np"
