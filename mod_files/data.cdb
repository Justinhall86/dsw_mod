					"type": 0,
					"props": {}
				},
				{
					"id": "Game_SpectatorConnected",
					"text": "::user:: has joined as spectator",
					"type": 0,
					"props": {}
				},
				{
					"id": "Game_UserDestroyedBy",
					"text": "[::faction::-longname] has been defeated by [::faction2::-longname]",
					"type": 0,
					"props": {
						"restoreOnSave": true
					}
				},
				{
					"id": "Game_UserDestroyedByNeutral",
					"text": "[::faction::-longname] has been defeated by [::faction2::-longname]",
					"type": 0,
					"props": {
						"restoreOnSave": true
					}
				},
				{
