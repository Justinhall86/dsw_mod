				{
					"id": "M1_03_CursorExplanation_Gamepad",
					"title": "Explore the interface",
					"mainText": "",
					"popupPages": [
						{
							"id": "M214",
							"text": "There is one last thing you need to know before we go further.",
							"highlight": {},
							"overrides": [],
							"notes": ""
						},
						{
							"id": "M215",
							"text": "There are a lot of information and tools in your interface. We'll get through every one of them over time. But you might want to explore them on your own.",
							"overrides": [],
							"highlight": {},
							"notes": ""
						},
						{
							"id": "M216",
							"text": "You can always press [UseFloatingCursor] to summon a cursor on the screen, and move it on whatever you don't understand with [CameraZoom_Gamepad] to get an explanation.",
							"overrides": [],
							"highlight": {},
							"notes": ""
						}
					],
					"speakers": [
						{
							"character": "ShadoutMapes"
						}
					],
					"flags": 0,
					"props": {
						"position": 2
					},
					"trigger": {},
					"hlcomment": ""
				},
				{
					"id": "M1_03_ChangeSpeed",
					"title": "Speed up",
					"mainText": "",
					"popupPages": [
						{
							"id": "M211",
							"text": "There are 2 ways to change the speed of the game.",
							"highlight": {},
							"overrides": [],
							"notes": ""
						},
						{
							"id": "M212",
							"text": "1. You can press [Time_Faster] to increase the speed and [Time_Slower] to decrease it.",
							"highlight": {},
							"overrides": [],
							"notes": ""
						},
						{
							"id": "M213",
							"text": "2. There is a speed button on the right of the top bar.\n\n- [MouseLeft] left-click it to increase the speed.\n- [MouseRight] right-click it to decrease the speed.",
							"highlight": {
								"topBarState": 4
							},
							"overrides": [],
							"notes": ""
						}
					],
					"trigger": {},
					"flags": 0,
					"props": {
						"position": 2
					},
					"hlcomment": "",
					"speakers": [
						{
							"character": "ShadoutMapes"
						}
					]
				},
				{
					"id": "M1_03_DoChangeSpeed",
					"title": "Speed up",
					"mainText": "",
					"popupPages": [
						{
							"id": "M214",
							"text": "Increase the speed of the game up to X2.",
							"highlight": {
								"topBarState": 4
							},
							"overrides": [],
							"notes": ""
						},
						{
							"id": "M215",
							"text": "Remember, to change the speed:\n1. You can press [Time_Faster] to increase the speed and [Time_Slower] to decrease it.\n2. There is a speed button on the right of the top bar:\n- [MouseLeft] left-click it to increase the speed.\n- [MouseRight] right-click it to decrease the speed.",
							"highlight": {
								"topBarState": 4
							},
							"overrides": [],
							"notes": ""
						}
					],
					"trigger": {},
					"flags": 5,
					"props": {
						"position": 2
					},
					"hlcomment": "",
					"speakers": [
						{
							"character": "ShadoutMapes"
						}
					]
				},
				{
					"id": "M1_03_ChangeSpeedDown",
					"title": "Speed down",
					"mainText": "",
					"popupPages": [
						{
							"id": "M214",
							"text": "And now go back to the regular speed.",
							"highlight": {
								"topBarState": 4
							},
							"overrides": [],
							"notes": ""
						}
					],
					"trigger": {},
					"flags": 5,
					"props": {
						"position": 2
					},
					"hlcomment": "",
					"speakers": [
						{
							"character": "ShadoutMapes"
						}
					]
				},
				{
					"id": "M1_03_End",
					"title": "",
					"mainText": "",
					"popupPages": [
						{
							"id": "M211",
							"text": "That's it, Noble Born.\n\nToday you have learned how to control the camera, give orders to units and control the flow of time.",
							"highlight": {},
							"overrides": [],
							"notes": ""
						},
						{
							"id": "M212",
							"text": "You're no longer a child, but you still have much to learn.\n\nTomorrow, I will teach you how to explore the vast expanse of Arrakis, with your [Ornithopter]s.",
							"highlight": {},
							"overrides": [],
							"notes": ""
						}
					],
					"trigger": {},
					"flags": 0,
					"props": {
						"position": 2,
						"closingText": "End"
					},
					"hlcomment": "",
					"speakers": [
						{
							"character": "ShadoutMapes"
						}
					]
				},
				{
					"id": "M2_01",
					"title": "Combat and Siege",
					"mainText": "",
					"popupPages": [
						{
							"id": "M211",
							"text": "You claim to reign on Arrakis, Noble Born, but the [!Village]s of the Graben, Sink, and Pan shun you.\n\nYou have to impose your rights on them.",
							"highlight": {},
							"overrides": [],
							"notes": ""
						},
						{
							"id": "M212",
							"text": "Today, we'll learn how to capture and defend [!Village]s. First, you will recruit an army.",
							"highlight": {},
							"overrides": [],
							"notes": ""
						}
					],
					"trigger": {},
					"props": {
						"position": 2
					},
					"flags": 0,
					"hlcomment": "",
					"speakers": [
						{
							"character": "ShadoutMapes"
						}
					]
				},
				{
					"id": "M2_01_TryRecruting",
