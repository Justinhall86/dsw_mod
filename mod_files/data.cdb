				{
					"id": "M2_03_RecruitMilitia",
					"title": "Prepare your Defense",
					"mainText": "",
					"popupPages": [
						{
							"id": "M203_1",
							"text": "Your new [!Village] will attract jealousy. Word gets out that [!Harkonnen-adjective] swines are already planning an attack. You need to prepare your defenses.",
							"highlight": {},
							"overrides": [],
							"notes": ""
						},
						{
							"id": "M203_2",
							"text": "Trained locals from your [!Village] can help repel invaders.\n\nSelect your [!Village] and recruit as many militia as you can.",
							"highlight": {
								"entities": {
									"match": [
										{
											"alignment": 2,
											"filter": 1,
											"structure": "Village"
										}
									]
								},
								"ui": {
									"match": [
										{
											"id": "addBtn"
										}
									]
								}
							},
							"overrides": [],
							"padText": "Trained locals from your [!Village] can help repel invaders.\n\nSelect your [!Village] and recruit as many militia as you can by pressing [Structure_AddMilitia].",
							"notes": ""
						}
					],
					"trigger": {},
					"flags": 4,
					"props": {
						"position": 2
					},
					"speakers": [
						{
							"character": "ShadoutMapes"
						}
					]
				},
				{
					"id": "M2_03_HealUnits",
					"title": "Prepare your Defense",
					"mainText": "",
					"popupPages": [
						{
							"id": "M203_1",
							"text": "You also need to take care of your wounded units.\n\nOutside of combat, every unit heals automatically near [!Village]s and Main Bases at the cost of [Manpower].",
							"highlight": {},
							"overrides": [],
							"notes": ""
						}
					],
					"trigger": {},
					"flags": 0,
					"props": {
						"position": 2
					},
