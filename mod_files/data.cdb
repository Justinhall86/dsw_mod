					"opt": true,
					"kind": null,
					"documentation": "For non-neutral outposts"
				},
				{
					"typeStr": "4",
					"name": "unlockDelay",
					"opt": true,
					"documentation": "Days after creation when the structure becomes unlocked for everyone, (hidden like PoIs before that)"
				},
				{
					"typeStr": "8",
					"name": "attackCombos",
					"opt": true,
					"kind": null
				},
				{
					"typeStr": "3",
					"name": "reconPriority",
					"opt": true,
					"documentation": "We sort in Ascending Order. Lower number means higher Prio. This is to avoid having to renumber everything if a new element comes in.\n\nIf a structure has no reconPriority, it uses 1000000"
				},
				{
					"typeStr": "8",
					"name": "spawnRotation",
					"opt": true,
					"documentation": "Need exactly 2 values. Min and Max rotation for a Random one to be found between these 2 values"
