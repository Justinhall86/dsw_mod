			"lines": [
				{
					"id": "Default",
					"texts": {
						"name": "Skirmish",
						"menuButton": "Skirmish",
						"desc": "A medium game with up to four factions, battling and scheming for the control of the northern hemisphere of Arrakis."
					},
					"gfx": {
						"file": "UI/icons/icon_mode_jeu.png",
						"size": 74,
						"x": 0,
						"y": 0
					},
					"props": {
						"baseFactionXp": 100,
						"shortGameDays": 30
					},
					"flags": 0,
					"comment": ""
				},
				{
					"id": "Conquest",
					"texts": {
						"name": "Conquest",
						"menuButton": "New Game",
						"desc": "A long-lasting campaign on the nothern hemisphere of Arrakis. Will your House survive the Spice Wars and come out victorious? Or will you perish, and be forgotten?"
					},
					"gfx": {
						"file": "UI/icons/icon_mode_jeu.png",
						"size": 74,
						"x": 2,
						"y": 0
					},
					"props": {
						"playableFactions": [
							{
								"ref": "Atreides",
								"availableForAI": true
							},
							{
								"ref": "Harkonnen",
