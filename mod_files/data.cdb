					"title": "Use Safe Mode",
					"mainText": "",
					"popupPages": [
						{
							"id": "M212",
							"text": "The [A_Harvester] has been working for a while, a [Sandworm] will come soon.\n\nShow me that you know how to toggle between [!Safe_Harvester] and [!Greedy_Harvester].",
							"overrides": [],
							"highlight": {},
							"notes": ""
						},
						{
							"id": "M213",
							"text": "To put your [A_Harvester] in a specific mode, you have to select it and [MouseLeft] click on the corresponding button.",
							"highlight": {},
							"overrides": [],
							"padText": "To put your [A_Harvester] in a specific mode, you have to select it. Then, press [Selection_SafeMode] to put it in [!Safe_Harvester] or [Selection_GreedMode] to put it in [!Greedy_Harvester].",
							"notes": ""
