					"mainText": "",
					"popupPages": [
						{
							"id": "M212",
							"text": "Recruiting an army is done from the Military interface on the right side of the screen. Recruit one [!A_Trooper] and one [!A_Soldier].",
							"highlight": {
								"rightBar": 2048
							},
							"overrides": [],
