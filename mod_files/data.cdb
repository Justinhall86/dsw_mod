					"props": {}
				},
				{
					"id": "PlayerOrniInTerritory",
					"options": [],
					"conditionsComment": "Ornithopter joueur chez IA\r",
					"scoreComment": "1 par Orni",
					"regularScore": 1,
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "I tolerate scouts, but I also value respect. I recommend that you closely watch your step."
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": "I shall remind you that on this land of mine, it is only by pure goodness of heart that I tolerate the tiresome presence of your scouts."
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": "Explore as you like, I welcome you! I've already examined every bit of your territory, so you might as well visit mine."
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": "Act mindfully. We are used to witnessing the comings and goings of strangers on our land, but make one false move and you might never learn what happened to your scouts."
								}
							]
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "I noticed your Ornithopters below my station. But I will swat them like flies if they pester me."
								}
							]
						}
					],
					"conditions": {
						"orniInTerritory": true
					},
					"implemented": true,
					"props": {},
					"weight": 1
				},
				{
					"id": "OrniInPlayerTerritory",
					"options": [],
					"conditionsComment": "Ornithopter IA chez joueur\r",
					"scoreComment": "1 par Orni",
					"regularScore": 1,
					"conditions": {
						"ownedOrniInTerritory": true
					},
					"implemented": true,
					"props": {}
				},
				{
					"id": "PoIResolution",
					"options": [],
					"conditionsComment": "Résolution d'un POI en territoire IA",
					"scoreComment": "20",
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "My land is not public and these spoils were not yours to take! Consider yourself our debtor."
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": "As much as I enjoy watching you pick up the litter on my ground... steal from me again and I will crush you. Surely, you have more than enough garbage at home?"
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": "You should know that we are well informed and control all riches within our territory. Plunder all you want, but by stealth or by force, I'll reclaim my part."
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": "Stranger! You may have gotten used to appropriating land, but this one is ours. We are entitled to what is uprooted here, and we will not tolerate theft."
								}
							]
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "You dare take what's mine? I am your lord and emperor! This planet is mine! YOU are mine!"
								}
							]
						}
					],
					"implemented": false,
					"props": {},
					"weight": 1
				},
				{
					"id": "SietchTrade",
					"options": [],
					"conditionsComment": "Le joueur trade avec un Sietch dans une zone adjacente scoutée ou chez une autre faction ",
					"scoreComment": "10",
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "You seem familiar with the local traders. Surely, you can gain their trust and show that you mean no harm. But don't you, really?"
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": "It seems only natural for you to trade fraternally with these troglodytes. Yet, I cannot help worrying when I seem to be surrounded by lowbrow savages."
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": "My contacts informed me that you established a trading connection with the Sietch. As a prominent partner of theirs, I welcome you. The more the merrier!"
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": "Kuhar! This is good. The more you come into contact with the Fremen, the closer you might get to actually understanding the land you try to take root in."
								}
							]
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "Are you trading with these... savages? I wonder what wares they could have of any value."
								}
							]
						}
					],
					"implemented": false,
					"props": {},
					"weight": 2
				},
				{
					"id": "SietchAttack",
					"options": [],
					"conditionsComment": "Attaque sur un Sietch dans une zone adjacente scoutée ou chez une autre faction ",
					"scoreComment": "50",
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "How stupidly brutal! Keep an eye out if you start attacking sietches at random: barbarian clans never last long."
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": "I gather that you are taking care of removing those Fremen parasites from their caves... Be assured that I very much appreciate watching rivals handle the drudgery."
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": "Are you stupid? The Sietch is an economical midpoint. By plundering it, you'll impoverish everyone, you included. And I won't allow that!"
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": "Enough! Menacing the salt of this land, when you are but a frail parasite sprawling on its surface... You are making yourself vulnerable by attacking the Fremen!"
								}
							]
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "These cave dwellers are inconsequential. Do what you must."
								}
							]
						}
					],
					"implemented": false,
					"props": {},
					"weight": 2
				},
				{
					"id": "AIMoreSpiceProduction",
					"options": [],
					"conditionsComment": "Spice gathering IA supérieur à double",
					"scoreComment": "facteur\r",
					"regularScore": 2,
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "As much as I enjoy superiority, I advise you to step up your spice output. Else, your presence here will seem unneeded."
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": "Isn't it admirable that we can work together so efficiently? Me, in charge of the spice and its benefits... and you, inventively using your deficiency to highlight my strength... Brilliant."
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": "I understand it's frustrating to be outplayed in the run for spice. But the good news is: I would gladly sell our surplus to you for a reasonable price."
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": "We are different, stranger. Where you see a rival outperforming your spice production, I only see the harmonious balance of the living system I participate in."
								}
							]
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "You are supposed to exploit Spice in my name. And yet I harvest more than you do. How disappointing."
								}
							]
						}
					],
					"conditions": {
						"spiceProductionAbove": 2
					},
					"implemented": true,
					"props": {},
					"weight": 2
				},
				{
					"id": "AILessSpiceProduction",
					"options": [],
					"conditionsComment": "Spice gathering IA inférieur à moitié",
					"scoreComment": "facteur inversé",
					"regularScore": 2,
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "Seeing spice flow is enjoyable. But I would enjoy it much more if it was mine."
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": "How injudicious of you to exhibit such obscene prosperity! To parade, flaunting abundant spice... while it takes us so much effort to look humble."
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": "Indeed, you extract more spice than I do. But there's more to the spice business than harvesting. Who conditions, transports, smuggles and sells it is the most important question."
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": "Spice... nothing but spice. You are hoarding it, and still you completely ignore the natural structure it belongs to. How can you be so comfortable with your own unawareness?"
								}
							]
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "It brings me joy to see you so diligent in your Spice harvesting operations. You are a valued vassal of mine!"
								}
							]
						}
					],
					"conditions": {
						"spiceProductionBelow": 0.5
					},
					"implemented": true,
					"props": {},
					"weight": 2
				},
				{
					"id": "InsufficientSpiceImperilTax",
					"options": [],
					"conditionsComment": "Stocks inférieur à l'estimation de paiement",
					"scoreComment": "5 divisé par le nombre de faction IA à toutes les factions ",
					"regularScore": 5,
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "As it seems, you're not prepared to pay the tax. Just remember that a position on Arrakis is never free. Neither is it permanent."
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": "Your reserves are so low... Don't you intend to pay the tax? Or did no one inform me that struggling and underprivileged factions were granted a rebate now?"
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": "Pardon the indiscretion, but you seem short on payment for the next tax. How can I help? You know you can always turn to me in hard times, right?"
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": "Never overlook these taxes. You may discover that the environmental climate of Arrakis is not nearly as perilous as its economical one."
								}
							]
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "I am a compassionate man. Forgiving. Merciful even. But the Spice that you owe me is a topic that gives rise to very different feelings in my heart."
								}
							]
						}
					],
					"conditions": {
						"cannotMeetImperialTax": 10
					},
					"implemented": true,
					"props": {},
					"weight": 2
				},
				{
					"id": "SpiceOverflow",
					"options": [],
					"conditionsComment": "Enorme stock d'épice",
					"scoreComment": "X, facteur multiplicatif par rapport Tax",
					"regularScore": 1,
					"conditions": {
						"spiceOverstock": 1.5
					},
					"implemented": true,
					"props": {}
				},
				{
					"id": "ImperialTaxNotPaid",
					"options": [],
					"scoreComment": "100 à la faction ayant le plus gros score",
					"conditionsComment": "Taxe impériale non payée",
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "I was able to pay the tax in spite of faulty equipment and constant sabotage. What could your excuse be?"
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": "I truly am obliged, my dear cousin. With every payment you miss, I appear increasingly reliable in the eyes of Emperor Padishah... while you steadily become less of a concern."
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": "This is unfair! A powerful House, unable to break even and afford its imperial tax... Surely, a tighter network of smugglers on your territory would benefit you."
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": "Must I remind you of your obligations towards the Imperium? Your only claim to legitimacy on Arrakis depends on Emperor Padishah's interest in you."
								}
							]
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "This... is not acceptable. You know that every Spice shipment is vital to the Empire. Every speck counts. Your failure will not be forgotten or forgiven."
								}
							]
						}
					],
					"implemented": true,
					"eventConditions": [
						{
							"ref": "ImperialTaxNotPaid",
							"duration": 10,
							"conditions": {
								"instigator": 1
							},
							"score": 100
						}
					],
					"props": {},
					"weight": 3
				},
				{
					"id": "FremenBribeNotPaid",
					"props": {},
					"options": [],
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "Do you really wish to upset the guild? I would advise against that. And you should know better."
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": "I can only imagine how hard it must be... being expected to pay this bribe when you obviously lack the civilized technology and manpower to exploit the spice. How pitiful!"
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": "You may think the Guild is practicing extortion, and you may be right, but what other choice do you have? Not paying could prove even more expensive than the tax."
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": ""
								}
							]
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "I thought your agreement with the Spacing Guild was important to you and yet you fail to pay them. Though I cannot say I am displeased by this turn of event..."
								}
							]
						}
					],
					"weight": 3,
					"scoreComment": "100 à la faction ayant le plus gros score",
					"eventConditions": [
						{
							"ref": "ImperialTaxNotPaid",
							"duration": 10,
							"conditions": {
								"instigator": 1
							},
							"score": 100
						}
					],
					"conditionsComment": "Taxe impériale non payée",
					"implemented": false
				},
				{
					"id": "SmugglerBribeNotPaid",
					"props": {},
					"options": [],
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "Smugglers, short on resources? This is unheard of. What kind of trick are you playing on us?"
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": "My poor friend, could you be so bankrupt you cannot even pay what you owe? Was there anything wrong with the riches you stole from us lately?"
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": ""
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": "Utterly worrying. Smugglers rely on money more than they rely on water to live. What kind of imbalance could have made you unable to pay the bribe?"
								}
							]
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "I am merely tolerating you. Miss another payment and you will feel the wrath of my Sardaukar!"
								}
							]
						}
					],
					"weight": 3,
					"scoreComment": "100 à la faction ayant le plus gros score",
					"eventConditions": [
						{
							"ref": "ImperialTaxNotPaid",
							"duration": 10,
							"conditions": {
								"instigator": 1
							},
							"score": 100
						}
					],
					"conditionsComment": "Taxe impériale non payée",
					"implemented": false
				},
				{
					"id": "WaterDeficit",
					"options": [],
					"conditionsComment": "Deficit Water joueur",
					"scoreComment": "1 par deficit\r",
					"regularScore": 5,
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "Growth is always limited by the rarest necessary resource. Water is key here. Never overlook it."
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": "I understand the logic... Why bother with this drudging, mundane water when you can focus on what's important and let your workforce die? In truth, it seems only natural."
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": "I know how tempting it is to neglect water when there's so much spice to harvest here! But to mine spice, you need workers, and workers need to drink."
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": "Predictable. Where did you expect your propensity to waste water would lead you? And what do you think happens to organisms incapable of adaptation?"
								}
							]
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "It's never easy to understand a new planet. But you might have guessed that water would be important. Here of all places."
								}
							]
						}
					],
					"conditions": {
						"waterDeficit": 0
					},
					"implemented": true,
					"props": {},
					"weight": 3
				},
				{
					"id": "SolariDeficit",
					"options": [],
					"conditionsComment": "Deficit Solari joueur",
					"scoreComment": "1 par 10 flux négatif\r",
					"regularScore": 5,
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "There is no such thing as a poor empire. You need money. Else, you are finished."
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": "There is nothing more conveniently profitable in this world than an indigent neighbor. May you never change, my dear comrade!"
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": "Low finances aren't necessarily a bad sign on Arrakis. If you have some water, some spice and a good connection to smugglers, you can consider yourself rich."
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": "Arrakis. A miraculous land where the most valuable substance in nature impregnates air and soil alike. You breathe this air and you tread this soil. How can you be poor?"
								}
							]
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "How you can manage without the most basic understanding of economics truly baffles me."
								}
							]
						}
					],
					"conditions": {
						"solariDeficit": 0
					},
					"implemented": true,
					"props": {},
					"weight": 3
				},
				{
					"id": "FuelCellDeficit",
					"options": [],
					"conditionsComment": "Deficit Fuel Cell joueur",
					"scoreComment": "1 par deficit\r",
					"regularScore": 5,
					"conditions": {
						"fuelCellDeficit": 0
					},
					"implemented": true,
					"props": {}
				},
				{
					"id": "ManpowerDeficit",
					"options": [],
					"conditionsComment": "Deficit Manpower joueur",
					"scoreComment": "1 par 5 flux négatif",
					"regularScore": 5,
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "Your workforce is looking weaker everyday. I understand that life is costly here, but there is nothing you can build without hands."
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": "With no one left to work for you, will you soon be carrying equipment around by yourself? I shall enjoy this sight, but still, isn't it concerning?"
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": "As it seems, you're struggling to gather a workforce? Let me share my secret with you: deference comes with abundance. If you provide, they'll follow."
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": "Stranger... You seem to wonder why the workforce is so scarce here. It is not. You may assume Arrakis is depopulated, but you are only contemplating your mismanaged territory."
								}
							]
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "Even the pyons of Arrakis are my people. You should take better care of them."
								}
							]
						}
					],
					"conditions": {
						"manpowerDeficit": 0
					},
					"implemented": true,
					"props": {},
					"weight": 3
				},
				{
					"id": "AIAdjacentPlayerArmies",
					"options": [],
					"conditionsComment": "Armée joueur située dans zone adjacente scoutée\r",
					"scoreComment": "1 par unité\r",
					"regularScore": 2,
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "Your troops were seen wandering around my border. Can I be of any help? Or is there something to understand here?"
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": "What are these farcical troops of yours doing at my border? Is this a laughable attempt at intimidation?"
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": "Preparing an assault, huh? Let me be blunt: I'm like bedrock here. Should I decide to let you down, you'd crumble instantly."
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": "Withdraw these troops! I understand that you cannot envision life without expansion, but I guarantee that a conflict with the Fremen would not benefit you."
								}
							]
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "I wonder what your armies... sorry, MY armies are doing here."
								}
							]
						}
					],
					"conditions": {
						"adjacentArmies": 3,
						"atWar": false
					},
					"implemented": true,
					"props": {},
					"weight": 5
				},
				{
					"id": "PlayerArmyInVillageZone",
					"options": [],
					"conditionsComment": "Armée joueur dans une zone avec au moins un village controlé par l'enemie\r",
					"scoreComment": "2 par unité\r",
					"regularScore": 2,
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "There is no room for interpretation at this point. Your soldiers are trespassing. Withdraw immediately or be prepared for war."
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": "Your debilitated soldiers have strayed into my territory. I will benevolently put an end to their misery... and come for the rest of your sorry regiments next."
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": "Oh! You're attacking? Maybe once you've discovered how dependent you are on me, you'll come to reason. But my forgiveness will cost you."
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": "Be reassured. We will slay your soldiers, but their water will be preserved. Following a perfect cycle, it will give strength to my troops as they invade you in retaliation."
								}
							]
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "Get your troops away from my holdings. You do not want to feel my wrath."
								}
							]
						}
					],
					"conditions": {
						"villageZoneArmies": 3
					},
					"implemented": true,
					"props": {},
					"weight": 5
				},
				{
					"id": "AIArmyAdjacentPlayerTerritory",
					"options": [],
					"conditionsComment": "Armée IA située dans zone adjacente scoutée\r",
					"scoreComment": "1 par unité\r",
					"regularScore": 1,
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "You look troubled. As the neighbor of a great House, you should expect to witness some military power."
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": "Do not mind my troops, routinely marching in great numbers… Of course, they are moving towards your border, but you should not let this amusing coincidence bother you."
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": "These troops? They're simply protecting our border! My prudence is benefiting both of us, actually... a less generous neighbor might even charge you for this!"
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": "Let it be known: when Fremen want to move undetected, they do. If you can see us, it is already too late to worry."
								}
							]
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "Don't trouble yourself with my armies. After all this planet is mine to use as I see fit."
								}
							]
						}
					],
					"conditions": {
						"adjacentOwnedArmies": 3
					},
					"implemented": true,
					"props": {},
					"weight": 2
				},
				{
					"id": "AIArmyInPlayerVillageZone",
					"options": [],
					"conditionsComment": "Armée IA dans une zone avec au moins un village controlé par le joueur\r",
					"scoreComment": "2 par unité\r",
					"regularScore": 3,
					"conditions": {
						"villageZoneOwnedArmies": 3
					},
					"implemented": true,
					"props": {}
				},
				{
					"id": "PlayerLessArmies",
					"options": [],
					"conditionsComment": "IA beaucoup plus de troupes > 2\r",
					"scoreComment": "1 par diff au dessus de 2\r",
					"regularScore": 1,
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "Where there is weakness, there is no peace. Right now, you are begging for an invasion."
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": "Pardon me, but is there any reason why you are not defending your territory at all? Of course, I can see how beneficial an invasion would be for your people..."
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": "Of course! The more prosperous you get, the stronger you must be to protect what you have. It's only natural that you don't need as many troops as I do."
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": "Do not resent my military prevalence. It only relies on one fundamental law of nature: a system expands when its energy is recycled, and shrinks when its energy is wasted."
								}
							]
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "If you hope to operate on Arrakis I would strongly suggest you raise at least a hint of an army."
								}
							]
						}
					],
					"conditions": {
						"lessArmies": 3
					},
					"implemented": true,
					"props": {},
					"weight": 1
				},
				{
					"id": "PlayerMoreArmies",
					"options": [],
					"conditionsComment": "Joueur beaucoup plus de troupes > 2",
					"scoreComment": "1 par diff au dessus de 2",
					"regularScore": 1,
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "Why dedicate so much resources to military expenses? Our purpose here is exploitation. Your excesses will drain your benefits."
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": "I take notice that you have lined up quite an army there... We might soon discover if it is possible for the [Sandworm] to over-eat."
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": "Impressive military, but what's it for, exactly? Surely, you wouldn't have any aggressive velleity against me when I am so useful to you?"
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": "Ludicrous. Can you even fathom the quantity of wasted water this profligate army of yours represents? You do not seem to realize what matters most, here on Arrakis."
								}
							]
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "I find your accumulation of forces on my planet ever so slightly unsettling. What are you hoping to gain? Certainly not my respect."
								}
							]
						}
					],
					"conditions": {
						"moreArmies": 3
					},
					"implemented": true,
					"props": {},
					"weight": 1
				},
				{
					"id": "PlayerSpiceCollectorEaten",
					"props": {},
					"options": [],
					"name": "",
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "The loss of workforce in the line of duty is revolting. I feel for you, but I shall also remind you that we are responsible for our workers' lives."
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": "What a sight! Your whole little campsite and its stupid inhabitants, gobbled by the worm... You really are an entertainer."
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": "The loss of your collecting party will be a major setback, but be reassured! I'll work twice as hard to provide your usual clients with spice while your production is hindered."
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": []
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "I thought your people knew this place..."
								}
							]
						}
					],
					"weight": 2,
					"conditionsComment": "Le joueur Fremen se fait manger un Spice Collector dans une zone scoutée\n",
					"eventConditions": [
