				{
					"id": "M4_02_HarvesterModes",
					"title": "Harvester Modes",
					"mainText": "",
					"popupPages": [
						{
							"id": "M213",
							"text": "There are two ways to operate [A_Harvester]s: [!Greedy_Harvester] and [!Safe_Harvester].",
							"highlight": {},
							"overrides": [],
							"notes": ""
						},
						{
							"id": "M214",
							"text": "In [!Greedy_Harvester], [A_Harvester]s remain on the field until the last seconds before the [Sandworm] surfaces.",
							"overrides": [],
							"highlight": {},
							"notes": ""
						},
						{
							"id": "M216",
							"text": "They gather a lot of [Spice] that way, but incur high risk of losing [A_Harvester] and [CrewPoint]s.",
							"overrides": [],
							"highlight": {},
							"notes": ""
						},
						{
							"id": "M215",
							"text": "In [!Safe_Harvester], [A_Harvester]s are recalled as soon as a worm is detected, ensuring a safe return.",
							"overrides": [],
							"highlight": {},
							"notes": ""
						}
					],
					"speakers": [
						{
							"character": "ShadoutMapes"
						}
					],
					"flags": 0,
					"props": {
						"position": 2
					},
					"trigger": {},
					"hlcomment": "Changed"
				},
				{
					"id": "M4_02_Ornithopters",
