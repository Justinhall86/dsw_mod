				{
					"id": "Incursion_Start",
					"speechesPerSpeaker": [
						{
							"character": "Piter",
							"pool": [
								{
									"variationIndex": 0,
									"target": 2,
									"speeches": [
										{
											"text": "Attacking brutally, suddenly, mercilessly – isn't that House Harkonnen's specialty? Baron, this opportunity was made for you! Your rival's reinforcements are a long way off. You need only reach out and snatch this territory from your enemy.",
											"match": {
												"gender": 0
											},
											"sfx": "Voice_Conquest_H_Incursion_Piter_1_0",
											"translation_notes": "Speaker is Piter de vries\nterritory is a game term\nhere \"the rival\" is masculine",
											"voice_notes": "Tone: eager"
										},
										{
											"text": "Attacking brutally, suddenly, mercilessly – isn't that House Harkonnen's specialty? Baron, this opportunity was made for you! Your rival's reinforcements are a long way off. You need only reach out and snatch this territory from your enemy.",
											"match": {
												"gender": 1
											},
											"sfx": "Voice_Conquest_H_Incursion_Piter_1f_0",
											"translation_notes": "Speaker is Piter de vries\nterritory is a game term\nhere \"the rival\" is feminine",
											"voice_notes": "Tone: eager"
										}
									]
								}
							]
						},
						{
							"character": "Sanya",
							"pool": [
								{
									"variationIndex": 0,
									"target": 0,
									"speeches": [
										{
											"text": "An exposed territory, a distracted enemy army… What a thoughtful gift for House Ecaz. All you have to do is accept it.",
											"match": {},
											"sfx": "Voice_Conquest_E_Incursion_Sanya_1_0",
											"translation_notes": "Speaker is Sanya Ecaz\nterritory is a game term",
											"voice_notes": "Tone: smiling, despising toward this enemy."
										}
									]
								}
							]
						},
						{
							"character": "Thufir",
							"pool": [
								{
									"variationIndex": 0,
									"target": 2,
									"speeches": [
										{
											"text": "The enemy has neglected this territory. He's already led his army elsewhere, leaving but a paltry defense behind. I advise you to attack this position without delay – your rival won't have time to react.",
											"match": {
												"gender": 0
											},
											"sfx": "Voice_Conquest_A_Incursion_Thufir_1_0",
											"translation_notes": "Speaker is Thufir Hawat\nterritory is a game term\nhere \"the enemy\" is masculine",
											"voice_notes": "Tone: serious, determined"
										},
										{
											"text": "The enemy has neglected this territory. She's already led her army elsewhere, leaving but a paltry defense behind. I advise you to attack this position without delay – your rival won't have time to react.",
											"match": {
												"gender": 1
											},
											"sfx": "Voice_Conquest_A_Incursion_Thufir_1f_0",
											"translation_notes": "Speaker is Thufir Hawat\nterritory is a game term\nhere \"the enemy\" is feminine",
											"voice_notes": "Tone: serious, determined"
										}
									]
								}
							]
						},
						{
							"character": "Fenring",
							"pool": [
								{
									"variationIndex": 0,
									"target": 2,
									"speeches": [
										{
											"text": "Our scouts have spotted troop movements. The enemy is focused on a territory far away from this one.\nMajesty, it's the perfect time to strike. We must act fast and take your opponent's base before he has time to recall his men.",
											"match": {
												"gender": 0
											},
											"sfx": "Voice_Conquest_C_Incursion_Hasimir_1_0",
											"translation_notes": "Speaker is Hasimir Fenring\nterritory is a game term\nbase is a game term (main base)\nFenring specifically says \"Majesty\", and not \"your majesty\"\nhere \"the enemy\" is masculine",
											"voice_notes": "Tone: factual, formal, calm"
										},
										{
											"text": "Our scouts have spotted troop movements. The enemy is focused on a territory far away from this one.\nMajesty, it's the perfect time to strike. We must act fast and take your opponent's base before she has time to recall her men.",
											"match": {
												"gender": 1
											},
											"sfx": "Voice_Conquest_C_Incursion_Hasimir_1f_0",
											"translation_notes": "Speaker is Hasimir Fenring\nterritory is a game term\nbase is a game term (main base)\nFenring specifically says \"Majesty\", and not \"your majesty\"\nhere \"the enemy\" is feminine",
											"voice_notes": "Tone: factual, formal, calm"
										}
									]
								}
							]
						},
						{
							"character": "Tessia",
							"pool": [
								{
									"variationIndex": 0,
									"target": 2,
									"speeches": [
										{
											"text": "Your rival believes that his grip on this territory is unshakable, but he obviously underestimates our House. Let’s show him that against Ixian technology, all of his victories are merely temporary.",
											"match": {
												"gender": 0
											},
											"translation_notes": "Speaker is Tessia Vernius",
											"voice_notes": "Tone: calm, confident",
											"sfx": "Voice_Conquest_V_Incursion_Tessia_1_0"
										},
										{
											"text": "Your rival believes that her grip on this territory is unshakable, but she obviously underestimates our House. Let’s show her that against Ixian technology, all of her victories are merely temporary.",
											"match": {
												"gender": 1
											},
											"translation_notes": "Speaker is Tessia Vernius",
											"voice_notes": "Tone: calm, confident",
											"sfx": "Voice_Conquest_V_Incursion_Tessia_1f_0"
										}
									]
								}
							]
						},
						{
							"character": "Staban",
							"pool": [
								{
									"variationIndex": 0,
									"target": 2,
									"speeches": [
										{
											"text": "Our merchants have returned from the villages. Much to their surprise, they didn't encounter a single enemy patrol.\nYour rival is neglecting this territory's defenses - perhaps his troops are busy conquering some other part of the desert. We should send in our men to strike his base! A lightning attack will rob him of his reinforcements!",
											"match": {
												"gender": 0
											},
											"translation_notes": "Speaker is Staban\n\n\"your rival\" is masculine",
											"voice_notes": "Tone: calm, serious, then determined and fierce (impulsive) on the last two sentences",
											"sfx": "Voice_Conquest_S_Incursion_Staban_1_0"
										},
										{
											"text": "Our merchants have returned from the villages. Much to their surprise, they didn't encounter a single enemy patrol.\nYour rival is neglecting this territory's defenses - perhaps her troops are busy conquering some other part of the desert. We should send in our men to strike her base! A lightning attack will rob her of her reinforcements!",
											"match": {
												"gender": 1
											},
											"translation_notes": "Speaker is Staban\n\n\"your rival\" is feminine",
											"voice_notes": "Tone: calm, serious, then determined and fierce (impulsive) on the last two sentences",
											"sfx": "Voice_Conquest_S_Incursion_Staban_1f_0"
										}
									]
								}
							]
						},
						{
							"character": "Stilgar",
							"pool": [
								{
									"variationIndex": 0,
									"target": 0,
									"speeches": [
										{
											"text": "The men are ready to launch a raid on the offworlders' base. Ask your finest warrior to guide the Fremen to victory.",
											"match": {},
											"translation_notes": "Speaker is Stilgar",
											"voice_notes": "Tone: serious and calm, but we can feel that Stilgar will be not mercy for the outsiders",
											"sfx": "Voice_Conquest_F_Incursion_Stilgar_1_0"
										}
									]
								}
							]
						}
					],
					"from": 0,
					"props": {},
					"flags": 0
				},
				{
					"id": "HiredHelp_Start",
					"speechesPerSpeaker": [
						{
							"character": "Piter",
							"pool": [
								{
									"variationIndex": 0,
									"target": 2,
									"speeches": [
										{
											"text": "Who would look twice at a handful of men when a Harkonnen army is camped outside their door?\nYour rival won't expect a small detachment to attack his territory, having left it practically defenseless. You could so easily claim it…",
											"match": {
												"gender": 0
											},
											"sfx": "Voice_Conquest_H_Hiredhelp_Piter_1_0",
											"translation_notes": "Speaker is Piter de Vries\nterritory is a game term\nhere \"the rival\" is masculine",
											"voice_notes": "Tone: amused on the last sentence then formal, then eager or onctuous"
										},
										{
											"text": "Who would look twice at a handful of men when a Harkonnen army is camped outside their door?\nYour rival won't expect a small detachment to attack her territory, having left it practically defenseless. You could so easily claim it…",
											"match": {
												"gender": 1
											},
											"sfx": "Voice_Conquest_H_Hiredhelp_Piter_1f_0",
											"translation_notes": "Speaker is Piter de Vries\nterritory is a game term\nhere \"the rival\" is feminine",
											"voice_notes": "Tone: amused on the last sentence then formal, then eager or onctuous"
										}
									]
								}
							]
						},
						{
							"character": "Sanya",
							"pool": [
								{
									"variationIndex": 0,
									"target": 2,
									"speeches": [
										{
											"text": "This territory's defenses were created to stop an army, not a small contingent of soldiers. A small group of men could quietly capture this territory without drawing your rival's attention. By the time he finds out you seized his base, it'll be too late.",
											"match": {
												"gender": 0
											},
											"sfx": "Voice_Conquest_E_Hiredhelp_Sanya_1_0",
											"translation_notes": "Speaker is Sanya Ecaz\nterritory is a game term\nhere \"the rival\" is masculine",
											"voice_notes": "Tone: factual, determined. Smiling (cruel?) on the last sentence"
										},
										{
											"text": "This territory's defenses were created to stop an army, not a small contingent of soldiers. A small group of men could quietly capture this territory without drawing your rival's attention. By the time she finds out you seized her base, it'll be too late.",
											"match": {
												"gender": 1
											},
											"sfx": "Voice_Conquest_E_Hiredhelp_Sanya_1f_0",
											"translation_notes": "Speaker is Sanya Ecaz\nterritory is a game term\nhere \"the rival\" is feminine",
											"voice_notes": "Tone: factual, determined. Smiling (cruel?) on the last sentence"
										}
									]
								}
							]
						},
						{
							"character": "Thufir",
							"pool": [
								{
									"variationIndex": 0,
									"target": 2,
									"speeches": [
										{
											"text": "Your rival expects an army to attack this territory. A group of inconspicuous men would pass through his defenses without him noticing.\nIf necessary, the detachment could be supported by mercenaries. They've been spotted all over Arrakis since the Harkonnen decolonization.",
											"match": {
												"gender": 0
											},
											"sfx": "Voice_Conquest_A_Hiredhelp_Thufir_1_0",
											"translation_notes": "Speaker is Thufir Hawat\nmercenary is a game term\nhere \"the rival\" is masculine",
											"voice_notes": "Tone: factual, formal, determined"
										},
										{
											"text": "Your rival expects an army to attack this territory. A group of inconspicuous men would pass through her defenses without her noticing.\nIf necessary, the detachment could be supported by mercenaries. They've been spotted all over Arrakis since the Harkonnen decolonization.",
											"match": {
												"gender": 1
											},
											"sfx": "Voice_Conquest_A_Hiredhelp_Thufir_1f_0",
											"translation_notes": "Speaker is Thufir Hawat\nmercenary is a game term\nhere \"the rival\" is feminine",
											"voice_notes": "Tone: factual, formal, determined"
										}
									]
								}
							]
						},
						{
							"character": "Fenring",
							"pool": [
								{
									"variationIndex": 0,
									"target": 2,
									"speeches": [
										{
											"text": "Our spies have convinced the enemy he should expect a massive assault from you. Now all his attention will be on your troops' movements. This is the perfect time for a small detachment to sneak behind his lines and free the villages in this territory from his rule. We've also located mercenary camps, which could provide support without arousing suspicion.",
											"match": {
												"gender": 0
											},
											"sfx": "Voice_Conquest_C_Hiredhelp_Hasimir_1_0",
											"translation_notes": "Speaker is Hasimir Fenring\nmercenary is a game term\nhere \"the enemy\" is masculine",
											"voice_notes": "Tone: formal, calm, perfectly in control"
										},
										{
											"text": "Our spies have convinced the enemy she should expect a massive assault from you. Now all her attention will be on your troops' movements. This is the perfect time for a small detachment to sneak behind her lines and free the villages in this territory from her rule. We've also located mercenary camps, which could provide support without arousing suspicion.",
											"match": {
												"gender": 1
											},
											"sfx": "Voice_Conquest_C_Hiredhelp_Hasimir_1f_0",
											"translation_notes": "Speaker is Hasimir Fenring\nmercenary is a game term\nhere \"the enemy\" is feminine",
											"voice_notes": "Tone: formal, calm, perfectly in control"
										}
									]
								}
							]
						},
						{
							"character": "Tessia",
							"pool": [
								{
									"variationIndex": 0,
									"target": 2,
									"speeches": [
										{
											"text": "The analytic machines examining the enemy’s strategy have detected a flaw in his defenses. A small group of soldiers should be able to exploit it while his attention is elsewhere. With a handful of mercenaries, they could take your rival’s base before he can react.\nChoose your men carefully, my husband – they could be the key to our victory.",
											"match": {
												"gender": 0
											},
											"translation_notes": "Speaker is Tessia Vernius",
											"voice_notes": "Tone: calm, serious",
											"sfx": "Voice_Conquest_V_Hiredhelp_Tessia_1_0"
										},
										{
											"text": "The analytic machines examining the enemy’s strategy have detected a flaw in her defenses. A small group of soldiers should be able to exploit it while her attention is elsewhere. With a handful of mercenaries, they could take your rival’s base before she can react.\nChoose your men carefully, my husband – they could be the key to our victory.",
											"match": {
												"gender": 1
											},
											"translation_notes": "Speaker is Tessia Vernius",
											"voice_notes": "Tone: calm, serious",
											"sfx": "Voice_Conquest_V_Hiredhelp_Tessia_1f_0"
										}
									]
								}
							]
						},
						{
							"character": "Staban",
							"pool": [
								{
									"variationIndex": 0,
									"target": 2,
									"speeches": [
										{
											"text": "Your rival has only ever faced massive armies, so his defenses are adapted to large-scale battles. It's pathetic! What planet does he think he's on?\nWe must take advantage of his mistake and send a small group into this territory with orders to liberate the villages discreetly. They may even find backup amongst the folk of the pan and graben.",
											"match": {
												"gender": 0
											},
											"translation_notes": "Speaker is Staban\n\n\"Your rival\" is masculine",
											"voice_notes": "Tone: despising and calm at first, then upset (maybe jalous of their big army?), then determined trying to stay calm but a bit pressing",
											"sfx": "Voice_Conquest_S_Hiredhelp_Staban_1_0"
										},
										{
											"text": "Your rival has only ever faced massive armies, so her defenses are adapted to large-scale battles. It's pathetic! What planet does she think she's on?\nWe must take advantage of her mistake and send a small group into this territory with orders to liberate the villages discreetly. They may even find backup amongst the folk of the pan and graben.",
											"match": {
												"gender": 1
											},
											"translation_notes": "Speaker is Staban\n\"Your rival\" is feminine",
											"voice_notes": "Tone: despising and calm at first, then upset (maybe jalous of their big army?), then determined trying to stay calm but a bit pressing",
											"sfx": "Voice_Conquest_S_Hiredhelp_Staban_1f_0"
										}
									]
								}
							]
						},
						{
							"character": "Stilgar",
							"pool": [
								{
									"variationIndex": 0,
									"target": 2,
									"speeches": [
										{
											"text": "The enemy is misguided: he thinks he can fight on Dune the way he would on planets where water falls from the sky. Just look at his defenses, Liet! The offworlders expect to fight an army, so they won't notice a small group slipping in through the shadows. You can safely send in a few of our Fremen behind their lines. They will liberate the folk of the pan and graben before the offworlders even notice.",
											"match": {
												"gender": 0
											},
											"translation_notes": "Speaker is Stilgar\n\n\"The enemy\" is masculine",
											"voice_notes": "Tone: calm, cold but despising on \"Just Look at their defenses!\" Then planning, serious, cold",
											"sfx": "Voice_Conquest_F_Hiredhelp_Stilgar_1_0"
										},
										{
											"text": "The enemy is misguided: she thinks she can fight on Dune the way she would on one of those planets where water falls from the sky. Just look at her defenses, Liet! The offworlders expect to fight an army, so they won't notice a small group slipping in through the shadows. You can safely send in a few of our Fremen behind their lines. They will liberate the folk of the pan and graben before the offworlders even notice.",
											"match": {
												"gender": 1
											},
											"translation_notes": "Speaker is Stilgar\n\"The enemy\" is feminine",
											"voice_notes": "Tone: calm, cold but despising on \"Just Look at their defenses!\" Then planning, serious, cold",
											"sfx": "Voice_Conquest_F_Hiredhelp_Stilgar_1f_0"
										}
									]
								}
							]
						}
					],
					"from": 0,
					"props": {},
					"flags": 0
				},
				{
					"id": "HiredHelp_Attacked",
					"speechesPerSpeaker": [
						{
							"character": "Piter",
							"pool": [
								{
									"variationIndex": 0,
									"target": 0,
									"speeches": [
										{
											"text": "Well, well! Is this a secret sabotage mission I'm witnessing? How ridiculous to see a party as powerful as your own stooping to such indignities. Not to mention the insult to House Harkonnen! Do you think the good Baron is foolish enough to leave one of his territories unattended?",
											"match": {},
											"sfx": "Voice_Conquest_Neutral_Hiredhelp_Piter_1_0",
											"translation_notes": "Speaker is Piter de Vries\nterritory is a game term",
											"voice_notes": "Tone: amused, despising, taunting the player"
										}
									]
								}
							]
						},
						{
							"character": "Sanya",
							"pool": [
								{
									"variationIndex": 0,
									"target": 0,
									"speeches": [
										{
											"text": "My mother's bodyguard often says, <i>\"A victory without honor is no victory.\"</i> Luckily for you, I'll spare you the shame of conquering this territory through villainy.\nI hope those men weren't too important to you…",
											"match": {},
											"sfx": "Voice_Conquest_Neutral_Hiredhelp_Sanya_1_0",
											"translation_notes": "Speaker is Sanya Ecaz\nterritory is a game term\n\"A victory ... is no victory\" is a quote from Rivvy Dinari in the book \"Dune: House Harkonnen\"",
											"voice_notes": "Tone: despising, proud of herself"
										}
									]
								}
							]
						},
						{
							"character": "Thufir",
							"pool": [
								{
									"variationIndex": 0,
									"target": 0,
									"speeches": [
										{
											"text": "I recognize your treacherous methods. You thought to attack the Duke with a small detachment of men? How pathetic! Even for you. Lord Leto would never leave a territory wide open for you.",
											"match": {},
											"sfx": "Voice_Conquest_Neutral_Hiredhelp_Thufir_1_0",
											"translation_notes": "Speaker is Thufir Hawat\nthe duke and lord leto are book term (Duke Leto Atreides)",
											"voice_notes": "Tone: furious, despising"
										}
									]
								}
							]
						},
						{
							"character": "Fenring",
							"pool": [
								{
									"variationIndex": 0,
									"target": 1,
									"speeches": [
										{
											"text": "Sabotage… mm-m-m? Isn't that a bit… mm-m-m… unbecoming of a House as… hmm-m-m… decent as yours?\nThe Emperor will be somewhat… mm-m-m… displeased to see that you… hmm-m-m… underestimated him in this way. I hope the… Imperial welcoming committee gives you… ah-h-h… a preview of… hmm-m-m… the retaliation.",
											"match": {
												"house": 0
											},
											"sfx": "Voice_Conquest_Neutral_Hiredhelp_Hasimir_1_0",
											"translation_notes": "Speaker is Hasimir Fenring\nQuote from the book: \"Listening to the man gave Feyd-Rautha the feeling his head was being pushed through mush\".\nCount Fenring may use this strange sounds to annoy his opponent. In English there are translated this way :\n\"When you're mm-m-m ironic, that ah-h-h suggests you're hm-m-m-m thinking deep thoughts\"\n\"Um-m-m-m-m-ah-h-h-hm-m-m, you come upon such, mm-m-m, preciseness so\nrarely,\" the Count said, addressing the Baron's shoulder. \"I . . . ah,\ncongratulate you on the hm-m-m perfection of your ah-h-h heir. In the light of\nthe hm-m-m elder, one might say.\"\n\n",
											"voice_notes": "Quote from the book: \"Listening to the man gave Feyd-Rautha the feeling his head was being pushed through mush\".\nHe is clearly taunting the player with this way of talking"
										},
										{
											"text": "Sabotage… mm-m-m? Isn't that a bit… mm-m-m… unbecoming of a people as… hmm-m-m… brave as yours?\nThe Emperor will be somewhat… mm-m-m… displeased to see that you… hmm-m-m… underestimated him in this way. I hope the… Imperial welcoming committee gives you… ah-h-h… a preview of… hmm-m-m… the retaliation.",
											"match": {
												"house": 1
											},
											"translation_notes": "Speaker is Hasimir Fenring\nQuote from the book: \"Listening to the man gave Feyd-Rautha the feeling his head was being pushed through mush\".\nCount Fenring may use this strange sounds to annoy his opponent. In English there are translated this way :\n\"When you're mm-m-m ironic, that ah-h-h suggests you're hm-m-m-m thinking deep thoughts\"\n\"Um-m-m-m-m-ah-h-h-hm-m-m, you come upon such, mm-m-m, preciseness so\nrarely,\" the Count said, addressing the Baron's shoulder. \"I . . . ah,\ncongratulate you on the hm-m-m perfection of your ah-h-h heir. In the light of\nthe hm-m-m elder, one might say.\"\n\n",
											"sfx": "Voice_Conquest_Neutral_Hiredhelp_Hasimir_1_0",
											"voice_notes": "Quote from the book: \"Listening to the man gave Feyd-Rautha the feeling his head was being pushed through mush\".\nHe is clearly taunting the player with this way of talking"
										}
									]
								}
							]
						},
						{
							"character": "Tessia",
							"pool": [
								{
									"variationIndex": 0,
									"speeches": [
										{
											"text": "Did you think a small detachment of men could escape our machines’ surveillance? Your reluctance to use Ixian technology makes your House a poor adversary indeed.\nI hope you’ve learned a lesson here today…",
											"match": {},
											"translation_notes": "Speaker is Tessia Vernius",
											"voice_notes": "Tone: moking at first and then despising, even disgusted (her ennemy has underestimate her dear husband!)",
											"sfx": "Voice_Conquest_Neutral_Hiredhelp_Tessia_1_0"
										}
									],
									"target": 0
								}
							]
						}
					],
					"from": 1,
					"props": {},
					"flags": 0
				},
				{
					"id": "TheFortress_Start",
					"speechesPerSpeaker": [
						{
							"character": "Piter",
							"pool": [
								{
									"variationIndex": 0,
									"target": 0,
									"speeches": [
										{
											"text": "The Baron wanted to offer words of encouragement for the coming battle, and I would add my own. Attacking the greatest fortress in Arrakis, built by the Harkonnens themselves, is a bold choice. Even for you.\nWe look forward to seeing your forces come down on the city's defenses.",
											"match": {},
											"sfx": "Voice_Conquest_Neutral_Thefortress_Piter_1_0",
											"translation_notes": "The Speaker is Piter de Vries\nBaron is a book term (Baron Vladimir Harkonnen)\n",
											"voice_notes": "Tone: falsely polite, despising, sure that the player will fail attacking them."
										}
									]
								},
								{
									"variationIndex": 1,
									"target": 0,
									"speeches": [
										{
											"text": "You don't lack ambition. Attacking Carthag. The greatest fortress in Arrakis. Truly, I'm shocked. No self-respecting Mentat would advise their lord to do something so foolish. But you're already here, so there's no point going back – you would deprive House Harkonnen of a spectacular sight. We look forward to seeing your forces come down on the city's defenses.",
											"match": {},
											"sfx": "Voice_Conquest_Neutral_Thefortress_Piter_2_0",
											"translation_notes": "The Speaker is Piter de Vries\nmentat is a book term\n\n",
											"voice_notes": "Tone: mocking the player, casual, sure that the player will fail"
										}
									]
								}
							]
						}
					],
					"from": 2,
					"props": {},
					"flags": 0
				},
				{
					"id": "TheSiegeOfArrakeen_Start",
					"speechesPerSpeaker": [
						{
							"character": "Thufir",
							"pool": [
								{
									"variationIndex": 0,
									"target": 0,
									"speeches": [
										{
											"text": "What is your army doing here? They don't stand a chance against Arrakeen. Its shield will halt your sorry attempts to destroy it. It's impenetrable – you'll wear yourselves out before the city gates.",
											"match": {},
											"sfx": "Voice_Conquest_Neutral_Siegeofarrakeen_Thufir_1_0",
											"translation_notes": "Speaker is Thufir Hawat\nshield is a book term. It's a forcefield, not a buckler",
											"voice_notes": "Tone: furious, despising"
										}
									]
								}
							]
						}
					],
					"from": 2,
					"props": {},
					"flags": 0
				},
				{
					"id": "TheSiegeOfArrakeen_Step1",
					"speechesPerSpeaker": [
						{
							"character": "Thufir",
							"pool": [
								{
									"variationIndex": 0,
									"target": 0,
									"speeches": [
										{
											"text": "The shield…! How did you do that? Is there a traitor within Arrakeen?\nSuch treachery will be rewarded with death! Our men will fight to the last to defend the Duke and his family. Arrakeen will not fall!",
											"match": {},
											"sfx": "Voice_Conquest_Neutral_Siegeofarrakeen_Thufir_1_1",
											"translation_notes": "Speaker is Thufir Hawat\nshield is a book term. It's a forcefield, not a buckler\nDuke is a book term (Duke Leto Atreides)",
											"voice_notes": "Tone: surprised, sacred or puzzled. Then furious, aggressive, determined"
										}
									]
								}
							]
						}
					],
					"from": 2,
					"props": {},
					"flags": 0
				},
				{
					"id": "Downfall_Start",
					"speechesPerSpeaker": [
						{
							"character": "Fenring",
							"pool": [
								{
									"variationIndex": 0,
									"target": 1,
									"speeches": [
										{
											"text": "Let us drop the false pretenses.\nYou decided to attack the Empire, and His Majesty cannot allow such an affront to go unpunished. Your House will be eradicated, your bloodline destroyed, and your men – the ones who survive the coming slaughter – will die in the jails of Salusa Secundus.\nThis battle will serve as a warning to all of the Landsraad.",
											"match": {
												"house": 0
											},
											"sfx": "Voice_Conquest_C_Downfall_Hasimir_1_0",
											"translation_notes": "Speaker is hasimir fenring\nSalusa secundus is a book term\nLandsraad is a book and game term",
											"voice_notes": "Tone: cold anger (he does not use his annoying way of speaking), determined, serious and factual as a judge, as if the player has already lost the battle."
										},
										{
											"text": "Let us drop the false pretenses.\nYou decided to attack the Empire, and His Majesty cannot allow such an affront to go unpunished. Your people will be eradicated, and I'll personally make sure that you end your days in the jails of Salusa Secundus.\nThis battle will serve as a warning to the whole Empire.",
											"match": {
												"house": 1
											},
											"translation_notes": "Speaker is hasimir fenring\nSalusa secundus is a book term\nLandsraad is a book and game term",
											"sfx": "Voice_Conquest_C_Downfall_Hasimir_1_0",
											"voice_notes": "Tone: cold anger (he does not use his annoying way of speaking), determined, serious and factual as a judge, as if the player has already lost the battle."
										}
									]
								}
							]
						}
					],
					"from": 2,
					"props": {},
					"flags": 0
				},
				{
					"id": "TheRedExhibition_Start",
					"speechesPerSpeaker": [
						{
							"character": "Sanya",
							"pool": [
								{
									"variationIndex": 0,
									"target": 0,
									"speeches": [
										{
											"text": "How dare you attack Foliage!\nYou don't know who you're dealing with. The Ecazis are not simply artists – they are brave fighters whom you've underestimated for too long. This siege will end with your defeat, and our troubadours will ever sing of this day as your House's last!",
											"match": {},
											"sfx": "Voice_Conquest_Neutral_Theredexhibition_Sanya_1_0",
											"translation_notes": "Speaker in Sanya Ecaz\nEcazis is a book term (people of planet Ecaz)\nFoliage is a game term (House Ecaz Main Base)",
											"voice_notes": "Tone: furious, scandalized"
										}
									]
								}
							]
						}
					],
					"from": 2,
					"props": {},
					"flags": 0
				},
				{
					"id": "KillVernius_Start",
					"speechesPerSpeaker": [
						{
							"character": "Tessia",
							"pool": [
								{
									"variationIndex": 0,
									"target": 0,
									"speeches": [
										{
											"text": "You know it as well as I do: your attack is bound to fail. House Vernius' technological superiority places us far above all others. In our eyes, your mighty army is nothing more than a barbarian horde wielding rocks!\nIt is high time you learned that knowledge is power. We will rid Arrakis of your ilk!",
											"match": {},
											"translation_notes": "Speaker in Tessia Vernius",
											"sfx": "Voice_Conquest_V_Killvernius_Tessia_1_0"
										}
									]
								}
							]
						}
					],
					"from": 2,
					"flags": 0,
					"props": {}
				},
				{
					"id": "Assault_Start",
					"speechesPerSpeaker": [
						{
							"character": "Piter",
							"pool": [
								{
									"variationIndex": 0,
									"target": 2,
									"speeches": [
										{
											"text": "This territory is far too strategic to be left in the hands of a rival. In fact, I’m surprised you haven’t already recaptured it, Baron. Surely you’re not suffering from an excess of caution in your approach to your adversaries?",
											"match": {
												"gender": 0
											},
											"sfx": "Voice_Conquest_H_Assault_Piter_1_0",
											"translation_notes": "Speaker is Piter de Vries\nterritory is a game term\nBaron is a book term (Baron Vladimir Harkonnen)\nhere \"the rival\" is masculine",
											"voice_notes": "Tone: casual at first then taunting the Baron"
										},
										{
											"text": "This territory is far too strategic to be left in the hands of a rival. In fact, I’m surprised you haven’t already recaptured it, Baron. Surely you’re not suffering from an excess of caution in your approach to your adversaries?",
											"match": {
												"gender": 1
											},
											"sfx": "Voice_Conquest_H_Assault_Piter_1f_0",
											"translation_notes": "Speaker is Piter de Vries\nterritory is a game term\nBaron is a book term (Baron Vladimir Harkonnen)\nhere \"the rival\" is feminine",
											"voice_notes": "Tone: casual at first then taunting the Baron"
										}
									]
								},
								{
									"variationIndex": 1,
									"target": 0,
									"speeches": [
										{
											"text": "Our men are ready to start the assault, Baron. I’d even say they’re eager to wipe this enemy Base off the map. Indulge their enthusiasm, and they won’t disappoint you.",
											"match": {},
											"sfx": "Voice_Conquest_H_Assault_Piter_2_0",
											"translation_notes": "Speaker is Piter de Vries\nbase is a game term (main base)\nBaron is a book term (Baron Vladimir Harkonnen)\n",
											"voice_notes": "Tone: serious but casual. Sombre or cruel on the last sentence"
										}
									]
								},
								{
									"variationIndex": 2,
									"target": 0,
									"speeches": [
										{
											"text": "Seeing anyone but a Harkonnen mining the sands of Arrakis is sheer torture, Baron. Their profits are so meager compared to what you could extract! Someone must put an end to this needless waste.",
											"match": {},
											"sfx": "Voice_Conquest_H_Assault_Piter_3_0",
											"translation_notes": "Speaker is Piter de Vries\nBaron is a book term (Baron Vladimir Harkonnen)\n",
											"voice_notes": "Tone: faking suffering, dramatic, "
										}
									]
								}
							]
						},
						{
							"character": "Sanya",
							"pool": [
								{
									"variationIndex": 0,
									"target": 2,
									"speeches": [
										{
											"text": "It won’t be easy to expel your rival from this territory. He seems to have made himself quite comfortable here – his villages are well defended, and his Base looks well fortified. But nothing can resist our House's ingenuity. I know you will emerge victorious, Mother.",
											"match": {
												"gender": 0
											},
											"sfx": "Voice_Conquest_E_Assault_Sanya_1_0",
											"translation_notes": "Speaker is Sanya Ecaz\nterritory is a game term\nbase is a game term (main base)\nhere \"the rival\" is masculine",
											"voice_notes": "Tone: formal but arrogant "
										},
										{
											"text": "It won’t be easy to expel your rival from this territory. She seems to have made herself quite comfortable here – her villages are well defended, and her Base looks well fortified. But nothing can resist our House's ingenuity. I know you will emerge victorious, Mother.",
											"match": {
												"gender": 1
											},
											"sfx": "Voice_Conquest_E_Assault_Sanya_1f_0",
											"translation_notes": "Speaker is Sanya Ecaz\nterritory is a game term\nbase is a game term (main base)\nhere \"the rival\" is feminine",
											"voice_notes": "Tone: formal but arrogant "
										}
									]
								},
								{
									"variationIndex": 1,
									"target": 2,
									"speeches": [
										{
											"text": "All these vulgar fortifications and filthy, reeking soldiers... your enemy’s Base is an oozing boil on the face of Arrakis. Someone should lance it and replace it with something more appealing. Wouldn’t you agree, Mother?",
											"match": {
												"gender": 0
											},
											"sfx": "Voice_Conquest_E_Assault_Sanya_2_0",
											"translation_notes": "Speaker is Sanya Ecaz\nbase is a game term (main base)\nhere \"the enemy\" is masculine",
											"voice_notes": "Tone: despising and arrogant, then casual on the last sentence (as if she was not talking about a war)"
										},
										{
											"text": "All these vulgar fortifications and filthy, reeking soldiers... your enemy’s Base is an oozing boil on the face of Arrakis. Someone should lance it and replace it with something more appealing. Wouldn’t you agree, Mother?",
											"match": {
												"gender": 1
											},
											"sfx": "Voice_Conquest_E_Assault_Sanya_2_0",
											"translation_notes": "Speaker is Sanya Ecaz\nbase is a game term (main base)\nhere \"the enemy\" is femine",
											"voice_notes": "Tone: despising and arrogant, then casual on the last sentence (as if she was not talking about a war)"
										}
									]
								}
							]
						},
						{
							"character": "Thufir",
							"pool": [
								{
									"variationIndex": 0,
									"target": 0,
									"speeches": [
										{
											"text": "The men are ready to attack and risk their lives to secure victory.\nThey’re only awaiting your order.",
											"match": {},
											"sfx": "Voice_Conquest_A_Assault_Thufir_1_0",
											"translation_notes": "Speaker is Thufir Hawat",
											"voice_notes": "Tone: formal, serious, determined, ready to fight too"
										}
									]
								},
								{
									"variationIndex": 1,
									"target": 2,
									"speeches": [
										{
											"text": "Your enemy’s progression must be stopped. Conquering one of his territories will weaken his grip on Arrakis and undermine his troops’ morale.",
											"match": {
												"gender": 0
											},
											"sfx": "Voice_Conquest_A_Assault_Thufir_2_0",
											"translation_notes": "Speaker is Thufir Hawat\nterritory is a game term\nhere the enemy is masculine",
											"voice_notes": "Tone: serious"
										},
										{
											"text": "Your enemy’s progression must be stopped. Conquering one of her territories will weaken her grip on Arrakis and undermine her troops’ morale.",
											"match": {
												"gender": 1
											},
											"sfx": "Voice_Conquest_A_Assault_Thufir_2f_0",
											"translation_notes": "Speaker is Thufir Hawat\nterritory is a game term\nhere the enemy is feminine",
											"voice_notes": "Tone: serious"
										}
									]
								}
							]
						},
						{
							"character": "Fenring",
							"pool": [
								{
									"variationIndex": 0,
									"target": 2,
									"speeches": [
										{
											"text": "Your rival is expanding his holdings on Arrakis too quickly. If his momentum isn’t broken, he'll become unstoppable. Snatching back one of his newly conquered territories before he can react should slow him down for a while.",
											"match": {
												"gender": 0
											},
											"sfx": "Voice_Conquest_C_Assault_Hasimir_1_0",
											"translation_notes": "Speaker is Hasimir Fenring\nterritory is a game term\nhere your rival is masculine",
											"voice_notes": "Tone: calm, serious, organizing"
										},
										{
											"text": "Your rival is expanding her holdings on Arrakis too quickly. If her momentum isn’t broken, she'll become unstoppable. Snatching back one of her newly conquered territories before she can react should slow her down for a while.",
											"match": {
												"gender": 1
											},
											"sfx": "Voice_Conquest_C_Assault_Hasimir_1f_0",
											"translation_notes": "Speaker is Hasimir Fenring\nterritory is a game term\nhere your rival is feminine",
											"voice_notes": "Tone: calm, serious, organizing"
										}
									]
								},
								{
									"variationIndex": 1,
									"target": 2,
									"speeches": [
										{
											"text": "Majesty, our spies report that your adversary has left only a light garrison in this territory. You could seize it from him quickly, before he has time to call in reinforcements.",
											"match": {
												"gender": 0
											},
											"sfx": "Voice_Conquest_C_Assault_Hasimir_2_0",
											"translation_notes": "Speaker is Hasimir Fenring\nFenring specifically say \"Majesty\", not \"your majesty\"\nterritory is a game term\nhere your adversary is masculine",
											"voice_notes": "Tone: calm, serious, organizing"
										},
										{
											"text": "Majesty, our spies report that your adversary has left only a light garrison in this territory. You could seize it from her quickly, before she has time to call in reinforcements.",
											"match": {
												"gender": 1
											},
											"sfx": "Voice_Conquest_C_Assault_Hasimir_2f_0",
											"translation_notes": "Speaker is Hasimir Fenring\nFenring specifically say \"Majesty\", not \"your majesty\"\nterritory is a game term\nhere your adversary is feminine",
											"voice_notes": "Tone: calm, serious, organizing"
										}
									]
								}
							]
						},
						{
							"character": "Tessia",
							"pool": [
								{
									"variationIndex": 0,
									"target": 2,
									"speeches": [
										{
											"text": "We must capture this territory, no matter how long it takes. Leave it in your enemy’s hands, and he will continue to draw on its resources and villages to support his war against you.\nHouse Vernius has already reconquered an entire planet. This territory is nothing in comparison.",
											"match": {
												"gender": 0
											},
											"translation_notes": "Speaker is Tessia Vernius",
											"voice_notes": "Tone: determined, even fierce. ",
											"sfx": "Voice_Conquest_V_Assault_Tessia_1_0"
										},
										{
											"text": "We must capture this territory, no matter how long it takes. Leave it in your enemy’s hands, and she will continue to draw on its resources and villages to support her war against you. \r\nHouse Vernius has already reconquered an entire planet. This territory is nothing in comparison.",
											"match": {
												"gender": 1
											},
											"translation_notes": "Speaker is Tessia Vernius",
											"voice_notes": "Tone: determined, even fierce. ",
											"sfx": "Voice_Conquest_V_Assault_Tessia_1f_0"
										}
									]
								},
								{
									"variationIndex": 1,
									"target": 2,
									"speeches": [
										{
											"text": "We must weaken your enemy to ensure our victory. Depriving him of this territory and its resources and troops will consolidate our advances and slow his progress. We have no choice – we must drive him from these lands.",
											"match": {
												"gender": 0
											},
											"translation_notes": "Speaker is Tessia Vernius",
											"sfx": "Voice_Conquest_V_Assault_Tessia_2_0"
										},
										{
											"text": "We must weaken your enemy to ensure our victory. Depriving her of this territory and its resources and troops will consolidate our advances and slow her progress. We have no choice – we must drive her from these lands.",
											"match": {
												"gender": 1
											},
											"translation_notes": "Speaker is Tessia Vernius",
											"sfx": "Voice_Conquest_V_Assault_Tessia_2f_0"
										}
									]
								}
							]
						},
						{
							"character": "Staban",
							"pool": [
								{
									"variationIndex": 0,
									"target": 0,
									"speeches": [
										{
											"text": "This Great House is too ambitious for their own good. Depriving them of one of their territories will surely force them to reconsider their attitude towards us.",
											"match": {},
											"translation_notes": "Speaker is Staban",
											"voice_notes": "Tone: grinning, planning, he is sure of the victory",
											"sfx": "Voice_Conquest_S_Assault_Staban_1_0"
										}
									]
								},
								{
									"variationIndex": 1,
									"target": 0,
									"speeches": [
										{
											"text": "Father, the speed at which this Great House has spread across Arrakis is alarming. It is high time we put a damper on their ambitions. I fear that if we do not react now, we will soon be forced to submit to their laws.",
											"match": {},
											"translation_notes": "Speaker is Staban",
											"voice_notes": "Tone: a bit worried, trying to convince his father to react",
											"sfx": "Voice_Conquest_S_Assault_Staban_2_0"
										}
									]
								}
							]
						},
						{
							"character": "Stilgar",
							"pool": [
								{
									"variationIndex": 0,
									"target": 0,
									"speeches": [
										{
											"text": "The scouts have returned from the villages, and the warriors are all ready to attack.\nYou need only give the order, my sister. Your enemies' water will not be lost.",
											"match": {},
											"translation_notes": "Speaker is Stilgar",
											"voice_notes": "Tone: calm and determined",
											"sfx": "Voice_Conquest_F_Assault_Stilgar_1_0"
										}
									]
								},
								{
									"variationIndex": 1,
									"target": 0,
									"speeches": [
										{
											"text": "Great gods below!\nThose wormfaced scum are already there! They're swarming amongst the rocks!\nWe must act quickly and break the offworlders' grip on this territory before they expand their reach further still.",
											"match": {},
											"translation_notes": "Speaker is Stilgar",
											"voice_notes": "Tone: upset, furious then determined and fierce",
											"sfx": "Voice_Conquest_F_Assault_Stilgar_2_0"
										}
									]
								}
							]
						}
					],
					"from": 0,
					"props": {},
					"flags": 0
				},
				{
					"id": "TheRenegades_Start",
					"speechesPerSpeaker": [
						{
							"character": "SpacingGuild",
							"pool": [
								{
									"variationIndex": 0,
									"target": 0,
									"speeches": [
										{
											"text": "Renegade Houses have left Tupile without authorization. They may have taken advantage of the confusion to seek refuge on Arrakis.\nWe are counting on your help to find them and eliminate them. Their presence is already disrupting order in the Imperium.",
											"match": {},
											"sfx": "Voice_Conquest_Neutral_Therenegades_Guildemissary_1_0",
											"translation_notes": "Speaker is an unnamed representant of the Spacing Guild\nRenegade and Renegade houses are a game and book term\nTupile is a book term\n",
											"voice_notes": "Tone: very formal and professional, no emotion, this is a report\nContext: Tupile is a planet where the defeated houses can live in peace, excluded from the Imperium. "
										}
									]
								},
								{
									"variationIndex": 1,
									"target": 0,
									"speeches": [
										{
											"text": "The Spacing Guild has been informed of the presence of renegade Houses on Arrakis. They could try to interfere with trade and spice production. We ask that you eliminate them.\nWe will compensate you richly for your efforts.",
											"match": {},
											"sfx": "Voice_Conquest_Neutral_Therenegades_Guildemissary_2_0",
											"translation_notes": "Speaker is an unnamed representant of the Spacing Guild\nSpacing Guild is a book term\nRenegade and Renegade houses are a game and book term\n\n",
											"voice_notes": "Tone: very formal and professional, no emotion, this is a report\nContext: Tupile is a planet where the defeated houses can live in peace, excluded from the Imperium. "
										}
									]
								}
							]
						}
					],
					"from": 2,
					"props": {},
					"flags": 0
				},
				{
					"id": "Outro_Win",
					"speechesPerSpeaker": [
						{
							"character": "Piter",
							"pool": [
								{
									"variationIndex": 0,
									"target": 0,
									"speeches": [
										{
											"text": "Your conquest is proceeding apace, Baron. Each territory you acquire strengthens the Harkonnens and weakens your enemies. Soon all Arrakis will be yours.",
											"match": {},
											"sfx": "Voice_Conquest_H_Outrowin_Piter_1_0",
											"translation_notes": "Speaker is Piter de Vries\nterritory is a game term\nBaron is a book term (Baron Vladimir Harkonnen)",
											"voice_notes": "Tone: satisfied, more and more serious"
										}
									]
								},
								{
									"variationIndex": 1,
									"target": 0,
									"speeches": [
										{
											"text": "A most definitive victory. No one crushes their enemies like you do.",
											"match": {},
											"sfx": "Voice_Conquest_H_Outrowin_Piter_2_0",
											"translation_notes": "Speaker is Piter de Vries",
											"voice_notes": "Tone: pleased, almost a complicity between him and the Baron"
										}
									]
								},
								{
									"variationIndex": 2,
									"target": 0,
									"speeches": [
										{
											"text": "Who would dare challenge such a victory, Baron? Your enemies fought so hard... Their disappointment must be cruel indeed!",
											"match": {},
											"sfx": "Voice_Conquest_H_Outrowin_Piter_3_0",
											"translation_notes": "Speaker is Piter de Vries\nBaron is a book term (Baron Vladimir Harkonnen)",
											"voice_notes": "Tone: despising toward the enemy, satisfied, mocking or cruel on the last sentence"
										}
									]
								},
								{
									"variationIndex": 3,
									"target": 0,
									"speeches": [
										{
											"text": "Your enemies are withdrawing, Baron!\nThis territory is yours! Your victory is indisputable.",
											"match": {},
											"sfx": "Voice_Conquest_H_Outrowin_Piter_4_0",
											"translation_notes": "Speaker is Piter de Vries\nterritory is a game term\nBaron is a book term (Baron Vladimir Harkonnen)",
											"voice_notes": "Tone: formal and satisified at first. Serious on the last sentence "
										}
									]
								},
								{
									"variationIndex": 4,
									"target": 0,
									"speeches": [
										{
											"text": "How satisfying to see you triumph over your enemies... This territory is yours, Baron, for better and for worse.",
											"match": {},
											"sfx": "Voice_Conquest_H_Outrowin_Piter_5_0",
											"translation_notes": "Speaker is Piter de Vries\nterritory is a game term\nBaron is a book term (Baron Vladimir Harkonnen)",
											"voice_notes": "Tone: casual, amused, even mocking the Baron"
										}
									]
								}
							]
						},
						{
							"character": "Sanya",
							"pool": [
								{
									"variationIndex": 0,
									"target": 0,
									"speeches": [
										{
											"text": "What panache! What brio!\nOur troubadours will make sure that your enemies never forget this day.",
											"match": {},
											"sfx": "Voice_Conquest_E_Outrowin_Sanya_1_0",
											"translation_notes": "Speaker is Sanya Ecaz",
											"voice_notes": "Tone: very proud of the player (her Mother), enthusiastic (but noble)"
										}
									]
								},
								{
									"variationIndex": 1,
									"target": 0,
									"speeches": [
										{
											"text": "The enemy is retreating before our advancing army. This territory is yours!",
											"match": {},
											"sfx": "Voice_Conquest_E_Outrowin_Sanya_2_0",
											"translation_notes": "Speaker is Sanya Ecaz\nterritory is a game term",
											"voice_notes": "Tone: proud and pleased"
										}
									]
								},
								{
									"variationIndex": 2,
									"target": 0,
									"speeches": [
										{
											"text": "Our conquest of Arrakis is progressing admirably, Mother. Soon, all the spice in the Imperium will be in our hands.",
											"match": {},
											"sfx": "Voice_Conquest_E_Outrowin_Sanya_3_0",
											"translation_notes": "Speaker is Sanya Ecaz",
											"voice_notes": "Tone: eager, determined, enthusiastic "
										}
									]
								},
								{
									"variationIndex": 3,
									"target": 0,
									"speeches": [
										{
											"text": "You’re becoming quite the muse, Mother. This victory will be the subject of many a masterful work.",
											"match": {},
											"sfx": "Voice_Conquest_E_Outrowin_Sanya_4_0",
											"translation_notes": "Speaker is Sanya Ecaz",
											"voice_notes": "Tone: proud of the player (her Mother)"
										}
									]
								}
							]
						},
						{
							"character": "Thufir",
							"pool": [
								{
									"variationIndex": 0,
									"target": 0,
									"speeches": [
										{
											"text": "Our banner flies over all the villages in this territory. This is a great victory, my lord.",
											"match": {},
											"sfx": "Voice_Conquest_A_Outrowin_Thufir_1_0",
											"translation_notes": "Speaker is Thufir Hawat\nterritory is a game term",
											"voice_notes": "Tone: serious and proud of the player, rewarding on the last sentence"
										}
									]
								},
								{
									"variationIndex": 1,
									"target": 0,
									"speeches": [
										{
											"text": "Your men are proud to have been part of your victory. You have made these hostile lands into a new home for the Atreides.",
											"match": {},
											"sfx": "Voice_Conquest_A_Outrowin_Thufir_2_0",
											"translation_notes": "Speaker is Thufir Hawat",
											"voice_notes": "Tone: serious and proud of the player"
										}
									]
								},
								{
									"variationIndex": 2,
									"target": 0,
									"speeches": [
										{
											"text": "This territory is yours, sire! The enemy is withdrawing! House Atreides is triumphant!",
											"match": {},
											"sfx": "Voice_Conquest_A_Outrowin_Thufir_3_0",
											"translation_notes": "Speaker is Thufir Hawat\nterritory is a game term",
											"voice_notes": "Tone: reporting the situation, proud of the player"
										}
									]
								},
								{
									"variationIndex": 3,
									"target": 0,
									"speeches": [
										{
											"text": "Your conquest is progressing more quickly than we had hoped, my lord. It is an honor to serve at your side.",
											"match": {},
											"sfx": "Voice_Conquest_A_Outrowin_Thufir_4_0",
											"translation_notes": "Speaker is Thufir Hawat",
											"voice_notes": "Tone: serious and proud of the player, rewarding on the last sentence"
										}
									]
								},
								{
									"variationIndex": 4,
									"target": 0,
									"speeches": [
										{
											"text": "A victory worthy to be immortalized in song by Gurney Halleck.",
											"match": {},
											"sfx": "Voice_Conquest_A_Outrowin_Thufir_5_0",
											"translation_notes": "Speaker is Thufir Hawat",
											"voice_notes": "Tone: satisfied, smiling, complicity with the duke"
										}
									]
								}
							]
						},
						{
							"character": "Fenring",
							"pool": [
								{
									"variationIndex": 0,
									"target": 0,
									"speeches": [
										{
											"text": "This territory belongs to you. Your enemies have fled.",
											"match": {},
											"sfx": "Voice_Conquest_C_Outrowin_Hasimir_1_0",
											"translation_notes": "Speaker is Hasimir Fenring\nterritory is a game term",
											"voice_notes": "Tone: reporting the situation, serious, calm"
										}
									]
								},
								{
									"variationIndex": 1,
									"target": 0,
									"speeches": [
										{
											"text": "Majesty, this territory is yours.",
											"match": {},
											"sfx": "Voice_Conquest_C_Outrowin_Hasimir_2_0",
											"translation_notes": "Speaker is Hasimir Fenring\nFenring specifically say \"Majesty\", not \"your majesty\"\nterritory is a game term",
											"voice_notes": "Tone: serious and calm"
										}
									]
								},
								{
									"variationIndex": 2,
									"target": 0,
									"speeches": [
										{
											"text": "The Empire’s conquest of Arrakis is proceeding in line with our projections. I believe congratulations are in order.",
											"match": {},
											"sfx": "Voice_Conquest_C_Outrowin_Hasimir_3_0",
											"translation_notes": "Speaker is Hasimir Fenring",
											"voice_notes": "Tone: formal, serious and calm but also pleased"
										}
									]
								},
								{
									"variationIndex": 3,
									"target": 0,
									"speeches": [
										{
											"text": "This territory’s resources are ours, Majesty. The villages will exploit them in accordance with your wishes.",
											"match": {},
											"sfx": "Voice_Conquest_C_Outrowin_Hasimir_4_0",
											"translation_notes": "Speaker is Hasimir Fenring\nFenring specifically say \"Majesty\", not \"your majesty\"\nterritory is a game term",
											"voice_notes": "Tone: serious and calm"
										}
									]
								}
							]
						},
						{
							"character": "Tessia",
							"pool": [
								{
									"variationIndex": 0,
									"target": 0,
									"speeches": [
										{
											"text": "I never doubted your victory, my husband. I knew that this territory would belong to House Vernius.",
											"match": {},
											"translation_notes": "Speaker is Tessia Vernius",
											"voice_notes": "Tone: smiling, very proud of her husband",
											"sfx": "Voice_Conquest_V_Outrowin_Tessia_1_0"
										}
									]
								},
								{
									"variationIndex": 1,
									"target": 0,
									"speeches": [
										{
											"text": "Our House’s grip on Arrakis grows stronger with each territory we conquer. Soon the entire planet will be yours, my Earl.",
											"match": {},
											"translation_notes": "Speaker is Tessia Vernius",
											"voice_notes": "Tone: proud of her husband, determined",
											"sfx": "Voice_Conquest_V_Outrowin_Tessia_2_0"
										}
									]
								},
								{
									"variationIndex": 2,
									"target": 0,
									"speeches": [
										{
											"text": "You are victorious! I couldn’t be prouder of you, my husband.",
											"match": {},
											"translation_notes": "Speaker is Tessia Vernius",
											"voice_notes": "Tone: very proud of her husband",
											"sfx": "Voice_Conquest_V_Outrowin_Tessia_3_0"
										}
									]
								},
								{
									"variationIndex": 3,
									"target": 0,
									"speeches": [
										{
											"text": "How satisfying to see our plans for Arrakis coming to fruition! Your triumphs bring us closer to victory every day.",
											"match": {},
											"translation_notes": "Speaker is Tessia Vernius",
											"voice_notes": "Tone: satisfied, proud",
											"sfx": "Voice_Conquest_V_Outrowin_Tessia_4_0"
										}
									]
								}
							]
						},
						{
							"character": "Stilgar",
							"pool": [
								{
									"variationIndex": 0,
									"target": 0,
									"speeches": [
										{
											"text": "The territory is free, sister! The offworlders are leaving! They're retreating!",
											"match": {},
											"translation_notes": "Speaker is Stilgar",
											"voice_notes": "Tone: relieved, proud of Liet, happy",
											"sfx": "Voice_Conquest_F_Outrowin_Stilgar_1_0"
										}
									]
								},
								{
									"variationIndex": 1,
									"target": 0,
									"speeches": [
										{
											"text": "Your victory lifts our hearts on wings of pride, sister. Listen as the sietches sing your name!",
											"match": {},
											"translation_notes": "Speaker is Stilgar",
											"voice_notes": "Tone: grateful, proud of his friend (not his true sister)",
											"sfx": "Voice_Conquest_F_Outrowin_Stilgar_2_0"
										}
									]
								},
								{
									"variationIndex": 2,
									"target": 0,
									"speeches": [
										{
											"text": "May Old Father Sun bear witness to your success! May all of Dune celebrate your victory!",
											"match": {},
											"translation_notes": "Speaker is Stilgar\n\n\"Old Father Sun\" is a quote from the book ",
											"voice_notes": "Tone: happy, celebrating",
											"sfx": "Voice_Conquest_F_Outrowin_Stilgar_3_0"
										}
									]
								},
								{
									"variationIndex": 3,
									"target": 0,
									"speeches": [
										{
											"text": "These lands are free! The Fremen are victorious! Soon we shall be the new <i>naibs</i> of Dune!",
											"match": {},
											"translation_notes": "Speaker is Stilgar\nnaib is a fremen term from the book",
											"voice_notes": "Tone: happy, enthusiastic ",
											"sfx": "Voice_Conquest_F_Outrowin_Stilgar_4_0"
										}
									]
								}
							]
						},
						{
							"character": "Staban",
							"pool": [
								{
									"variationIndex": 0,
									"target": 0,
									"speeches": [
										{
											"text": "You are triumphant, Father! Victory is ours! No one can deny our dominance over this territory.",
											"match": {},
											"translation_notes": "Speaker is Staban",
											"voice_notes": "Tone: proud of his father, cannot believe his eye",
											"sfx": "Voice_Conquest_S_Outrowin_Staban_1_0"
										}
									]
								},
								{
									"variationIndex": 1,
									"target": 0,
									"speeches": [
										{
											"text": "Ah! Your enemy is retreating! A Great House flees before the Smugglers!",
											"match": {},
											"translation_notes": "Speaker is Staban",
											"voice_notes": "Tone: too proud, happy",
											"sfx": "Voice_Conquest_S_Outrowin_Staban_2_0"
										}
									]
								},
								{
									"variationIndex": 2,
									"target": 0,
									"speeches": [
										{
											"text": "Victory is ours! Our grip on the spice grows ever tighter!\r\nSoon we shall declare our own laws on Arrakis!",
											"match": {},
											"translation_notes": "Speaker is Staban",
											"voice_notes": "Tone: proud, determined",
											"sfx": "Voice_Conquest_S_Outrowin_Staban_3_0"
										}
									]
								},
								{
									"variationIndex": 3,
									"target": 0,
									"speeches": [
										{
											"text": "A few more victories like this one, and our family will be as powerful as any Great House. We'll soon be pulling the strings of the whole Empire!",
											"match": {},
											"translation_notes": "Speaker is Staban",
											"voice_notes": "Tone: proud, happy, determined",
											"sfx": "Voice_Conquest_S_Outrowin_Staban_4_0"
										}
									]
								}
							]
						}
					],
					"from": 0,
					"props": {},
					"flags": 0
				},
				{
					"id": "Outro_Lost",
					"speechesPerSpeaker": [
						{
							"character": "Piter",
							"pool": [
								{
									"variationIndex": 0,
									"target": 0,
									"speeches": [
										{
											"text": "What happened, Baron? It seems this territory has gotten away from you!",
											"match": {},
											"sfx": "Voice_Conquest_H_Outrolost_Piter_1_0",
											"translation_notes": "Speaker is Piter de Vries\nterritory is a game term\nBaron is a book term (Baron Vladimir Harkonnen)",
											"voice_notes": "Tone: amused, mocking the player (Baron), taunting"
										}
									]
								},
								{
									"variationIndex": 1,
									"target": 0,
									"speeches": [
										{
											"text": "Perhaps you underestimated your enemies, Baron? They didn’t seem to have too much trouble driving you out of this territory.",
											"match": {},
											"sfx": "Voice_Conquest_H_Outrolost_Piter_2_0",
											"translation_notes": "Speaker is Piter de Vries\nterritory is a game term\nBaron is a book term (Baron Vladimir Harkonnen)",
											"voice_notes": "Tone: amused, mocking the player (Baron), taunting"
										}
									]
								},
								{
									"variationIndex": 2,
									"target": 0,
									"speeches": [
										{
											"text": "I’ve already ordered the retreat, Baron. This territory is no great loss, though. You should concentrate on more strategic regions.",
											"match": {},
											"sfx": "Voice_Conquest_H_Outrolost_Piter_3_0",
											"translation_notes": "Speaker is Piter de Vries\nterritory is a game term\nBaron is a book term (Baron Vladimir Harkonnen)",
											"voice_notes": "Tone: casual"
										}
									]
								},
								{
									"variationIndex": 3,
									"target": 0,
									"speeches": [
										{
											"text": "This defeat is a disturbing sign for your plans of conquest, Baron. Each enemy victory weakens you and strengthens them.",
											"match": {},
											"sfx": "Voice_Conquest_H_Outrolost_Piter_4_0",
											"translation_notes": "Speaker is Piter de Vries\nBaron is a book term (Baron Vladimir Harkonnen)",
											"voice_notes": "Tone: worried, sombre"
										}
									]
								}
							]
						},
						{
							"character": "Sanya",
							"pool": [
								{
									"variationIndex": 0,
									"target": 0,
									"speeches": [
										{
											"text": "We must retreat, Mother. This territory is lost.",
											"match": {},
											"sfx": "Voice_Conquest_E_Outrolost_Sanya_1_0",
											"translation_notes": "Speaker is Sanya Ecaz\nterritory is a game term",
											"voice_notes": "Tone: serious, worried"
										}
									]
								},
								{
									"variationIndex": 1,
									"target": 0,
									"speeches": [
										{
											"text": "Yes, we’ve lost a territory, but no matter. We’ll conquer a new one soon enough.",
											"match": {},
											"sfx": "Voice_Conquest_E_Outrolost_Sanya_2_0",
											"translation_notes": "Speaker is Sanya Ecaz\nterritory is a game term",
											"voice_notes": "Tone: arrogant but worried"
										}
									]
								},
								{
									"variationIndex": 2,
									"target": 0,
									"speeches": [
										{
											"text": "Only the weak are ground down by defeat, and your men are anything but. They’ll fight even more fiercely next time and conquer a new territory for you.",
											"match": {},
											"sfx": "Voice_Conquest_E_Outrolost_Sanya_3_0",
											"translation_notes": "Speaker is Sanya Ecaz\nterritory is a game term",
											"voice_notes": "Tone: arrogant, proud and determined"
										}
									]
								},
								{
									"variationIndex": 3,
									"target": 0,
									"speeches": [
										{
											"text": "This defeat will teach us to be cautious, but we need not abandon our efforts. The conquest of Arrakis is still possible.",
											"match": {},
											"sfx": "Voice_Conquest_E_Outrolost_Sanya_4_0",
											"translation_notes": "Speaker is Sanya Ecaz",
											"voice_notes": "Tone: determined"
										}
									]
								}
							]
						},
						{
							"character": "Thufir",
							"pool": [
								{
									"variationIndex": 0,
									"target": 0,
									"speeches": [
										{
											"text": "Witch blood! This territory has slipped from our grasp! We must withdraw!",
											"match": {},
											"sfx": "Voice_Conquest_A_Outrolost_Thufir_1_0",
											"translation_notes": "Speaker is Thufir Hawat\nterritory is a game term",
											"voice_notes": "Tone: furious"
										}
									]
								},
								{
									"variationIndex": 1,
									"target": 0,
									"speeches": [
										{
											"text": "We must retreat, my lord. This territory is now in enemy hands. There is nothing more we can do.",
											"match": {},
											"sfx": "Voice_Conquest_A_Outrolost_Thufir_2_0",
											"translation_notes": "Speaker is Thufir Hawat\nterritory is a game term",
											"voice_notes": "Tone: disappointed, sad, reporting the situation"
										}
									]
								},
								{
									"variationIndex": 2,
									"target": 0,
									"speeches": [
										{
											"text": "The enemy has won the day, but we shall return stronger than ever. The conquest is far from over.",
											"match": {},
											"sfx": "Voice_Conquest_A_Outrolost_Thufir_3_0",
											"translation_notes": "Speaker is Thufir Hawat",
											"voice_notes": "Tone: fierce and determined"
										}
									]
								},
								{
									"variationIndex": 3,
									"target": 0,
									"speeches": [
										{
											"text": "My lord, this territory is lost, but the planet is vast. We can still conquer it.",
											"match": {},
											"sfx": "Voice_Conquest_A_Outrolost_Thufir_4_0",
											"translation_notes": "Speaker is Thufir Hawat\nterritory is a game term",
											"voice_notes": "Tone: fierce and determined"
										}
									]
								}
							]
						},
						{
							"character": "Fenring",
							"pool": [
								{
									"variationIndex": 0,
									"target": 0,
									"speeches": [
										{
											"text": "Forgive my bitterness, Majesty, but seeing this territory fall into enemy hands is... hmm-m-m... deeply disappointing.",
											"match": {},
											"sfx": "Voice_Conquest_C_Outrolost_Hasimir_1_0",
											"translation_notes": "Speaker is Hasimir Fenring\nFenring specifically say \"Majesty\", not \"your majesty\"\nterritory is a game term\nQuote from the book: \"Listening to the man gave Feyd-Rautha the feeling his head was being pushed through mush\".\nCount Fenring may use this strange sounds to annoy his opponent. In English there are translated this way :\n\"When you're mm-m-m ironic, that ah-h-h suggests you're hm-m-m-m thinking deep thoughts\"\n\"Um-m-m-m-m-ah-h-h-hm-m-m, you come upon such, mm-m-m, preciseness so\nrarely,\" the Count said, addressing the Baron's shoulder. \"I . . . ah,\ncongratulate you on the hm-m-m perfection of your ah-h-h heir. In the light of\nthe hm-m-m elder, one might say.\"",
											"voice_notes": "Tone: disappointed"
										}
									]
								},
								{
									"variationIndex": 1,
									"target": 0,
									"speeches": [
										{
											"text": "This never should have happened, Majesty. I offer my most profound apologies. This territory is lost to us.",
											"match": {},
											"sfx": "Voice_Conquest_C_Outrolost_Hasimir_2_0",
											"translation_notes": "Speaker is Hasimir Fenring\nFenring specifically say \"Majesty\", not \"your majesty\"\nterritory is a game term",
											"voice_notes": "Tone mortified, sorry"
										}
									]
								},
								{
									"variationIndex": 2,
									"target": 0,
									"speeches": [
										{
											"text": "We mustn’t waste time regretting the loss of this territory, Majesty. The conquest of Arrakis must continue.",
											"match": {},
											"sfx": "Voice_Conquest_C_Outrolost_Hasimir_3_0",
											"translation_notes": "Speaker is Hasimir Fenring\nFenring specifically say \"Majesty\", not \"your majesty\"\nterritory is a game term",
											"voice_notes": "Tone: formal, serious but also a bit sinister has if he was lying"
										}
									]
								},
								{
									"variationIndex": 3,
									"target": 0,
									"speeches": [
										{
											"text": "Let your enemies savor this victory. It shall be their last.",
											"match": {},
											"sfx": "Voice_Conquest_C_Outrolost_Hasimir_4_0",
											"translation_notes": "Speaker is Hasimir Fenring",
											"voice_notes": "Tone: calm, serious"
										}
									]
								}
							]
						},
						{
							"character": "Tessia",
							"pool": [
								{
									"variationIndex": 0,
									"target": 0,
									"speeches": [
										{
											"text": "Vermillion hells!\nWe have failed! This territory is lost!",
											"match": {},
											"translation_notes": "Speaker is Tessia Vernius",
											"voice_notes": "Tone: upset, angry",
											"sfx": "Voice_Conquest_V_Outrolost_Tessia_1_0"
										}
									]
								},
								{
									"variationIndex": 1,
									"target": 0,
									"speeches": [
										{
											"text": "Despite this defeat, you must not lose sight of your broader goal of conquering Arrakis. Don't lose heart – you can still crush any enemy.",
											"match": {},
											"translation_notes": "Speaker is Tessia Vernius",
											"voice_notes": "Tone: gentle as she was comforting her husband",
											"sfx": "Voice_Conquest_V_Outrolost_Tessia_2_0"
										}
									]
								},
								{
									"variationIndex": 2,
									"target": 0,
									"speeches": [
										{
											"text": "Our will shall not be broken by the loss of a single territory. We have great plans for this planet and for House Vernius. No temporary defeat will stop us.",
											"match": {},
											"translation_notes": "Speaker is Tessia Vernius",
											"voice_notes": "Tone: gentle as she was comforting her husband",
											"sfx": "Voice_Conquest_V_Outrolost_Tessia_3_0"
										}
									]
								},
								{
									"variationIndex": 3,
									"target": 0,
									"speeches": [
										{
											"text": "Let your enemies rejoice today, my love. We shall have our revenge. We will come back even stronger and more determined to drive them from Arrakis.",
											"match": {},
											"translation_notes": "Speaker is Tessia Vernius",
											"voice_notes": "Tone: despising toward her ennemies, then determined and fierce",
											"sfx": "Voice_Conquest_V_Outrolost_Tessia_4_0"
										}
									]
								}
							]
						},
						{
							"character": "Staban",
							"pool": [
								{
									"variationIndex": 0,
									"target": 0,
									"speeches": [
										{
											"text": "We lacked ambition, Father! This territory should have been ours!",
											"match": {},
											"translation_notes": "Speaker is Staban",
											"voice_notes": "Tone: bitter, upset, frustrated (could sound like a small child)",
											"sfx": "Voice_Conquest_S_Outrolost_Staban_1_0"
										}
									]
								},
								{
									"variationIndex": 1,
									"target": 0,
									"speeches": [
										{
											"text": "Impossible! How could those outsiders have pushed us back? Where did we go wrong?",
											"match": {},
											"translation_notes": "Speaker is Staban",
											"voice_notes": "Tone: astonished, cannot believe his eye, a bit scared, does not understand",
											"sfx": "Voice_Conquest_S_Outrolost_Staban_2_0"
										}
									]
								},
								{
									"variationIndex": 2,
									"target": 0,
									"speeches": [
										{
											"text": "I have given the order to retreat. You can rely on the men to avoid capture, but everything we have built in this territory is lost.",
											"match": {},
											"translation_notes": "Speaker is Staban",
											"voice_notes": "Tone: disappointed, bitter, dark",
											"sfx": "Voice_Conquest_S_Outrolost_Staban_3_0"
										}
									]
								},
								{
									"variationIndex": 3,
									"target": 0,
									"speeches": [
										{
											"text": "Perhaps we will regain this territory one day. I shall strive to maintain the patience you have taught me.",
											"match": {},
											"translation_notes": "Speaker is Staban",
											"voice_notes": "Tone: trying to look mature and wise but sad and disappointed",
											"sfx": "Voice_Conquest_S_Outrolost_Staban_4_0"
										}
									]
								}
							]
						},
						{
							"character": "Stilgar",
							"pool": [
								{
									"variationIndex": 0,
									"target": 0,
									"speeches": [
										{
											"text": "This territory is in our enemies' hands. The sietches are no more. As Shai-Hulud has chosen.",
											"match": {},
											"translation_notes": "Speaker is Stilgar",
											"voice_notes": "Tone: resigned, sad",
											"sfx": "Voice_Conquest_F_Outrolost_Stilgar_1_0"
										}
									]
								},
								{
									"variationIndex": 1,
									"target": 0,
									"speeches": [
										{
											"text": "The taste of this defeat sours us, sister. We have failed to liberate these lands from your enemies.",
											"match": {},
											"translation_notes": "Speaker is Stilgar\n\n\"the taste of it sours us\" is a quote from the book",
											"voice_notes": "Tone: resigned, sad",
											"sfx": "Voice_Conquest_F_Outrolost_Stilgar_2_0"
										}
									]
								},
								{
									"variationIndex": 2,
									"target": 0,
									"speeches": [
										{
											"text": "<i>La la la…</i> Let us not spill water for the dead, sister. Our friends shall be avenged.",
											"match": {},
											"translation_notes": "Speaker is Stilgar\n\n\"La la la\" is a fremen cry of grief, from the book",
											"voice_notes": "Tone: trying to not look too sad, then determined\n\"La la la\" is a fremen cry of grief, from the book",
											"sfx": "Voice_Conquest_F_Outrolost_Stilgar_3_0"
										}
									]
								},
								{
									"variationIndex": 3,
									"target": 0,
									"speeches": [
										{
											"text": "The surviving tribes are fleeing in our direction. Promise them worthy vengeance, and they will forgive you for the loss of their sietch.",
											"match": {},
											"translation_notes": "Speaker is Stilgar",
											"voice_notes": "Tone: calm, serious, then determined",
											"sfx": "Voice_Conquest_F_Outrolost_Stilgar_4_0"
										}
									]
								}
							]
						}
					],
					"from": 0,
					"props": {},
					"flags": 0
				},
				{
					"id": "Outro_Win_Doomed",
					"speechesPerSpeaker": [
						{
							"character": "Stilgar",
							"pool": [
								{
									"variationIndex": 0,
									"target": 0,
									"speeches": [
										{
											"text": "The Accursed Sietch is no more, but the Iduali are still swarming about. How long will it be until these parasites regroup to attack our tribes? None of the Fremen will sleep soundly tonight.",
											"match": {},
											"translation_notes": "The Speaker is Stilgar\nIduali is a book term, invariable in english but it might vary per language. It is an insult in the fremen language meaning \"Water Insect\" that is exclusively used againt the Cast Out fremen present in Children of Dune\nAccursed Sietch is the in-game name of the sietch in this battle, please use the same name in this text as for the AccursedSietch structure",
											"voice_notes": "Tone: concerned, dark. This is not a victory",
											"sfx": "Voice_Conquest_F_Doomsietch_Stilgar_1_1"
										}
									]
								}
							]
						}
					],
					"from": 2,
					"flags": 0,
					"props": {}
				},
				{
					"id": "Outro_Win_Doomed_Secondary",
					"speechesPerSpeaker": [
						{
							"character": "Stilgar",
							"pool": [
								{
									"variationIndex": 0,
									"target": 0,
									"speeches": [
										{
											"text": "We have finished what my great-great-grandfather and his brethren began. The Accursed Sietch is no more, and the Iduali will never be a threat to the Fremen again. You have succeeded, sister.",
											"match": {},
											"translation_notes": "The Speaker is Stilgar\nIduali is a book term, invariable in english but it might vary per language. It is an insult in the fremen language meaning \"Water Insect\" that is exclusively used againt the Cast Out fremen present in Children of Dune\nAccursed Sietch is the in-game name of the sietch in this battle, please use the same name in this text as for the AccursedSietch structure",
											"voice_notes": "Tone: very proud of his sister, relieved",
											"sfx": "Voice_Conquest_F_Doomsietch_Stilgar_1_4"
										}
									]
								}
							]
						}
					],
					"from": 2,
					"flags": 0,
					"props": {}
				},
				{
					"id": "ConquestIntro_Atreides",
					"speechesPerSpeaker": [
						{
							"character": "Thufir",
							"pool": [
								{
									"variationIndex": 0,
									"target": 0,
									"speeches": [
										{
											"text": "The moment has come, sire. The conquest of Arrakis is ready to begin.\nThe men are in good spirits, but they’re uneasy. They don’t know what to expect in a world so different from their own. Men who know only oceans and skies must now fight for control of a world covered in desert.\nEven so, I can promise they will follow you, no matter what you decide to do. Under your command, they will make this world into a new home for House Atreides.",
											"match": {},
											"sfx": "Voice_Conquest_A_Intro_Thufir_1_0",
											"translation_notes": "Speaker is Thufir Hawat",
											"voice_notes": "Tone: serious, reporting the situation. Formal at first then more and more hopeful"
										}
									]
								}
							]
						}
					],
					"from": 2,
					"props": {},
					"flags": 1
				},
				{
					"id": "ConquestIntro_Harkonnen",
					"speechesPerSpeaker": [
						{
							"character": "Piter",
							"pool": [
								{
									"variationIndex": 0,
									"target": 0,
									"speeches": [
										{
											"text": "Arrakis... How ironic that such a sterile planet should be the source of such great power! A desert world, arid, crawling with reeking clods, yet by some twist of fate, the most coveted world in the Imperium.\r\nExploiting its spice has made House Harkonnen rich beyond measure for decades. It might even have offered you a directorship in the CHOAM. If only the Emperor hadn’t ordered you to leave...\r\nBut you’re not ready to give up, are you, Baron?",
											"match": {},
											"sfx": "Voice_Conquest_H_Intro_Piter_1_0",
											"translation_notes": "Speaker is Piter de Vries\nCHOAM is a game and book term\nBaron is a book term (Baron Vladimir Harkonnen)",
											"voice_notes": "Tone: thinking, dreaming. Smiling, cruel, maybe taunting on the last sentence"
										}
									]
								}
							]
						}
					],
					"from": 2,
					"props": {},
					"flags": 1
				},
				{
					"id": "ConquestIntro_Corrino",
					"speechesPerSpeaker": [
						{
							"character": "Fenring",
							"pool": [
								{
									"variationIndex": 0,
									"target": 0,
									"speeches": [
										{
											"text": "The Guild informs me that your troops have safely arrived in orbit over Arrakis. The Sardaukar are ready to disembark. The conquest of Arrakis will begin on your command, Majesty.\nYour enemies aren’t expecting your arrival, but they will react to it with violence. No Emperor has ever decided to harvest the planet himself. The resistance of the Landsraad Houses will be just as ferocious as that of the locals.",
											"match": {},
											"sfx": "Voice_Conquest_C_Intro_Hasimir_1_0",
											"translation_notes": "Speaker is Hasimir Fenring\nFenring specifically say \"Majesty\", not \"your majesty\"\nThe Guild is a book term (Spacing Guild)\nSardaukar is a book term (Sardaukar is invariable in english but it might vary by language)",
											"voice_notes": "Tone: formal, serious, respectful. A bit worried on the last part, preoccupied or even doubting"
										}
									]
								}
							]
						}
					],
					"from": 2,
					"props": {},
					"flags": 1
				},
				{
					"id": "ConquestIntro_Ecaz",
					"speechesPerSpeaker": [
						{
							"character": "Sanya",
							"pool": [
								{
									"variationIndex": 0,
									"target": 0,
									"speeches": [
										{
											"text": "We cannot leave Arrakis in the hands of an enemy House. The influence conferred by the spice within the Imperium is too dangerous.\nAnd once they have accepted our supremacy, Mother, I’d venture we'll find a way to make this sterile world much more bearable.",
											"match": {},
											"sfx": "Voice_Conquest_E_Intro_Sanya_1_0",
											"translation_notes": "Speaker is Sanya Ecaz\n",
											"voice_notes": "Tone: arrogant, confident"
										}
									]
								}
							]
						}
					],
					"from": 2,
					"props": {},
					"flags": 1
				},
				{
					"id": "ConquestIntro_Vernius",
					"speechesPerSpeaker": [
						{
							"character": "Tessia",
							"pool": [
								{
									"variationIndex": 0,
									"target": 0,
									"speeches": [
										{
											"text": "Our machines have detected the presence of other Great Houses on Arrakis. They have already deployed their Bases, but we have no reason to think they have any real advantage over us yet. We, on the other hand, have our Ixian technology. None of your enemies is prepared to face us. Victory will be ours, my love.\nWe mustn't hesitate, and there's no turning back now. The spice war is imminent.",
											"match": {},
											"translation_notes": "Speaker is Tessia Vernius",
											"voice_notes": "Tone: serious and calm, as she was reading a report. When she starts talking about their technology she becomes more and more confident and proud. On the last sentence she is gently pushing her husband (who tends to avoid action)",
											"sfx": "Voice_Conquest_V_Intro_Tessia_1_0"
										}
									]
								}
							]
						}
					],
					"from": 2,
					"flags": 1,
					"props": {}
				},
				{
					"id": "ConquestIntro_Smugglers",
					"speechesPerSpeaker": [
						{
							"character": "Staban",
							"pool": [
								{
									"variationIndex": 0,
									"target": 0,
									"speeches": [
										{
											"text": "You were right, Father. The Great Houses and their armies have just landed on Arrakis. The impending war will be long and costly for the Landsraad lords.\nMissing out on this conflict would be <i>criminal</i>.\nSmugglers thrive during periods of unrest! Our profits are highest when the smoke of battle shields us! And who knows… When the dust settles, perhaps we will be the new masters of Arrakis.",
											"match": {},
											"translation_notes": "Speaker is Staban",
											"voice_notes": "Tone: at first, very calm, even neutral, as he was watching the scene from a long distance. Then grinning, smilling, arrogant, enthusiastic ",
											"sfx": "Voice_Conquest_S_Introduction_Staban_1_0"
										}
									]
								}
							]
						}
					],
					"from": 2,
					"flags": 1,
					"props": {}
				},
				{
					"id": "ConquestIntro_Fremen",
					"speechesPerSpeaker": [
						{
							"character": "Stilgar",
							"pool": [
								{
									"variationIndex": 0,
									"target": 0,
									"speeches": [
										{
											"text": "The offworlders have come in great numbers to bring war to Dune. They carry different banners and expect to fight one another for control of the spice. They have no idea that we're already here. We, the free people. The men of the desert. The Fremen.",
											"match": {},
											"translation_notes": "Speaker is Stilgar",
											"voice_notes": "Tone: serious then, from \"They have no idea...\" to the end, much more serious and determined, fierce. ",
											"sfx": "Voice_Conquest_F_Introduction_Stilgar_1_0"
										}
									]
								}
							]
						}
					],
					"from": 2,
					"flags": 1,
					"props": {}
				},
				{
					"id": "FactionDefeat",
					"speechesPerSpeaker": [
						{
							"character": "Piter",
							"pool": [
								{
									"variationIndex": 0,
									"target": 0,
									"speeches": [
										{
											"text": "Arrakis has slipped from your grasp once again, Baron, and this time there will be no second chance. The enemy has control of the spice. We have nothing else to hope for on this planet.",
											"match": {},
											"sfx": "Voice_Conquest_H_Factiondefeated_Piter_1_0",
											"translation_notes": "Speaker is Piter de Vries\nBaron is a book term (Baron Vladimir Harkonnen)\nhere \"the enemy\" is neutral (it's a general enemy, not a specific person)",
											"voice_notes": "Tone: serious, sinister, disappointed "
										}
									]
								},
								{
									"variationIndex": 1,
									"target": 0,
									"speeches": [
										{
											"text": "It seems Arrakis has escaped your control, Baron. And this time, you won’t have a second chance. The spice has fallen irreversibly into the enemy’s hands. Your only option now is to withdraw to Giedi Prime, and to hope that your rival doesn’t send their legions to your world in reprisal.",
											"match": {},
											"sfx": "Voice_Conquest_H_Factiondefeated_Piter_2_0",
											"translation_notes": "Speaker is Piter de Vries\nBaron is a book term (Baron Vladimir Harkonnen)\nGiedi Prime is a book term (planet Giedi Prime)",
											"voice_notes": "Tone: serious, taunting carefully. Can have a break between \"hands\" and \"your only option\"."
										}
									]
								}
							]
						},
						{
							"character": "Sanya",
							"pool": [
								{
									"variationIndex": 0,
									"target": 0,
									"speeches": [
										{
											"text": "I have ordered our legions to withdraw from Arrakis. The Spacing Guild is ready to bring us back to Ecaz. I am sorry that your efforts on Arrakis have ended in defeat, but you have fought well, Mother. You have proven yourself worthy of our House.",
											"match": {},
											"sfx": "Voice_Conquest_E_Factiondefeated_Sanya_1_0",
											"translation_notes": "Speaker is Sanya Ecaz\nSpacing Guild is a book term\n",
											"voice_notes": "Tone: first sentence: serious and formal, then, a bit more familiar, sad for her mother"
										}
									]
								}
							]
						},
						{
							"character": "Thufir",
							"pool": [
								{
									"variationIndex": 0,
									"target": 0,
									"speeches": [
										{
											"text": "We must abandon Arrakis, my lord. Your enemy’s conquest of the planet has progressed too far. Let us leave now, while some of our men can still be saved.",
											"match": {},
											"sfx": "Voice_Conquest_A_Factiondefeated_Thufir_1_0",
											"translation_notes": "Speaker is Thufir Hawat\nhere \"your enemy\" is neutral (it's a general enemy, not a specific person)",
											"voice_notes": "Tone: sad, disappoined, but serious and hurrying"
										}
									]
								}
							]
						},
						{
							"character": "Fenring",
							"pool": [
								{
									"variationIndex": 0,
									"target": 1,
									"speeches": [
										{
											"text": "Arrakis is lost, Majesty. The enemy’s grip on this world will soon be complete. To fight on would only waste your men’s lives, at a time when you must save your strength to confront the upheaval this defeat will unleash within the Imperium.",
											"match": {
												"gender": 0
											},
											"sfx": "Voice_Conquest_C_Factiondefeated_Hasimir_1_0",
											"translation_notes": "Speaker is Hasimir Fenring\nFenring specifically say \"Majesty\", not \"your majesty\"\nhere the enemy is masculine",
											"voice_notes": "Tone: formal, calm, but more an more worried"
										},
										{
											"text": "Arrakis is lost, Majesty. The enemy’s grip on this world will soon be complete. To fight on would only waste your men’s lives, at a time when you must save your strength to confront the upheaval this defeat will unleash within the Imperium.",
											"match": {
												"gender": 1
											},
											"sfx": "Voice_Conquest_C_Factiondefeated_Hasimir_1_0",
											"translation_notes": "Speaker is Hasimir Fenring\nFenring specifically say \"Majesty\", not \"your majesty\"\nhere the enemy is feminine",
											"voice_notes": "Tone: formal, calm, but more an more worried"
										}
									]
								}
							]
						},
						{
							"character": "Tessia",
							"pool": [
								{
									"variationIndex": 0,
									"speeches": [
										{
											"text": "All hope of victory is lost, my husband. We must give up.\nContinuing this fight would only bring about the destruction of our House. We must withdraw to Ix. Perhaps we can accomplish there what we have failed to achieve here.",
											"match": {},
											"translation_notes": "Speaker is Tessia Vernius",
											"voice_notes": "Tone: she is sad but tries to comfort her husband",
											"sfx": "Voice_Conquest_V_Factiondefeated_Tessia_1_0"
										}
									],
									"target": 0
								}
							]
						},
						{
							"character": "Stilgar",
							"pool": [
								{
									"variationIndex": 0,
									"speeches": [
										{
											"text": "Our steps have led us down a dark path. This is the end of our people, Liet.\nThese offworlders will destroy what remains of our sietches and seize our water and our land. Our friends' bodies will be swallowed up by the desert, and the Fremen will fade into oblivion.",
											"match": {},
											"translation_notes": "Speaker is Stilgar",
											"voice_notes": "Tone: sad, resigned to die, desperate and fatalistic",
											"sfx": "Voice_Conquest_F_Factiondefeated_Stilgar_1_0"
										}
									],
									"target": 0
								}
							]
						},
						{
							"character": "Staban",
							"pool": [
								{
									"variationIndex": 0,
									"speeches": [
										{
											"text": "We have no choice, Father! We must leave!\nOur Guild contact has agreed to transport us to another planet, and we must seize this opportunity. Leave Arrakis to the Great Houses and Fremen hordes, for we have failed. Their war is no longer our concern!",
											"match": {},
											"translation_notes": "Speaker is Staban",
											"voice_notes": "Tone: fear for his life, pressing his father to live, trying to not panic",
											"sfx": "Voice_Conquest_S_Factiondefeated_Staban_1_0"
										}
									],
									"target": 0
								}
							]
						}
					],
					"from": 0,
					"props": {},
					"flags": 1
				},
				{
					"id": "ConquestWin",
					"speechesPerSpeaker": [
						{
							"character": "Piter",
							"pool": [
								{
									"variationIndex": 0,
									"speeches": [
										{
											"text": "You've won, Baron!\nArrakis is yours! All the spice in the Imperium lies beneath your fingers!",
											"match": {},
											"sfx": "Voice_Conquest_H_Conquestwin_Piter_1_0"
										}
									],
									"target": 0
								}
							]
						},
						{
							"character": "Sanya",
							"pool": [
								{
									"variationIndex": 0,
									"speeches": [
										{
											"text": "Mother! You've succeeded! House Ecaz has conquered Arrakis!\nFor generations, every soul in the Imperium will remember your name.",
											"match": {},
											"sfx": "Voice_Conquest_E_Conquestwin_Sanya_1_0"
										}
									],
									"target": 0
								}
							]
						},
						{
							"character": "Thufir",
							"pool": [
								{
									"variationIndex": 0,
									"speeches": [
										{
											"text": "Arrakis is yours, Sire!\nThe whole planet is under your control. The Atreides have triumphed over their enemies!",
											"match": {},
											"sfx": "Voice_Conquest_A_Conquestwin_Thufir_1_0"
										}
									],
									"target": 0
								}
							]
						},
						{
							"character": "Fenring",
							"pool": [
								{
									"variationIndex": 0,
									"speeches": [
										{
											"text": "Majesty, I'm honored to report that Arrakis is yours. Nobody will be able to oppose you ever again.",
											"match": {},
											"sfx": "Voice_Conquest_C_Conquestwin_Hasimir_1_0"
										}
									],
									"target": 0
								}
							]
						},
						{
							"character": "Tessia",
							"pool": [
								{
									"variationIndex": 0,
									"speeches": [
										{
											"text": "My husband, you have won. You are the master of Arrakis.\nThe winds of change will soon sweep over the entire Imperium.",
											"match": {},
											"translation_notes": "Speaker is Tessia Vernius",
											"voice_notes": "Tone: satisfied, pleased, smiling.",
											"sfx": "Voice_Conquest_V_Conquestwin_Tessia_1_0"
										}
									],
									"target": 0
								}
							]
						},
						{
							"character": "Staban",
							"pool": [
								{
									"variationIndex": 0,
									"speeches": [
										{
											"text": "Those who considered us mere thieves must now bend to our will! Our influence over the Empire and the Landsraad is unrivaled, for we have a stranglehold on their precious spice trade!\r\nYou have played your cards skillfully, Father. You are the new master of Arrakis.",
											"match": {},
											"translation_notes": "Speaker is Staban",
											"voice_notes": "Tone: triumphant, arrogant, proud and happy",
											"sfx": "Voice_Conquest_S_Conquestwin_Staban_4_0"
										}
									],
									"target": 0
								}
							]
						},
						{
							"character": "Stilgar",
							"pool": [
								{
									"variationIndex": 0,
									"speeches": [
										{
											"text": "The offworlders are leaving! Their ships are returning to the stars!\nSister! You have succeeded! Dune has returned to the Fremen, and your father's dream lives on.",
											"match": {},
											"translation_notes": "Speaker is Stilgar",
											"voice_notes": "Tone: relieved, grateful, screaming at first (as if he was watching the ships leaving) and talking directly to Liet : proud, moved, happy",
											"sfx": "Voice_Conquest_F_Conquestwin_Stilgar_1_0"
										}
									],
									"target": 0
								}
							]
						}
					],
					"from": 0,
					"props": {},
					"flags": 1
				}
			],
			"separators": [],
			"props": {
				"editor": {
					"categories": [
						"Dialog",
						"Conquest"
					]
				}
			}
		},
