					"speechesPerSpeaker": [
						{
							"character": "ReverendMother",
							"pool": [
								{
									"variationIndex": 0,
									"target": 0,
									"speeches": [
										{
											"text": "The Bene Gesserit know you are eyeing this territory and are willing to help you get it. We ask for only one thing in exchange: its supervisor's death.",
											"match": {},
											"sfx": "Voice_Conquest_Neutral_Cuttingtheheadoff_Benegesserit_1_0",
											"translation_notes": "Speaker is an unnamed Reverand Mother of the Bene Gesserit\nBene Gesserit is a book term",
											"voice_notes": "Tone: neutral, calm. Maybe a bit more violent or sombre or sinister on the last sentence."
										}
									]
								},
								{
									"variationIndex": 1,
									"target": 0,
									"speeches": [
										{
											"text": "Your interests align with those of the Bene Gesserit: The supervisor of this territory must die. We are prepared to send you agents in exchange for his assassination.",
											"match": {},
											"sfx": "Voice_Conquest_Neutral_Cuttingtheheadoff_Benegesserit_2_0",
											"translation_notes": "Speaker is an unnamed Reverand Mother of the Bene Gesserit\nBene Gesserit is a book term\nagent is a game term",
											"voice_notes": "Tone: calm, formal"
										}
									]
								}
							]
						}
					],
					"props": {},
					"flags": 0
