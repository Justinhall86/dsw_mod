		{
			"name": "loadingTips",
			"columns": [
				{
					"typeStr": "0",
					"name": "id",
					"kind": null,
					"scope": null
				},
				{
					"typeStr": "1",
					"name": "desc",
					"kind": "localizable"
				},
				{
					"typeStr": "10:Skirmish,Kanly,Conquest,Multi,Solo,Teams,NoTeams,Gamepad,NotGamepad,Spectator,NotSpectator",
					"name": "blockIf"
				},
				{
					"typeStr": "17",
					"name": "props",
					"kind": null
				}
			],
			"lines": [
				{
					"id": "LT_MaintenanceCenter",
					"desc": "[MaintenanceCenter]s are an excellent way to reduce [!Upkeep]. Try to cover your territory with their effect.",
					"props": {
						"notForFactions": [
							{
								"ref": "Corrino"
							}
						]
					},
					"blockIf": 0
				},
				{
					"id": "LT_Crews",
					"desc": "Add crew to your [Harvester]s to increase their daily yield of [Spice].",
					"props": {},
					"blockIf": 0
				},
				{
					"id": "LT_OrniOnHarvester",
					"desc": "Assign an [Ornithopter] to a [Harvester] to detect [Sandworm]s and reduce its chance of being eaten.",
					"props": {
						"notForFactions": [
							{
								"ref": "Fremen"
							}
						]
					},
					"blockIf": 0
				},
				{
					"id": "LT_HarvestingTent",
					"desc": "[Fremen] [F_Harvester_Mobile]s are built directly from the units interface. They can exploit any neutral or controlled [SpiceArea]s.",
					"props": {
						"onlyForFactions": [
							{
								"ref": "Fremen"
							}
						]
					},
					"blockIf": 0
				},
				{
					"id": "LT_MultiSaves",
					"desc": "You can save multiplayer games. Load them through the \"LOAD SAVE\" button in the Multiplayer screen, and invite the game's players to finish it.",
					"props": {},
					"blockIf": 528
				},
				{
					"id": "LT_Pause",
					"desc": "Feeling overwhelmed? You can always pause the game by pressing [Time_PauseResume] or clicking the pause icon in the upper right corner.",
					"props": {},
					"blockIf": 136
				},
				{
					"id": "LT_Pause_Controller",
					"desc": "Feeling overwhelmed? You can always pause the game by pressing [Time_PauseResume].",
					"blockIf": 264,
					"props": {}
				},
				{
					"id": "LT_Ping",
					"desc": "To catch the attention of your teammates on a position, ping them with [Ping_Team].",
					"blockIf": 208,
					"props": {}
				},
				{
					"id": "LT_SpiceSlider",
					"desc": "The slider next to [Spice] production can be raised or lowered to change how much [Spice] is sold to the CHOAM or stockpiled to fulfill your contract.",
					"props": {},
					"blockIf": 0
				},
				{
					"id": "LT_RockyGroundVSSandworm",
					"desc": "Sandworms cannot eat your units if they are on rocky ground or near a cliff.",
					"props": {},
					"blockIf": 0
				},
				{
					"id": "LT_WatchOutForUpkeep",
					"desc": "Military and Statecraft buildings have higher [!Upkeep]. Be sure to not build more than you can afford.",
					"props": {},
					"blockIf": 0
				},
				{
					"id": "LT_Keybindings",
					"desc": "You can see and change every key binding in the options.",
					"props": {},
					"blockIf": 128
				},
				{
					"id": "LT_Destroy",
					"desc": "If your economy is slow, it might be a good idea to destroy a few buildings with high [!Upkeep]. You will be refunded a part of their cost.",
					"props": {},
					"blockIf": 0
				},
				{
					"id": "LT_Experience",
					"desc": "Military units participating in a kill earn experience points. With enough points they'll gain a level, increasing their strength.",
					"props": {},
					"blockIf": 0
				},
				{
					"id": "LT_DontGiveUp",
					"desc": "Losing a battle is not losing the war. Skirmishes are never lost before you can see the Defeat screen.",
					"blockIf": 50,
					"props": {}
				},
				{
					"id": "LT_DiploMulti",
					"desc": "There are many ways leading to victory. Winning in skirmish is often more about appearing unthreatening and manipulating your opponents than being outright stronger.",
					"blockIf": 50,
					"props": {}
				}
			],
			"separators": [],
			"props": {
				"editor": {
					"categories": [
						"UserXp",
						"Localization"
					]
				}
			}
		},
