			"lines": [
				{
					"id": "PlayerLessVillages",
					"options": [],
					"regularScore": 2,
					"conditionsComment": "IA beaucoup plus de villages > 2",
					"scoreComment": "1 par différence au dessus de 2\r",
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "I have to warn you: do not leave all the land to us. For I assure you that we will take it."
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": "There is no shame in admitting one's own limitations. For you, undoubtedly, managing a handful of barren and derelict hamlets should be hard enough."
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": "In commerce, territory is crucial. I'm eager to trade with you more but how could I, if your presence is so rare and your villages so scarce?"
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": "Vital resources are scarce on Arrakis. How can your people find what they need when the narrowness of your territory forces them to stay in one place?"
								}
							]
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "I don't care much for these villages. But you should."
								}
							]
						}
					],
					"conditions": {
						"lessVillages": 2
					},
					"implemented": true,
					"props": {},
					"weight": 1
				},
				{
					"id": "PlayerMoreVillages",
					"options": [],
					"name": "",
					"conditionsComment": "Joueur beaucoup plus de villages > 2",
					"regularScore": 2,
					"scoreComment": "1 par différence au dessus de 2\r",
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "There is no point in snatching land if you won't exploit it properly. Why expand so much?"
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": "How I envy these carefree tribal chiefs who impulsively seek to expand their colonies... never asking themselves how they could ever defend such a large and unattended territory."
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": "What do I care if your official territory is broader than mine? No matter who controls the village, I'll settle in anyway. I'm at home everywhere!"
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": "All living systems need balance. How could a territory as broad and disunited as yours flourish? Further growth would cause it to shrivel."
								}
							]
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "Your expansion is a good thing. As long as your only goal is to pay your dues to the Imperium."
								}
							]
						}
					],
					"conditions": {
						"moreVillages": 2
					},
					"implemented": true,
					"props": {},
					"weight": 1
				},
				{
					"id": "AdjacentPlayerTerritory",
					"options": [],
					"conditionsComment": "Zones controllée par enemie adjacentes",
					"regularScore": 1,
					"scoreComment": "1 si oui, 2 si nb > 3\r",
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "As neighbors, we will have to deal with each other. Let us work to keep it cordial."
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": "My dearest neighbor, don't you enjoy seeing our territories steadily get closer? Should these borders vanish completely, it would make me a very contented leader."
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": "I appreciate how close our territories are, my neighbor! The shorter the distance, the more vivacious the exchange!"
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": "We are close. Our territories are contiguous and we are bound to influence each other. Whether this interaction proves fruitful or noxious is up to us."
								}
							]
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "It seems we are neighbors. It will make it easy for you to show your allegiance."
								}
							]
						}
					],
					"conditions": {
						"adjacentTerritory": 2
					},
					"implemented": true,
					"props": {},
					"weight": 2
				},
				{
					"id": "AdjacentBonifiedPlayerTerritory",
					"options": [],
					"conditionsComment": "Zone bonifiées controllée par IA adjacentes\r",
					"name": "",
					"regularScore": 1,
					"scoreComment": "1 par zone\r",
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "I noticed you were neglecting this valuable territory. Such a waste! I took the liberty to exploit it."
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": "You seem curious about my precious deposits... I understand how alien they might seem to underprivileged eyes, but staring at them will not make you any richer."
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": "Were you interested in these deposits? I'm sorry! They seemed unattended, so I took care of them. But should you need the resource, I'd gladly provide it for a price!"
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": "Do not envy us. Just because we can take advantage of this prolific sector does not mean you could extract the same benefits from it."
								}
							]
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "You are my vassal. As such you should take good care of the territories your are bestowed."
								}
							]
						}
					],
					"conditions": {
						"bonifiedAdjacentTerritory": 1
					},
					"implemented": true,
					"props": {},
					"weight": 3
				},
				{
					"id": "PlayerAdjacentBonifiedTerritory",
					"options": [],
					"conditionsComment": "Zone bonifiées controllée par joueur adjacentes\r",
					"name": "",
					"regularScore": 1,
					"scoreComment": "1 par zone",
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "Do you expect us to sit here and watch while you appropriate every relevant resource in the region? "
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": "How very obliging of you to charitably attend this valuable land, knowing how soon it could slip out of your control... That shows genuine altruism. "
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": "I admire the richness of your resource deposits, partner! How can I help you take advantage of them?"
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": "How wasteful! Indeed, you glean meager profits from these deposits. But will it ever compensate the losses you occasion by misusing them?"
								}
							]
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "I thank you for exploiting these lands in my name."
								}
							]
						}
					],
					"conditions": {
						"bonifiedOwnedTerritory": 1
					},
					"implemented": true,
					"props": {},
					"weight": 3
				},
				{
					"id": "AdjacentPlayerPoleRegion",
					"options": [],
					"conditionsComment": "Zone pôle adjacente",
					"name": "",
					"regularScore": 1,
					"scoreComment": "1\r",
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "We all depend on the pole. Hence, we all want strategic access to it. "
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": "The pole... if there is anything workable on this wretched planet, it tenuously depends on that dull chunk of ice... I need it."
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": "Sure, being close to the pole is always convenient, but through the smugglers' network, its water reaches most of Arrakis. We are bringing the pole to everyone!"
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": "The pole is crucial. You will never know peace while you control it, but you have no chance of survival unless you can employ its water."
								}
							]
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "The water from the polar sink is mine. As is this planet. As are your lives."
								}
							]
						}
					],
					"conditions": {
						"adjacentPoleTerritory": true
					},
					"implemented": true,
					"props": {},
					"weight": 3
				},
				{
					"id": "PoleVillage",
					"options": [],
					"conditionsComment": "Pôle scouté avec un Outpost controlé par le joueur",
					"regularScore": 2,
					"scoreComment": "2 par Outpost pour les IA adjacentes au pole",
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "So it seems you preceded us here. I respect that. But you should know water is too crucial to be hoarded."
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": "I reckon you have appointed yourself as the pole's administrator... You did well! Very well, indeed. I would not want this responsibility to fall on the shoulders of someone powerful."
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": "It's good that you're in control of the pole, companion. I have interests here too. We should definitely work together!"
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": "So be it. You might as well use the pole, since your subsistence depends on it. Not everyone needs such abundant water."
								}
							]
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "Well, it seems you have settled in the polar region. Don't forget this is all in my name, and that all resources here are truly mine."
								}
							]
						}
					],
					"conditions": {
						"villageInPole": true
					},
					"implemented": true,
					"props": {},
					"weight": 3
				},
				{
					"id": "RebellionPlayerVillage",
					"options": [],
					"conditionsComment": "Village humain scouté en révolte",
					"scoreComment": "5 à la faction ennemie la plus proche du village",
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "You are ruining these villages. If thirst is killing people under your rule, you have to take responsibility. Make things right or leave."
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": "How creative... While we all go through the trouble of collecting water, you found your own inexhaustible spring: the tears of your miserable people. Hilarious! \"Let them drink salt!\""
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": "Being a ruler and being a merchant is the same: you have to know what people want, and provide it! Right now, it seems your people are craving for water."
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": "This is appalling! Your presence on Arrakis was already questionable enough when you were not causing water shortages."
								}
							]
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "How can you not manage the pyons and their villages? A Kulon would do a better job than you!"
								}
							]
						}
					],
					"implemented": false,
					"props": {},
					"eventConditions": [
						{
							"ref": "Rebellion",
							"conditions": {
								"instigator": 1
							},
							"score": 20,
							"duration": 10
						}
					],
					"weight": 3
				},
				{
					"id": "AdjacentPlayerRefineries",
					"options": [],
					"scoreComment": "2 par raffinerie\r",
					"conditionsComment": "Raffineries dans zone adjacente\r",
					"regularScore": 2,
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "Your cargos are so close. I smell the spice they carry. I cannot guarantee this won't make me envious."
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": "I could never get bored of observing this refinery of yours. The mismanagement, the clownish workflow... your vulnerable men begging the worms to devour them... Thank you kindly for the entertainment."
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": "I couldn't help noticing this refinery of yours, just outside my territory. Running decently... but it could get better! Surely, you wouldn't mind if I gave you a hand?"
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": "Interesting. As I witness the continuous motion of your cargos about our land, I am reminded of how unnatural your presence is on Arrakis. This spice should be ours."
								}
							]
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "Good to see your harvesting is going strong. Although I have settled nearby and might think of cutting the middleman."
								}
							]
						}
					],
					"conditions": {
						"adjacentRefineries": 1
					},
					"implemented": true,
					"props": {},
					"weight": 2
				},
				{
					"id": "AdjacentPlayerMilitaryBases",
					"options": [],
					"scoreComment": "1 par base militaire\r",
					"conditionsComment": "Base militaire joueur dans zone adjacente\r",
					"regularScore": 2,
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "Hold no illusion. I can see you. And I can see this military base."
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": "This is yet another interesting choice. To erect your precious military base at this exact, singular spot, precisely within range of my avenging arm... I have to admire your boldness."
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": "A military base? Here? Why protect your border against me, if you know I'm already on both sides? Your people is my people, partner."
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": "I see. Does this military base indicate an ambition to control us? You would not be the first to try, and not unlike your predecessors, you seem to underestimate the Fremen."
								}
							]
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "I don't think you need a military base. I am no threat to you. And you certainly are no threat to me."
								}
							]
						}
					],
					"conditions": {
						"adjacentMilitaryBases": 1
					},
					"implemented": true,
					"props": {},
					"weight": 2
				},
				{
					"id": "PlayerAdjacentAIMilitaryBases",
