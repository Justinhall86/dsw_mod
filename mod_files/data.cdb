			"columns": [
				{
					"typeStr": "4",
					"name": "powerRatio",
					"opt": true,
					"documentation": "Ratio of power of the unit applied to the attack's damage\nDefault is 1"
				},
				{
					"typeStr": "3",
					"name": "powerOverride",
					"opt": true,
					"documentation": "Damage to apply on attack. The attack will deal flat damage (not influenced by the attacker power modifiers). Is not inflenced by `dmgRatio` neither."
				},
				{
					"typeStr": "4",
					"name": "duration",
					"documentation": "Time in seconds during which the unit will not be able to attack\nIf duration is 0, the next part of the sequence will be started on the same frame\nDefault is Army_Attack_Time",
					"opt": true
				},
				{
					"typeStr": "4",
					"name": "windUp",
					"documentation": "Time between the attack start and the trigger of its effects\nDefault is Army_Attack_WindUp",
					"opt": true
				},
				{
					"typeStr": "4",
					"name": "lockStart",
					"documentation": "Time after which the unit is locked in the attack and cannot exit it"
				},
				{
					"typeStr": "4",
					"name": "lockEnd",
