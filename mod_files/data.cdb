								"title": "Ally and protect the Sietch",
								"desc": "",
								"effects": [
									{
										"vals": [
											{
												"val": 2,
												"comment": ""
											}
										],
										"target": {
											"blackboard": "BattleVar"
										},
										"target2": {},
										"ref": "Blackboard_SetVal",
										"displayed": false
									}
								],
								"props": {}
							}
						]
					},
					"speakers": [
						{
							"character": "FremenCaptain"
						}
					]
				},
				{
					"id": "CB_AncientSietch_DecideFate_NoHostileLeft",
					"title": "The Ancient Sietch's fate",
					"mainText": "",
					"popupPages": [
						{
							"id": "CBAS1",
							"text": "You found our sacred sietch. Now what, offworlder? Some of us hope you might be better than the others. What do you have to say?",
							"highlight": {},
							"overrides": [],
							"notes": ""
						}
					],
					"speakers": [
						{
							"character": "FremenCaptain"
