					"opt": true,
					"kind": null
				},
				{
					"typeStr": "6:raid",
					"name": "rebellionRaid",
					"opt": true,
					"kind": null
				},
				{
					"typeStr": "17",
					"name": "worldEvent",
					"opt": true,
					"kind": null
