					"mainText": "",
					"popupPages": [
						{
							"id": "M213",
							"text": "Assigning an [Ornithopter] to [A_Harvester]s allows for the use of [!Safe_Harvester] and reduce the chance of losing [A_Harvester]s in [!Greedy_Harvester].",
							"highlight": {},
							"overrides": [],
