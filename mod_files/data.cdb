				{
					"id": "PlayerVoteAgainstAI",
					"options": [],
					"conditionsComment": "Vote négatif contre IA\r",
					"scoreComment": "nb Vote\r",
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "What could have motivated this ill-advised vote? We will make sure you regret this offense and learn your place very soon."
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": "Your attempts at infuriating me are futile! Oppose me while you can... sanctions will come soon enough."
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": "How could you vote against me? This is betrayal! Come on, don't you know the influence I have on your territory?"
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": "You fool! Why use the Landsraad to persecute us? When we have so many ways of tormenting you and recurrently refrained from using them?"
								}
							]
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "Well, I can't really say I am surprised. Your inconstance and lack of respect is nonetheless noted."
								}
							]
						}
					],
					"implemented": true,
					"eventConditions": [
