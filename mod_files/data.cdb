				},
				{
					"id": "PlayerMoreHegemony",
					"options": [],
					"conditionsComment": "Joueur plus d'Hegemony que IA\r",
					"scoreComment": "X, facteur multiplicatif\r",
					"regularScore": 1,
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "We acknowledge your current vantage in the run for domination. It seems chance has favored you for now. But do not count us out."
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": "Indeed, you are purportedly leading the race for sovereignty! It is so easy to run empty-handed... but wherever you seem to be heading, a harsh surprise is awaiting you there."
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": "You have garnered a reputation of great predominance on Arrakis! Me, I work in the shadows. That's how we differ. The more hidden my power remains, the greater it is."
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": "You are towering above us. But you are not the first hegemonic power to set foot on Arrakis. Why would you be the first to subsist?"
								}
							]
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "Your progress on Arrakis is impressive. I would only advise you not to cast a shadow on your emperor. That would be ill-advised."
								}
							]
						}
					],
					"conditions": {
						"moreHegemony": 2000
					},
					"implemented": true,
					"props": {},
					"weight": 1
				},
				{
					"id": "PlayerLessHegemony",
					"options": [],
					"conditionsComment": "IA plus d'Hegemony que joueur",
					"scoreComment": "X, facteur multiplicatif",
					"regularScore": 1,
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "We are currently dominating Arrakis. The reasonable option for you right now would be to stay in our good books."
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": "It will not come as a surprise: we dominate you. I am not sure what you hoped for on Arrakis, but I am certain of what you will end up with."
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": "Be reassured. Just because my superiority strengthens doesn't mean I will disavow our shared interests and partnership. You may witness a slight increase in prices, though."
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": "Arrakis. More than any environment, it demands observation, endurance and abnegation. We prevail because we cultivate these qualities while you still struggle to understand them. Hegemony is ours."
								}
							]
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "It is good to see everyone is at its appointed place. With me on top of the pyramid."
								}
							]
						}
					],
					"conditions": {
						"lessHegemony": 2000
					},
					"implemented": true,
					"props": {},
					"weight": 1
				},
				{
					"id": "UWHQInPlayerVillage",
					"options": [],
					"conditionsComment": "Underground City IA chez le joueur\r",
					"scoreComment": "1 par underground city\r",
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": ""
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": ""
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": "You might soon notice some changes in your territory's underground life. But it won't be long until you recognize how beneficial my presence is!"
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": ""
