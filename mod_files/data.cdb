					"trigger": {}
				},
				{
					"id": "CB_CuttingTheHead_1",
					"title": "Cutting the head off",
					"mainText": "",
					"popupPages": [
						{
							"id": "CBAS1",
							"text": "A snake has invited itself on Arrakis. The [::territory_owner::-adjective] supervisor of [::territory::] is a threat to both our plans and yours. We can help you remove him.",
							"highlight": {},
							"overrides": [],
							"notes": ""
						}
					],
					"speakers": [
						{
							"character": "ReverendMother"
						}
					],
					"flags": 0,
					"props": {
						"position": 2
					},
					"trigger": {}
				},
				{
					"id": "CB_CuttingTheHead_2",
					"title": "Cutting the head off",
					"mainText": "",
					"popupPages": [
						{
							"id": "CBAS1",
							"text": "Now that we know of their secrets, the path forward is clear. Only start the assassination when you are ready. We cannot afford to waste time with failure.",
							"highlight": {},
							"overrides": [],
							"notes": ""
						}
					],
					"speakers": [
						{
							"character": "ReverendMother"
						}
					],
					"flags": 0,
					"props": {
						"position": 2
					},
					"trigger": {}
				},
				{
					"id": "CB_AncientSietch_1",
					"title": "The Ancient Sietch",
					"mainText": "",
					"popupPages": [
						{
							"id": "CBAS1",
							"text": "",
							"overrides": [
								{
									"text": "My fremen contacts have told me that a [Sietch] in the region has special value to the local population. We should try to find out more about this [SietchAncient] before it falls into the wrong hands.",
									"character": "Duncan",
									"notes_overrides": ""
								},
								{
									"text": "I heard a rumor that a certain [Sietch] hidden in this region holds an especially great value. We should find this [SietchAncient] before the other houses.\n\nWho knows what secrets it will contain?",
									"character": "Piter",
									"notes_overrides": ""
								},
								{
									"text": "The story says an [SietchAncient] precious to the Fremen is located in this region. We must find it before a disloyal house gets hold of it.",
									"character": "Irulan",
									"notes_overrides": ""
								},
								{
									"text": "I've heard the fremen are protecting an [SietchAncient] full of secrets and wonders in this region. If we are perceptive enough, we may find it soon enough.",
									"character": "Mesa",
									"notes_overrides": ""
								}
							],
							"highlight": {},
							"notes": ""
						}
					],
					"speakers": [
						{
							"faction": "Atreides",
							"character": "Duncan"
						},
						{
							"faction": "Harkonnen",
							"character": "Piter"
						},
						{
							"faction": "Corrino",
							"character": "Irulan"
						},
						{
							"character": "Mesa",
							"faction": "Ecaz"
						}
					],
					"flags": 0,
					"props": {
						"position": 2
					},
					"trigger": {}
				},
				{
					"id": "CB_Incursion_Hero",
					"title": "Incursion",
					"mainText": "",
					"popupPages": [
						{
							"id": "CBAH1",
							"text": "",
							"highlight": {},
							"overrides": [
								{
									"text": "I'm going to free this place from [::territory_owner::-adjective] influence. Their vigilance is down, they won't have time to react.",
									"character": "Duncan",
									"notes_overrides": ""
								},
								{
									"text": "We got close without [::territory_owner::-shortname] noticing. If we're fast enough, we might avoid a bloodshed. A battle of speed and wit, in the heart of the desert.",
									"character": "Gurney",
									"notes_overrides": ""
								},
								{
									"text": "[::territory_owner::] are too negligent. I'm going to take this place fast and clean.",
									"character": "Aramsham",
									"notes_overrides": ""
								},
								{
									"text": "[::territory_owner::] have not taken good care of this place. If we attack swiftly, they might not be able to react.",
									"character": "Wensicia",
									"notes_overrides": ""
								},
								{
									"text": "They've no idea we're here. I'm gonna break them like little twigs, before they even react.",
									"character": "Glossu",
									"notes_overrides": ""
								},
								{
									"text": "These fools have slipped, leaving [::territory::] at my mercy. I'll strike with force, fast and bloody.",
									"character": "Iakin",
									"notes_overrides": ""
								},
								{
									"text": "The [::territory_owner::-shortname] should have kept their eyes on [::territory::]. If we move fast, they will not be able to react.",
									"character": "Whitmore",
									"notes_overrides": ""
								},
								{
									"text": "The [::territory_owner::-shortname] are not good keeper of this land. They have not even noticed we're here. Let's strike them where it hurts.",
									"character": "Ilesa",
									"notes_overrides": ""
								}
							],
							"notes": ""
						}
					],
					"speakers": [
						{
							"character": "Duncan"
						}
					],
					"flags": 32,
					"props": {
						"position": 2
					},
					"trigger": {}
				},
				{
					"id": "CB_Assault_1",
					"title": "Assault",
					"mainText": "",
					"popupPages": [
						{
							"id": "CBAH1",
							"text": "",
							"highlight": {},
							"overrides": [
								{
									"text": "We've planned this assault for months. They know we are coming. We have to win. For Atreides!",
									"character": "Gurney",
									"notes_overrides": ""
								},
								{
									"text": "This battle is decisive. We will succeed.",
									"character": "Aramsham",
									"notes_overrides": ""
								},
								{
									"text": "The blood of [::territory_owner::-adjective] men will flow today. We take their [ConquestBase] and the land is ours.",
									"character": "Iakin",
									"notes_overrides": ""
								},
								{
									"text": "We can expect heavy resistance, but we've come in force. It'll be a great battle where boys become men, and glory is gained by all!",
									"character": "Whitmore",
									"notes_overrides": ""
								}
							],
							"notes": ""
						}
					],
					"speakers": [
						{
							"character": "Gurney",
							"faction": "Atreides"
						},
						{
							"faction": "Harkonnen",
							"character": "Iakin"
						},
						{
							"faction": "Corrino",
							"character": "Aramsham"
						},
						{
							"faction": "Ecaz",
							"character": "Whitmore"
						}
					],
					"flags": 0,
					"props": {
						"position": 2
					},
					"trigger": {}
				},
				{
					"id": "CB_ExtendYourGrasp_1",
					"title": "Extend your grasp",
					"mainText": "",
					"popupPages": [
						{
							"id": "CBAH1",
							"text": "",
							"highlight": {},
							"overrides": [
								{
									"text": "We need to increase our ground footprint on Arrakis to be legitimate in our claim. The [::territory::] is currently unclaimed land. It is our best candidate for a relatively peaceful annexation.",
									"character": "Thufir",
									"notes_overrides": ""
								},
								{
									"text": "The [::territory::] is unclaimed. If we grab the land before anyone else has the time to do it, it might form a good base for our economy on Arrakis.",
									"character": "Fenring",
									"notes_overrides": ""
								},
								{
									"text": "We cannot rule without imposing our will on the population. With enough people under our thumb, we gain control of their dream and fear! You know how powerful that is!",
									"character": "Piter",
									"notes_overrides": ""
								},
								{
									"text": "The [::territory::] is a nice piece of land, but war is coming. Will it be spared under our protection?",
									"character": "Ilesa",
									"notes_overrides": ""
								}
							],
							"notes": ""
						}
					],
					"speakers": [
						{
							"character": "Thufir",
							"faction": "Atreides"
						},
						{
							"faction": "Harkonnen",
							"character": "Piter"
						},
						{
							"faction": "Corrino",
							"character": "Fenring"
						},
						{
							"faction": "Ecaz",
							"character": "Ilesa"
						}
					],
					"flags": 0,
					"props": {
						"position": 2
					},
					"trigger": {}
				},
				{
					"id": "CB_StrategicExpansion_1",
					"title": "Strategic Expansion",
					"mainText": "",
					"popupPages": [
						{
							"id": "CBAH1",
							"text": "",
							"highlight": {},
							"overrides": [
								{
									"text": "The [::territory::] is a critical land for economical growth and local support. We need to secure it to ensure our future on Arrakis. I expect heavy resistance.",
									"character": "Thufir",
									"notes_overrides": ""
								},
								{
									"text": "The [::territory::] is a strategic point for our plan on Arrakis. I'm surprised that it is still unclaimed. We should demonstrate our superiority here, once and for all.",
									"character": "Fenring",
									"notes_overrides": ""
								},
								{
									"text": "The [::territory::] has been empty for so long. What a mistake! It's the key to domination on Arrakis! And it should be ours!",
									"character": "Piter",
									"notes_overrides": ""
								},
								{
									"text": "I don't like to bring our wars on these lands, but the [::territory::] is critical. We cannot let the other Houses get to it first.",
									"character": "Ilesa",
									"notes_overrides": ""
								}
							],
							"notes": ""
						}
					],
					"speakers": [
						{
							"character": "Thufir",
							"faction": "Atreides"
						},
						{
							"faction": "Harkonnen",
							"character": "Piter"
						},
						{
							"faction": "Corrino",
							"character": "Fenring"
						},
						{
							"faction": "Ecaz",
							"character": "Ilesa"
						}
					],
					"flags": 0,
					"props": {
						"position": 2
					},
					"trigger": {}
				},
				{
					"id": "CB_Summit_1",
					"title": "Famous Summit",
					"mainText": "",
					"popupPages": [
						{
							"id": "CBAH1",
							"text": "",
							"highlight": {},
							"overrides": [
								{
									"text": "The prestigious [::signature_region::] could be very useful to our development. Nobody has taken claim on it yet, but it won't be the case for very long.",
									"character": "Thufir",
									"notes_overrides": ""
								},
								{
									"text": "We should take [::signature_region::] and hold onto it to demonstrate to all the supremacy of [Corrino].",
									"character": "Fenring",
									"notes_overrides": ""
								},
								{
									"text": "[::signature_region::] is right here for the taking. Everyone knows it. It's going to be a race! Or maybe a brawl... Anyway, we should prevail.",
									"character": "Piter",
									"notes_overrides": ""
								},
								{
									"text": "[::signature_region::] is such a beautiful sight. But it'll be even better with our flag on it. Don't let the other Houses take it.",
									"character": "Sanya",
									"notes_overrides": ""
								}
							],
							"notes": ""
						}
					],
					"speakers": [
						{
							"character": "Thufir",
							"faction": "Atreides"
						},
						{
							"faction": "Harkonnen",
							"character": "Piter"
						},
						{
							"faction": "Corrino",
							"character": "Fenring"
						},
						{
							"character": "Sanya",
							"faction": "Ecaz"
						}
					],
					"flags": 0,
					"props": {
						"position": 2
					},
					"trigger": {}
				},
				{
					"id": "CB_Agony_Hero1",
					"title": "Incoming Assault",
					"mainText": "",
					"popupPages": [
						{
							"id": "CBAH1",
							"text": "",
							"highlight": {},
							"overrides": [
								{
									"text": "We've detected an imminent assault on your position. Hold them off until I arrive. We're going to get you through this, you hear me?",
									"character": "Duncan",
									"notes_overrides": ""
								},
								{
									"text": "An assault on your position has been detected. I'm coming to you with a full legion of reinforcements. Today is not the day you die, soldier. It's the day you rise up and hold.",
									"character": "Gurney",
									"notes_overrides": ""
								},
								{
									"text": "The enemy is nearly there. I'm coming to end their foolish incursion. Hold on until then.",
									"character": "Aramsham",
									"notes_overrides": ""
								},
								{
									"text": "They are coming for you. How dare they defy Father's authority? It cannot stand! Hold your position at all cost, soldier, we are coming.",
									"character": "Wensicia",
									"notes_overrides": ""
								},
								{
									"text": "The weaklings are trying to take our land from us. I'm coming to whip them. Just hold on until I get there, eh!",
									"character": "Glossu",
									"notes_overrides": ""
								},
								{
									"text": "Enemy forces are converging on your position. This pitiful land is ours! You have to hold position until I come with reinforcement. Everyone is expendable in this fight!",
									"character": "Iakin",
									"notes_overrides": ""
								},
								{
									"text": "An assault is coming on your position. We're coming with reinforcement, but you'll have to hold off on your own until then.",
									"character": "Whitmore",
									"notes_overrides": ""
								},
								{
									"text": "We did not anticipated this assault, and you are going to pay the price. I'm bringing reinforcement as fast as possible. Good luck!",
									"character": "Ilesa",
									"notes_overrides": ""
								}
							],
							"notes": ""
						}
					],
					"speakers": [
						{
							"character": "Duncan"
						}
					],
					"trigger": {},
					"flags": 32,
					"props": {
						"position": 2
					}
				},
				{
					"id": "CB_Agony_Hero2",
					"title": "Incoming Assault",
					"mainText": "",
					"popupPages": [
						{
							"id": "CBAH1",
							"text": "",
							"highlight": {},
							"overrides": [
								{
									"text": "They are already here. Chin up, soldier! We're on our way.",
									"character": "Duncan",
									"notes_overrides": ""
								},
								{
									"text": "The enemy is at your door. Ring the bell and hold the wall! We're coming.",
									"character": "Gurney",
									"notes_overrides": ""
								},
								{
									"text": "They are here. Hold!",
									"character": "Aramsham",
									"notes_overrides": ""
								},
								{
									"text": "I think they have started the attack. Hold tight, soldier.",
									"character": "Wensicia",
									"notes_overrides": ""
								},
								{
									"text": "They're already there, eh! I'll hurry. Leave some for me!",
									"character": "Glossu",
									"notes_overrides": ""
								},
								{
									"text": "They are already on you. Don't let them take one inch!",
									"character": "Iakin",
									"notes_overrides": ""
								},
								{
									"text": "They are already here. Keep your cool, soldier. We're coming to rescue you.",
									"character": "Whitmore",
									"notes_overrides": ""
								},
								{
									"text": "The assault has begun. Hold tight!",
									"character": "Ilesa",
									"notes_overrides": ""
								}
							],
							"notes": ""
						}
					],
					"speakers": [
						{
							"character": "Duncan"
						}
					],
					"trigger": {},
					"flags": 32,
					"props": {
						"position": 2
					}
				},
				{
					"id": "CB_Agony_Hero_Reinforcements",
					"title": "Reinforcements",
					"mainText": "",
					"popupPages": [
						{
							"id": "CBAH1",
							"text": "",
							"highlight": {},
							"overrides": [
								{
									"text": "The cavalry has arrived! Let's show them what Atreides are capable of.",
									"character": "Duncan",
									"notes_overrides": ""
								},
								{
									"text": "I see you haven't lost hope. Now, friends are here. It's time to push despair to their side of the field.",
									"character": "Gurney",
									"notes_overrides": ""
								},
								{
									"text": "I'm here. Take me to them and I'll end this.",
									"character": "Aramsham",
									"notes_overrides": ""
								},
								{
									"text": "We've arrived! Well done, soldier. Now, the hunter becomes the prey!",
									"character": "Wensicia",
									"notes_overrides": ""
								},
								{
									"text": "Eh eh! I'm here. I'll make them suffer!",
									"character": "Glossu",
									"notes_overrides": ""
								},
								{
									"text": "I'm here. We'll punish them for their arrogance, together!",
									"character": "Iakin",
									"notes_overrides": ""
								},
								{
									"text": "We're here. Let's show them bravery. This one is for the history books.",
									"character": "Whitmore",
									"notes_overrides": ""
								},
								{
									"text": "The reinforcements have arrived. You did good. Let's finish this cleanly!",
									"character": "Ilesa",
									"notes_overrides": ""
								}
							],
							"notes": ""
						}
					],
					"speakers": [
						{
							"character": "Duncan"
						}
					],
					"trigger": {},
					"flags": 32,
					"props": {
						"position": 2
					}
				},
				{
					"id": "CB_FremUp_1",
					"title": "Fremen Uprising",
					"mainText": "",
					"popupPages": [
						{
							"id": "CBFU1",
							"text": "",
							"highlight": {},
							"overrides": [
								{
									"text": "There is noise from our fremen contacts that they want [::territory_owner::-longname] gone. I think we should give them a hand. If we can prove ourselves, they'll be more favorable to us.",
									"character": "Duncan",
									"notes_overrides": ""
								},
								{
									"text": "Eh eh! The [::territory_owner::-shortname]s have trouble with the fremen. Gives me an idea. Maybe we could use the fremen for once, and get rid of the [::territory_owner::-shortname]s.",
									"character": "Glossu",
									"notes_overrides": ""
								},
								{
									"text": "A kerfuffle is happening in [::territory::]. We should take this opportunity to get an advantage over [::territory_owner::-longname]. If we play our cards right, the locals will take our side.",
									"character": "Fenring",
									"notes_overrides": ""
								},
								{
									"text": "The fremen of [::territory::] are restless. They want the [::territory_owner::-shortname] gone. Let's help them with that.",
									"character": "Mesa",
									"notes_overrides": ""
								}
							],
							"notes": ""
						}
					],
					"speakers": [
						{
							"character": "Duncan",
							"faction": "Atreides"
						},
						{
							"faction": "Harkonnen",
							"character": "Glossu"
						},
						{
							"faction": "Corrino",
							"character": "Fenring"
						},
						{
							"faction": "Ecaz",
							"character": "Mesa"
						}
					],
					"trigger": {},
					"flags": 0,
					"props": {
						"position": 2
					}
				},
				{
					"id": "CB_FremUp_2",
					"title": "Fremen Uprising",
					"mainText": "",
					"popupPages": [
						{
							"id": "CBFU1",
							"text": "The [::territory_owner::-shortname] have ruled here long enough. You've been helpful, stranger. If you are ready to finish the job, we're making an assault on their base now.",
							"highlight": {},
							"overrides": [],
							"notes": ""
						}
					],
					"speakers": [
						{
							"character": "Otheym"
						}
					],
					"trigger": {},
					"flags": 0,
					"props": {
						"position": 2
					}
				},
				{
					"id": "CB_HiredHelp_1",
					"title": "Hiring Help",
					"mainText": "",
					"popupPages": [
						{
							"id": "CBHH1",
							"text": "",
							"overrides": [
								{
									"text": "This region is mostly undefended. We're going to take it just under their nose, but we cannot bring any more forces to the fight without attracting attention.",
									"character": "Duncan",
									"notes_overrides": ""
								},
								{
									"text": "The [::territory_owner::-shortname]s have left this place unsupervised. They might enjoy a more gentle master. I'll take it with a small force to avoid drawing attention.",
									"character": "Gurney",
									"notes_overrides": ""
								},
								{
									"text": "My commando is on position to take [::territory::] from the [::territory_owner::-shortname]s. No reinforcements are available. I don't need them, anyway.",
									"character": "Aramsham",
									"notes_overrides": ""
								},
								{
									"text": "I've taken the initiative to lead a small force to take [::territory::]. Don't worry about it. I will hire [Mercenaries]s if needed be.",
									"character": "Wensicia",
									"notes_overrides": ""
								},
								{
									"text": "I'm gonna beat the [::territory_owner::-shortname]s to a pulp. Gotta keep a low profile, though, take them by surprise.",
									"character": "Glossu",
									"notes_overrides": ""
								},
								{
									"text": "My special commando is more than enough to take this pitiful land from the [::territory_owner::-shortname]s.",
									"character": "Iakin",
									"notes_overrides": ""
								},
								{
									"text": "A small force and a pouch of gold is all I need to take such a badly defended region. You can trust me.",
									"character": "Whitmore",
									"notes_overrides": ""
								},
								{
									"text": "This is a good opportunity to show [::territory_owner::-longname] how it's done. I and a few units are enough to shake things up.",
									"character": "Ilesa",
									"notes_overrides": ""
								}
							],
							"highlight": {},
							"notes": ""
						}
					],
					"speakers": [
						{
							"character": "Duncan"
						}
					],
					"trigger": {},
					"flags": 32,
					"props": {
						"position": 2
					}
				},
				{
					"id": "CB_HiredHelp_2",
					"title": "Hiring Help",
					"mainText": "",
					"popupPages": [
						{
							"id": "CBHH2",
							"text": "Hired Help 2",
							"overrides": [
								{
									"text": "You deceitful bastard! I'm going to send you back where you came from.",
									"character": "Duncan",
									"notes_overrides": ""
								},
								{
									"text": "The snake has no choice but to deceive. The hawk has no choice but to end its life.",
									"character": "Gurney",
									"notes_overrides": ""
								},
								{
									"text": "You're out of luck. I'm here.",
									"character": "Aramsham",
									"notes_overrides": ""
								},
								{
									"text": "You thought you could get away with an assault behind Father's back. It is my duty to stop you.",
									"character": "Wensicia",
									"notes_overrides": ""
								},
								{
									"text": "Eh eh eh! Finally a bit of excitement on this wretched planet. I gonna whip you, little worm!",
									"character": "Glossu",
									"notes_overrides": ""
								},
								{
									"text": "What do we got here? A little worm who thinks he can take on the griffin. You'll regret this.",
									"character": "Iakin",
									"notes_overrides": ""
								},
								{
									"text": "Only the weak use such treacherous ways. And I cannot allow weakness to prevail.",
									"character": "Whitmore",
									"notes_overrides": ""
								},
								{
									"text": "I'm used to these kind of treacheries, and I've always come up victorious. You don't impress me.",
									"character": "Ilesa",
									"notes_overrides": ""
								}
							],
							"highlight": {},
							"notes": ""
						}
					],
					"speakers": [
						{}
					],
					"trigger": {},
					"flags": 128,
					"props": {
						"position": 2
					}
				},
				{
					"id": "CB_SietchControl_1",
					"title": "Sietch Control",
					"mainText": "",
					"popupPages": [
						{
							"id": "CBSC1",
							"text": "Sietch leaders throughout this region are too prideful to follow any imperial laws. Someone ought to get them in line.",
							"overrides": [],
							"highlight": {},
							"notes": ""
						}
					],
					"speakers": [
						{
							"character": "Thufir",
							"faction": "Atreides"
						},
						{
							"faction": "Harkonnen",
							"character": "Piter"
						},
						{
							"faction": "Corrino",
							"character": "Fenring"
						}
					],
					"trigger": {},
					"flags": 0,
					"props": {
						"position": 2
					}
				},
				{
					"id": "CB_SietchControl_2",
					"title": "Sietch Control",
					"mainText": "",
					"popupPages": [
						{
							"id": "CBSC1",
							"text": "Now that everyone's here, I hope they're ready for some shaking.",
							"overrides": [],
							"highlight": {},
							"notes": ""
						}
					],
					"speakers": [
						{
							"character": "Gurney",
							"faction": "Atreides"
						},
						{
							"faction": "Harkonnen",
							"character": "Iakin"
						},
						{
							"faction": "Corrino",
							"character": "Aramsham"
						}
					],
					"trigger": {},
					"flags": 0,
					"props": {
						"position": 2
					}
				},
				{
					"id": "CB_CaptureSignature_1",
					"title": "Signature Capture",
					"mainText": "",
					"popupPages": [
						{
							"id": "CBSC3",
							"text": "We must take control of this territory",
							"overrides": [],
							"highlight": {},
							"notes": ""
						}
					],
					"speakers": [
						{
							"character": "Duncan",
							"faction": "Atreides"
						},
						{
							"faction": "Harkonnen",
							"character": "Piter"
						},
						{
							"faction": "Corrino",
							"character": "Fenring"
						}
					],
					"flags": 0,
					"props": {
						"position": 2
					},
					"trigger": {}
				},
				{
					"id": "CB_CaptureSignature_2",
					"title": "Signature Capture",
					"mainText": "",
					"popupPages": [
						{
							"id": "CBSC4",
							"text": "Very well, and now to expand out grasp...",
							"overrides": [],
							"highlight": {},
							"notes": ""
						}
					],
					"speakers": [
						{
							"character": "Duncan",
							"faction": "Atreides"
						},
						{
							"faction": "Harkonnen",
							"character": "Piter"
						},
						{
							"faction": "Corrino",
							"character": "Fenring"
						}
					],
					"flags": 0,
					"props": {
						"position": 2
