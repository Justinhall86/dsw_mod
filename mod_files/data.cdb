					"trigger": {},
					"flags": 0,
					"props": {
						"position": 2
					}
				},
				{
					"id": "M5_02_DemolishBuildingsObjective",
					"title": "Demolish Buildings",
					"mainText": "",
					"popupPages": [
						{
							"id": "M212",
							"text": "Demolish [Building]s to have more than 40 [Solari] production.",
							"highlight": {
