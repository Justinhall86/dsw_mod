					"texts": {
						"name": "Arrakeen",
						"desc": "An ancient city, one of the largest and most beautiful on Arrakis, Arrakeen is largely built on bedrock, which is sure to keep it safe from [Sandworm]. The palace is now the home of Duke Leto and headquarters of the Atreides, but used to be inhabited by the Emperor's right-hand man, Count Hasimir Fenring.",
						"plural": {
							"name": "Arrakeen"
						}
					}
				},
