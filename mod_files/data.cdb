						}
					],
					"conditions": {
						"ownedUwHQAbove": 3
					},
					"implemented": true,
					"props": {},
					"weight": 2
				},
				{
					"id": "UWHQInAIVillage",
					"options": [],
					"conditionsComment": "Underground City joueur chez IA\r",
					"scoreComment": "1 par underground city",
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "Atreides rule is hostile to smuggling. You know it already, and I will make sure you remember it."
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": "You know how I feel about smuggling, and I will make sure you remember it... but should you make me richer, I might not crush you entirely."
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": ""
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": "Smuggler, we differ greatly but we have worked together for a long time now, like opposed but codependent species in a fragile ecosystem. May this mutual tolerance last."
								}
							]
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "I have always tolerated your smuggling activities. But it is only that. Tolerance. It is a boon that can be taken away as fast as it was given."
								}
							]
						}
					],
					"conditions": {
						"uwHQAbove": 2
					},
					"implemented": true,
					"props": {},
					"weight": 2
				},
				{
					"id": "UWHQDiscovered",
					"options": [],
					"conditionsComment": "Découverte d'une underground City joueur",
					"implemented": true,
					"eventConditions": [
						{
							"ref": "UWHQDiscovered",
							"conditions": {
								"instigator": 0,
								"target": 1
							},
							"duration": 5,
							"score": 50
						}
					],
					"props": {},
					"weight": 3
				},
				{
					"id": "VillageOppression",
					"options": [],
					"conditionsComment": "Pressure Population par le joueur",
					"scoreComment": "50 pour l'IA au plus gros score",
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "Violence against your subjects is contemptible. If your own people despise you, how do you expect the rest of us to feel?"
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": ""
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": "Of course I can understand the upsides of an increase in production. But let's consider the long-term effects: how efficient will your workforce be if it's all worn out?"
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": "I understand asceticism and I am familiar with self-sacrifice. But I fail to see how one could confuse them with the oppression you inflict on your people. They are its antithesis."
								}
							]
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "I am not one to shy away from hard decisions. But I always worry your base instincts influence your actions in a disproportionate manner."
								}
							]
						}
					],
					"implemented": true,
					"eventConditions": [
						{
							"ref": "VillageOppressed",
							"conditions": {
								"instigator": 1
							},
							"duration": 5,
							"score": 20
						}
					],
					"props": {},
					"weight": 2
				},
				{
					"id": "MainBaseDestroyed",
					"options": [],
					"conditionsComment": "Destruction de Main Base\r",
					"scoreComment": "200/nbIA pour toutes les IA\n",
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "There are many ways of showing strength. Slaughtering a civilian city can only demonstrate your weakness."
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": "Warfare is satisfying, but how much more elegant is it to see rival clans annihilating each other for my entertainment... I only hope that you still know your place."
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": "I must admit I am in shock. And I can't see the benefit of this action. What will happen when you're all alone here and untrusted everywhere?"
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": "Certainly, all things must come to an end. Every death provokes the advent of something new. But comeuppance awaits those who attempt to force the hand of fate."
								}
							]
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "This is wanton destruction. Of my property, I might add. I cannot see any positive outcome to such actions."
								}
							]
						}
					],
					"implemented": true,
					"eventConditions": [
						{
							"ref": "MainBaseDestroyed",
							"conditions": {
								"instigator": 1,
								"target": 2
							},
							"duration": 10,
							"score": 100
						}
					],
					"props": {
						"cooldown": 0
					},
					"weight": 4
				},
				{
					"id": "LeaderAssassinated",
					"options": [],
					"conditionsComment": "Assassinat de Leader",
					"scoreComment": "200/nbIA pour toutes les IA",
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "I understand war and I understand wrath. But this, I cannot comprehend. How can you expect any of us to trust you after that?"
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": "There are times when I get tired of politics. Then, lesser leaders start ludicrously assassinating one another... How refreshing! However, I will have to neutralize you now."
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": "I didn't like them much either, but wouldn't we benefit from some stability? When heads start falling, it rarely stops after the first one. I hope you know where your interest is."
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": "An invader slaughtering an invader. You created an imbalance. You might just have precipitated the series of events that will lead to your demise."
								}
							]
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "My father knows I'm not intrinsically against assassination as a mean of advancement. But this seems ill-advised at best."
								}
							]
						}
					],
					"implemented": true,
					"eventConditions": [
