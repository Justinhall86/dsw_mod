					"props": {}
				},
				{
					"id": "Game_UserDisconnected",
					"text": "::user:: ([::faction::-longname]) has disconnected, they will be replaced by an AI in ::value:: minutes",
					"type": 0,
					"props": {}
				},
				{
					"id": "Game_LastAliveUser",
