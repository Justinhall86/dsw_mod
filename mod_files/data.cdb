				{
					"id": "AdjacentAirfields",
					"options": [],
					"scoreComment": "1 par Airfield\r",
					"conditionsComment": "Airfield joueur dans zone adjacente\r",
					"regularScore": 2,
					"descriptions": [
						{
							"faction": "Atreides",
							"descs": [
								{
									"desc": "Your shuttles seem to roam without concern in my empire's vicinity. Be sure not to get too comfortable."
								}
							]
						},
						{
							"faction": "Harkonnen",
							"descs": [
								{
									"desc": "What a curious parade of shuttles and vessels flying right before my eyes... Could it be a subtle invitation to skeet shooting?"
								}
							]
						},
						{
							"faction": "Smugglers",
							"descs": [
								{
									"desc": "I'm all for facilitating transport. Civilian or military, every vessel can be used for smuggling. But even my optimism has limits. I'll be watching this airfield of yours very closely!"
								}
							]
						},
						{
							"faction": "Fremen",
							"descs": [
								{
									"desc": "You are being reckless. You can expect each and every shuttle flying across our territory to vanish without a trace. Blame the sandstorms. Or blame yourself."
								}
							]
						},
						{
							"faction": "Corrino",
							"descs": [
								{
									"desc": "I am pleased you are investing in the infrastructure of the planet. But I warn you. Do not think of using these Airfields against me."
								}
							]
						}
					],
					"conditions": {
						"adjacentAirfields": 1
					},
					"implemented": true,
					"props": {},
					"weight": 2
