				},
				{
					"id": "M5_02_LowerUpkeep",
					"title": "Demolish Buildings",
					"mainText": "",
					"popupPages": [
						{
							"id": "M212",
							"text": "When you are running short of [Solari], look at your Upkeep and try to lower it with what you just learnt.",
							"overrides": [],
							"highlight": {
								"resource": "Solari"
							},
							"notes": ""
						}
					],
					"speakers": [
						{
							"character": "ShadoutMapes"
						}
