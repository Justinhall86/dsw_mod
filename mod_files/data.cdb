				},
				{
					"id": "M6_04_SecondCouncilOpening",
					"title": "Second Council",
					"mainText": "",
					"popupPages": [
						{
							"id": "M217",
							"text": "It's now time for our second mock council.",
							"notes": "Speaker is Thufir Hawat",
							"overrides": [],
							"highlight": {}
						}
					],
					"speakers": [
						{
							"character": "Thufir"
						}
					],
					"flags": 0,
					"props": {
						"position": 2
					},
					"trigger": {}
				},
				{
					"id": "M6_04_SecondCouncilCharterExplaining",
					"title": "Second Council",
					"mainText": "",
					"popupPages": [
						{
							"id": "M217",
							"text": "As you can see, the [Charter] has replaced a regular resolution.\n\nOptions on the ballot are restricted to eligible factions, but it otherwise functions as a normal resolution.",
							"notes": "Speaker is Thufir Hawat",
							"overrides": [],
							"highlight": {
								"ui": {
									"match": [
										{
											"className": "councilspeaker",
											"objectName": "resolution-vote-card"
										}
									]
								}
							}
						}
					],
					"speakers": [
						{
							"character": "Thufir"
						}
					],
					"flags": 768,
					"props": {
						"position": 2
					},
					"trigger": {}
				},
				{
					"id": "M6_04_SecondCouncilResAction",
					"title": "Second Council",
					"mainText": "",
					"popupPages": [
						{
							"id": "M217",
							"text": "Other things to look out for are resolution modifiers.\n\nHere, [WaterRegulation] is [LandsraadFavorite]. Look at the modifier's effect.",
							"notes": "Speaker is Thufir Hawat",
							"overrides": [],
							"highlight": {
								"ui": {
									"match": [
										{
											"id": "",
											"className": "tutorial-illu-waterregulation",
											"objectName": ""
										}
									]
								}
							}
						},
						{
							"id": "M218",
							"text": "Some resolution modifiers appear randomly, like [LandsraadFavorite], and some can be added by player factions.",
							"notes": "Speaker is Thufir Hawat",
							"overrides": [],
							"highlight": {}
						}
					],
					"speakers": [
						{
							"character": "Thufir"
						}
					],
					"flags": 768,
					"props": {
						"position": 2
					},
					"trigger": {}
				},
				{
					"id": "M6_04_SecondCouncilVoteNow",
					"title": "Second Council",
					"mainText": "",
					"popupPages": [
						{
							"id": "M213",
							"text": "It's time to vote again, exactly like in the previous council.",
							"highlight": {},
							"overrides": [],
							"notes": "Speaker is Thufir Hawat"
