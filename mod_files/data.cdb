					}
				},
				{
					"id": "M5_02_End",
					"title": "",
					"mainText": "",
					"popupPages": [
						{
							"id": "M211",
							"text": "Congratulations!\n\nYou know everything about [Solari] Upkeep now!",
							"highlight": {},
							"overrides": [],
							"notes": ""
						}
					],
					"speakers": [
						{
							"character": "ShadoutMapes"
