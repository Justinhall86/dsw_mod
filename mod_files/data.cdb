				{
					"id": "M1_03_PauseGame",
					"title": "Pause the game",
					"mainText": "",
					"popupPages": [
						{
							"id": "M211",
							"text": "There are 2 ways to pause and unpause the game.",
							"highlight": {},
							"overrides": [],
							"notes": ""
						},
						{
							"id": "M212",
							"text": "1. You can press [Time_PauseResume] on your keyboard.\n2. You can [MouseLeft] click on the pause button on the right of the top bar.",
							"highlight": {
