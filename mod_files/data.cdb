							},
							{
								"ref": "Corrino",
								"availableForAI": true
							},
							{
								"ref": "Ecaz",
								"availableForAI": true
							},
							{
								"ref": "Vernius",
								"availableForAI": true
							},
							{
								"ref": "Smugglers",
								"availableForAI": false
							},
							{
								"ref": "Fremen",
								"availableForAI": false
							}
						],
						"baseFactionXp": 50
					},
					"flags": 4,
					"comment": "in-battle config actually has Default as gameType"
				},
				{
					"id": "Kanly",
					"texts": {
						"name": "Kanly Duel",
						"menuButton": "Kanly Duel",
						"desc": "A fast and thrilling duel for revenge and power. Two factions enter the fray. Only one can leave with their head held high."
					},
					"gfx": {
						"file": "UI/icons/icon_mode_jeu.png",
						"size": 74,
						"x": 1,
						"y": 0
					},
					"props": {
						"baseFactionXp": 50,
						"shortGameDays": 30
					},
					"flags": 0,
					"comment": ""
				},
				{
					"id": "Tutorial",
					"texts": {
						"name": "Tutorial",
						"menuButton": "Tutorials",
						"desc": "Learn how to play Dune: Spice Wars"
					},
					"props": {
						"baseFactionXp": 0
					},
					"flags": 1,
					"comment": "in-battle config actually has Default as gameType"
				}
